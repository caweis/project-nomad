PORT=8080
HOST=localhost
LOG_LEVEL=info
APP_KEY=some_random_key
NODE_ENV=development
SESSION_DRIVER=cookie
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_DATABASE=nomad
DB_PASSWORD=password
DB_SSL=false
REDIS_HOST=localhost
REDIS_PORT=6379
# Storage path for NOMAD content (ZIM files, maps, etc.)
# On Windows dev, use an absolute path like: C:/nomad-storage
# On Linux production, use: /opt/project-nomad/storage
NOMAD_STORAGE_PATH=/opt/project-nomad/storage

# Optional: URL of a native (non-Docker) Ollama instance.
# When set, the admin app calls Ollama at this URL instead of managing
# an Ollama container. Used by the macOS distribution to route through
# native Homebrew Ollama for Metal GPU acceleration.
# Example: OLLAMA_HOST=http://host.docker.internal:11434
# (oMLX backend routes through the proxy on :11436; the macOS installer sets this
#  automatically per backend via NOMAD_OLLAMA_URL — see install/macos/compose.yaml.)
# OLLAMA_HOST=

# Optional: Apple Silicon chip / GPU labels for the host machine.
# Inside Docker, `systeminformation` can't read the host's exact chip
# model. The macOS installer probes the host with
# `system_profiler SPHardwareDataType` / `SPDisplaysDataType` and passes
# the result here so the leaderboard and system-info screens show real
# names ("Apple M3 Max") instead of generic "Apple Silicon (16-core)".
# APPLE_CHIP_MODEL=Apple M3 Max
# APPLE_GPU_MODEL=Apple M3 Max (40-core GPU)

# Optional: bearer key for gated self-hosted curated content (upstream #1172).
# When a curated-collection manifest resource declares auth: 'nomad_app_key',
# downloads for it send "Authorization: Bearer <this value>" to the manifest
# URL's server. Leave unset unless you host gated content yourself; without a
# key, gated downloads fail immediately with a clear entitlement message
# (they are never retried — upstream #1205).
# HOSTED_CONTENT_APP_KEY=