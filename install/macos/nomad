  step_seed_admin_services     # populate services catalog so /settings/apps + Easy Setup work (also required before Qdrant install — preflight looks up services.nomad_qdrant)
  step_refresh_service_versions # bump seeded image tags to latest published semver (registry query)
  step_pull_embedding_quick    # ~270 MB, ~30s — admin's RAG works the moment we wire
