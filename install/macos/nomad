#!/usr/bin/env bash
# nomad — Project NOMAD installer + lifecycle CLI for macOS (Apple Silicon).
#
# Apache-2.0 — companion to upstream Project NOMAD (Crosstalk Solutions).
# Idempotent. Safe to re-run; that's also the repair path.
#
# Usage:
#   bash nomad install [--data-root PATH] [--tier auto|tiny|small|medium|large|xl|dreamy]
#                      [--models "names..."] [--no-models] [--yes]
#   bash nomad check   [system|stack|install|all]   # default: all (writes log)
#                                            # install = pre-flight inventory
#   bash nomad up
#   bash nomad down
#   bash nomad restart [SERVICE]             # default: admin
#   bash nomad logs    [SERVICE]             # default: admin
#   bash nomad models [list|pull [TIER|NAMES...]]
#                                            # tier: tiny→2GB, small→10, medium→26,
#                                            # large→65, xl→130, dreamy→215 (Studio)
#   bash nomad upgrade-models                # pull latest tags of installed
#   bash nomad downloads [list|cancel ID|remove ID]   # admin's job queue
#   bash nomad zim wikipedia [state|select VARIANT]   # Wikipedia download state
#   bash nomad zim [list|remote]
#   bash nomad services [list|install NAME|affect ACTION NAME]
#   bash nomad system [info|debug|internet]
#   bash nomad api PATH [JSON_BODY]          # raw admin API call (escape hatch)
#   bash nomad benchmark [run|patch-host]    # run = native vs Rosetta tokens/sec
#                                            # patch-host = inject real Apple chip into
#                                            # admin's latest benchmark row before Submit
#   bash nomad orbstack-tune [GB]            # bump OrbStack VM RAM (default: 80% of host)
#   bash nomad reset-ollama                  # recover from stuck LaunchAgent state
#   bash nomad uninstall                     # clean wipe (containers, agent, .env, opt. data)
#   bash nomad reinstall                     # nuclear: wipe everything + reinstall in one shot
#   bash nomad install-field-desk [--port N] [--foreground] [--force]
#                                            # SysAdminDoc Field Desk alongside admin
#                                            # (default :8081, shares Ollama on :11434)
#
# Globals at the top, all logic in named functions, single dispatch at the bottom.

set -euo pipefail

# ─── constants ────────────────────────────────────────────────────────────────
HERE="$(cd "$(dirname "$0")" && pwd)"
COMPOSE_BASE="$HERE/compose.yaml"
SECRETS_DIR="$HOME/.config/project-nomad"
ENV_FILE="$SECRETS_DIR/.env"
# Hot state — always on internal disk, never on a detachable drive.
# MySQL + Redis bind-mount here so the data drive can be safely unplugged
# without killing the management plane.
NOMAD_STATE_ROOT_DEFAULT="$SECRETS_DIR/state"
LA_LABEL="com.projectnomad.ollama"
LA_PLIST="$HOME/Library/LaunchAgents/${LA_LABEL}.plist"
LA_TARGET="gui/$(id -u)"

# Second LaunchAgent: auto-patches admin's benchmark_results with this Mac's
# real Apple chip + Metal GPU, so the upstream leaderboard shows correct
# hardware instead of "-". Polls every 30s.
PATCHER_LABEL="com.projectnomad.benchmark-patcher"
PATCHER_PLIST="$HOME/Library/LaunchAgents/${PATCHER_LABEL}.plist"
PATCHER_SCRIPT="$SECRETS_DIR/benchmark-patcher.sh"

# Model tiers — auto-selected from RAM, override with --tier or --models.
# All names are confirmed-existing on ollama.com/library as of 2026.
# Note: Llama 3.2 only ships 1b/3b (text); the 8b size lives in Llama 3.1.
#
# Approx sizes (Q4 quantization) — stack these to estimate pull total:
#   llama3.2:3b ~2GB   gemma3:1b ~0.8GB   gemma3:4b ~3GB   llama3.1:8b ~5GB
#   qwen2.5:7b ~5GB   qwen2.5-coder:7b ~5GB   gemma3:12b ~8GB
#   qwen3:14b ~9GB   qwen2.5-coder:14b ~9GB   phi4:14b ~9GB
#   mistral-small:24b ~14GB   gemma3:27b ~17GB   qwen3:32b ~20GB
#   qwen2.5-coder:32b ~20GB   deepseek-r1:32b ~20GB   llama3.3:70b ~40GB
#   qwen2.5:72b ~41GB   deepseek-r1:70b ~40GB
#   nomic-embed-text ~0.3GB   mxbai-embed-large ~0.7GB

TIER_TINY="llama3.2:3b gemma3:1b nomic-embed-text"
TIER_SMALL="llama3.1:8b qwen2.5-coder:7b gemma3:4b nomic-embed-text"
TIER_MEDIUM="llama3.1:8b qwen3:14b qwen2.5-coder:14b gemma3:12b nomic-embed-text"
TIER_LARGE="llama3.1:8b qwen3:14b qwen2.5-coder:32b gemma3:27b mistral-small:24b nomic-embed-text"
TIER_XL="llama3.1:8b qwen3:32b qwen2.5-coder:32b llama3.3:70b deepseek-r1:32b gemma3:27b mistral-small:24b nomic-embed-text mxbai-embed-large"
TIER_DREAMY="llama3.1:8b qwen3:32b qwen2.5:72b qwen2.5-coder:32b llama3.3:70b deepseek-r1:32b deepseek-r1:70b mistral-small:24b gemma3:27b phi4:14b nomic-embed-text mxbai-embed-large"

# Approx pull-size estimate per tier (GB) — used only for the confirm prompt
tier_size_gb() {
  case "$1" in
    tiny)   echo 3   ;;
    small)  echo 13  ;;
    medium) echo 34  ;;
    large)  echo 65  ;;
    xl)     echo 147 ;;
    dreamy) echo 215 ;;
    *)      echo "?" ;;
  esac
}

# Auto-pick tier from system RAM (works on Intel + Apple Silicon).
# Tier ladder vs hardware:
#   <12 GB  → tiny    (M1/M2 Air base, low-RAM Macs)
#   <20 GB  → small   (16 GB MacBook Pro)
#   <40 GB  → medium  (24/32 GB MacBook Pro / mini M2 Pro)
#   <72 GB  → large   (Mac Studio M2 Max 64 GB)
#   <128 GB → xl      (Mac Studio M2 Ultra 96–128 GB)
#   ≥128 GB → dreamy  (Mac Studio M2/M3 Ultra 192/256/512 GB)
auto_tier() {
  local ram_gb
  ram_gb=$(( $(sysctl -n hw.memsize) / 1024 / 1024 / 1024 ))
  if   [[ $ram_gb -lt 12 ]];  then echo tiny
  elif [[ $ram_gb -lt 20 ]];  then echo small
  elif [[ $ram_gb -lt 40 ]];  then echo medium
  elif [[ $ram_gb -lt 72 ]];  then echo large
  elif [[ $ram_gb -lt 128 ]]; then echo xl
  else                             echo dreamy
  fi
}

# Resolve a tier name to its model list. "auto" = auto_tier.
resolve_tier_models() {
  local tier="${1:-auto}"
  [[ "$tier" == "auto" ]] && tier="$(auto_tier)"
  case "$tier" in
    tiny)   echo "$TIER_TINY"   ;;
    small)  echo "$TIER_SMALL"  ;;
    medium) echo "$TIER_MEDIUM" ;;
    large)  echo "$TIER_LARGE"  ;;
    xl)     echo "$TIER_XL"     ;;
    dreamy) echo "$TIER_DREAMY" ;;
    *) die "unknown tier: $tier (valid: auto|tiny|small|medium|large|xl|dreamy)" ;;
  esac
}

# Ports we rely on — system-check looks for collisions
NOMAD_PORTS="8080 9999 11434 3306 6379"

# ─── output helpers ───────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
  C_OK=$'\033[0;32m'; C_WARN=$'\033[0;33m'; C_ERR=$'\033[0;31m'
  C_HEAD=$'\033[1;36m'; C_DIM=$'\033[0;90m'; C_OFF=$'\033[0m'
else
  C_OK=''; C_WARN=''; C_ERR=''; C_HEAD=''; C_DIM=''; C_OFF=''
fi
log()     { printf "%s==>%s %s\n" "$C_HEAD" "$C_OFF" "$*"; }
ok()      { printf "%s ✓ %s%s\n"  "$C_OK"   "$*" "$C_OFF"; }
warn()    { printf "%s ⚠ %s%s\n"  "$C_WARN" "$*" "$C_OFF"; }
die()     { printf "%s ✗ %s%s\n"  "$C_ERR"  "$*" "$C_OFF" >&2; exit 1; }
section() { printf "\n%s── %s ──%s\n" "$C_HEAD" "$*" "$C_OFF"; }
dim()     { printf "%s%s%s\n" "$C_DIM" "$*" "$C_OFF"; }
flag()    { FINDINGS+=("$1|$2|$3"); }   # severity|title|recommendation

NOMAD_YES=0
confirm() {
  [[ "$NOMAD_YES" -eq 1 ]] && { echo "$1 [auto-yes]"; return 0; }
  read -r -p "$1 [y/N] " a; [[ "$a" =~ ^[Yy]$ ]]
}

# ─── admin API client ─────────────────────────────────────────────────────────
# All admin routes are unauthenticated (single-user appliance design — see
# admin/start/kernel.ts). We hit them directly. jq required for parsing.
ADMIN_BASE="${NOMAD_ADMIN_URL:-http://localhost:8080}"

api_check_up() {
  curl -fsS --max-time 3 "$ADMIN_BASE/api/health" >/dev/null 2>&1 \
    || die "admin not reachable at $ADMIN_BASE — start the stack with 'nomad up' or check 'nomad check stack'"
}

api_get()    { curl -fsS --max-time 30 "$ADMIN_BASE$1"; }
api_delete() { curl -fsS --max-time 30 -X DELETE "$ADMIN_BASE$1"; }
api_post()   {
  local path="$1" body="${2:-}"
  if [[ -n "$body" ]]; then
    curl -fsS --max-time 30 -H 'Content-Type: application/json' -X POST -d "$body" "$ADMIN_BASE$path"
  else
    curl -fsS --max-time 30 -X POST "$ADMIN_BASE$path"
  fi
}
api_patch() {
  curl -fsS --max-time 30 -H 'Content-Type: application/json' -X PATCH -d "$2" "$ADMIN_BASE$1"
}

# ─── docker discovery + compose wrapper ───────────────────────────────────────
find_docker() {
  command -v docker >/dev/null 2>&1 && { command -v docker; return 0; }
  for d in /opt/homebrew/bin/docker /usr/local/bin/docker \
           "$HOME/.orbstack/bin/docker" \
           /Applications/OrbStack.app/Contents/MacOS/xbin/docker \
           /Applications/OrbStack.app/Contents/MacOS/bin/docker; do
    [[ -x "$d" ]] && { echo "$d"; return 0; }
  done
  return 1
}
ensure_docker_path() {
  local d; d="$(find_docker)" || return 1
  local dir; dir="$(dirname "$d")"
  case ":$PATH:" in *":$dir:"*) ;; *) export PATH="$dir:$PATH" ;; esac
}

# Same pattern for ollama — when nomad runs in a fresh shell that hasn't
# sourced brew shellenv yet, /opt/homebrew/bin isn't on PATH.
ensure_ollama_path() {
  command -v ollama >/dev/null 2>&1 && return 0
  for o in /opt/homebrew/bin/ollama /usr/local/bin/ollama; do
    if [[ -x "$o" ]]; then
      export PATH="$(dirname "$o"):$PATH"
      return 0
    fi
  done
  return 1
}

# Compose wrapper — base compose.yaml has platform: linux/amd64 baked in for
# the amd64-only GHCR images, so no override-layering needed.
dc() { docker compose -f "$COMPOSE_BASE" --env-file "$ENV_FILE" "$@"; }

# ─── sudo bootstrap ───────────────────────────────────────────────────────────
sudo_bootstrap() {
  [[ $EUID -eq 0 ]] && die "do NOT run with sudo. Run as your user; you'll be prompted once."
  sudo -n true 2>/dev/null && return 0
  log "admin rights needed once for Homebrew + Rosetta — prompting"
  sudo -v || die "sudo authentication failed"
  ( while true; do sudo -n true 2>/dev/null || exit 0; sleep 50; kill -0 $$ 2>/dev/null || exit 0; done ) &
  trap 'kill $! 2>/dev/null || true' EXIT INT TERM
}

# ─── system check ─────────────────────────────────────────────────────────────
FINDINGS=()
check_system() {
  section "System"

  # OS / arch
  local os ver arch
  os="$(uname)"; ver="$(sw_vers -productVersion 2>/dev/null)"; arch="$(uname -m)"
  [[ "$os" == "Darwin" ]] || { flag "🔴" "Not macOS ($os)" "This installer is macOS-only"; return 1; }
  ok "macOS $ver on $arch"
  if [[ "$arch" != "arm64" ]]; then
    warn "$arch — tuned for Apple Silicon; Intel Macs work but slower (no Metal)"
  fi

  # OS version >= 13
  local major; major="$(echo "$ver" | cut -d. -f1)"
  if [[ -n "$major" && "$major" -lt 13 ]]; then
    flag "🟡" "macOS $ver is older than 13" "OrbStack requires macOS 13+; consider updating"
  fi

  # RAM
  local ram_gb
  ram_gb=$(( $(sysctl -n hw.memsize) / 1024 / 1024 / 1024 ))
  if [[ "$ram_gb" -lt 8 ]]; then
    flag "🔴" "${ram_gb} GB RAM is below minimum" "Need 16+ GB for Ollama + container stack"
  elif [[ "$ram_gb" -lt 16 ]]; then
    flag "🟡" "${ram_gb} GB RAM is tight" "8B-param models will be slow; use --models llama3.2:3b"
  else
    ok "${ram_gb} GB RAM"
  fi

  # Boot disk (we don't install here, but warn if low)
  local boot_free_gb
  boot_free_gb="$(df -g / 2>/dev/null | awk 'NR==2{print $4}')"
  if [[ -n "$boot_free_gb" && "$boot_free_gb" -lt 10 ]]; then
    flag "🟡" "Only ${boot_free_gb} GB free on boot disk" "OrbStack VM caches some data on boot disk; free space is tight"
  fi

  # Rosetta on Apple Silicon
  if [[ "$arch" == "arm64" ]]; then
    if /usr/bin/arch -x86_64 /usr/bin/true >/dev/null 2>&1; then
      ok "Rosetta 2 ready"
    else
      warn "Rosetta 2 not installed (will install during 'nomad install')"
    fi
  fi

  # Port collisions
  for p in $NOMAD_PORTS; do
    if lsof -nP -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1; then
      local proc; proc="$(lsof -nP -iTCP:"$p" -sTCP:LISTEN | awk 'NR==2{print $1}')"
      flag "🟡" "Port $p in use by '$proc'" "NOMAD needs $p; stop the other service or it won't bind"
    fi
  done
  ok "checked ports: $NOMAD_PORTS"

  # Network reachability — 2xx/3xx/401/403 all mean "server reachable" (registries
  # legitimately return 401 to unauthenticated HEAD probes)
  for host in download.kiwix.org ghcr.io registry.ollama.ai; do
    local code
    code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 5 -I "https://$host" 2>/dev/null)"
    case "$code" in
      000)     flag "🟡" "$host unreachable" "Check network" ;;
      5*)      flag "🟡" "$host returned HTTP $code (server error)" "Try again later" ;;
      *)       ok "$host reachable (HTTP $code)" ;;
    esac
  done

  # Homebrew
  if command -v brew >/dev/null 2>&1; then
    ok "Homebrew $(brew --version | head -1 | awk '{print $2}')"
  else
    warn "Homebrew not installed (will install during 'nomad install')"
  fi
}

check_stack() {
  section "Stack"
  if ! ensure_docker_path; then
    flag "🔴" "Docker CLI not found" "Run: nomad install"
    return 0
  fi
  if ! docker version >/dev/null 2>&1; then
    flag "🔴" "Docker daemon not reachable" "Open OrbStack.app"
    return 0
  fi
  ok "docker $(docker version --format '{{.Server.Version}}')"

  if [[ ! -f "$ENV_FILE" ]]; then
    flag "🔴" ".env missing at $ENV_FILE" "Run: nomad install"
    return 0
  fi

  # Storage architecture — split state (internal, hot) vs data (configurable, cold)
  local state_root data_root
  state_root="$(grep '^NOMAD_STATE_ROOT=' "$ENV_FILE" 2>/dev/null | cut -d= -f2-)"
  data_root="$(grep '^NOMAD_DATA_ROOT=' "$ENV_FILE" 2>/dev/null | cut -d= -f2-)"
  echo
  echo "  Storage architecture:"
  if [[ -n "$state_root" && -d "$state_root" ]]; then
    local sz; sz="$(du -sh "$state_root" 2>/dev/null | awk '{print $1}')"
    printf "    %s✓%s state (mysql/redis): %s   (%s used, internal)\n" "$C_OK" "$C_OFF" "$state_root" "$sz"
  else
    printf "    %s✗%s state root missing: %s\n" "$C_ERR" "$C_OFF" "${state_root:-(unset)}"
    flag "🔴" "NOMAD_STATE_ROOT missing or unset" "Run: nomad install (will recreate at $NOMAD_STATE_ROOT_DEFAULT)"
  fi
  if [[ -n "$data_root" && -d "$data_root" ]]; then
    local sz; sz="$(du -sh "$data_root" 2>/dev/null | awk '{print $1}')"
    local free; free="$(df -h "$data_root" 2>/dev/null | awk 'NR==2{print $4}')"
    local on_external="no"
    [[ "$data_root" == /Volumes/* ]] && on_external="yes — drive currently mounted"
    printf "    %s✓%s data (content): %s   (%s used, %s free, on external drive: %s)\n" \
      "$C_OK" "$C_OFF" "$data_root" "${sz:-?}" "${free:-?}" "$on_external"
  elif [[ -n "$data_root" ]]; then
    printf "    %s⚠%s data drive unplugged: %s\n" "$C_WARN" "$C_OFF" "$data_root"
    flag "🟡" "Data drive disconnected ($data_root)" "Replug the drive then 'nomad up' — admin keeps running, content services need it"
  fi
  echo

  for svc in admin mysql redis; do
    local state; state="$(dc ps --format '{{.State}}' "$svc" 2>/dev/null)"
    [[ "$state" != "running" ]] && flag "🔴" "$svc not running (state=${state:-missing})" "Run: nomad up"
  done

  # Native Ollama
  if curl -fsS --max-time 3 http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
    ok "native Ollama responding on :11434"
  else
    flag "🔴" "Native Ollama not responding" "Check ~/Library/Logs/ollama.err.log"
  fi

  # Admin's view of the world (via its own API — same auth-free routes the UI uses)
  if ! curl -fsS --max-time 3 "$ADMIN_BASE/api/health" >/dev/null 2>&1; then
    flag "🔴" "Admin API ($ADMIN_BASE) not responding" "Run: nomad logs admin"
    return 0
  fi
  ok "admin API responding"

  # Remote-Ollama wiring (via /api/ollama/remote-status)
  local rs; rs="$(api_get /api/ollama/remote-status 2>/dev/null)"
  local configured connected
  configured="$(echo "$rs" | jq -r '.configured' 2>/dev/null)"
  connected="$(echo "$rs"  | jq -r '.connected'  2>/dev/null)"
  if [[ "$configured" == "true" && "$connected" == "true" ]]; then
    ok "admin → native Ollama wired up (configured + connected)"
  elif [[ "$configured" == "true" ]]; then
    flag "🔴" "Remote Ollama configured but admin can't reach it" "Run: nomad install (re-runs configureRemote)"
  else
    flag "🔴" "Remote Ollama not configured in admin" "Run: nomad install (idempotent — runs configureRemote)"
  fi

  # Download jobs — failed jobs are usually what brings users to 'nomad check'
  local jobs failed_n active_n waiting_n
  jobs="$(api_get /api/downloads/jobs 2>/dev/null)"
  if [[ -n "$jobs" ]]; then
    failed_n="$(echo "$jobs"  | jq '(.failed  // []) | length' 2>/dev/null)"
    active_n="$(echo "$jobs"  | jq '(.active  // []) | length' 2>/dev/null)"
    waiting_n="$(echo "$jobs" | jq '(.waiting // []) | length' 2>/dev/null)"
    [[ -z "$failed_n"  || ! "$failed_n"  =~ ^[0-9]+$ ]] && failed_n=0
    [[ -z "$active_n"  || ! "$active_n"  =~ ^[0-9]+$ ]] && active_n=0
    [[ -z "$waiting_n" || ! "$waiting_n" =~ ^[0-9]+$ ]] && waiting_n=0
    if [[ "$failed_n" -gt 0 ]]; then
      flag "🟡" "$failed_n failed download(s)" "Run: nomad downloads list  (and: nomad downloads remove JOBID to clear)"
    fi
    if [[ "$waiting_n" -gt 0 && "$active_n" -eq 0 ]]; then
      flag "🟡" "$waiting_n waiting download(s) but 0 active" "Worker may be stuck — try: nomad restart admin"
    fi
    ok "downloads — active=$active_n waiting=$waiting_n failed=$failed_n"
  fi

  # Wikipedia state — Chris's frequent issue
  local wiki; wiki="$(api_get /api/zim/wikipedia 2>/dev/null)"
  if [[ -n "$wiki" ]]; then
    local selected status
    selected="$(echo "$wiki" | jq -r '.selectedOptionId // .selected_option_id // "(none)"' 2>/dev/null)"
    status="$(echo "$wiki"   | jq -r '.status // "?"' 2>/dev/null)"
    ok "Wikipedia — selected=$selected status=$status"
  fi
}

# Pre-flight install inventory — what's already in place, what's missing, what's
# broken. Run before 'nomad install' to see exactly what it would and wouldn't
# touch on a re-run. Read-only.
INV_SKIP=0
INV_INSTALL=0
INV_FIX=0
inv_ok()      { printf "  %s✓%s %-26s %s\n" "$C_OK"   "$C_OFF" "$1" "$2"; INV_SKIP=$((INV_SKIP+1)); }
inv_missing() { printf "  %s✗%s %-26s %s\n" "$C_ERR"  "$C_OFF" "$1" "$2"; INV_INSTALL=$((INV_INSTALL+1)); }
inv_broken()  { printf "  %s⚠%s %-26s %s\n" "$C_WARN" "$C_OFF" "$1" "$2"; INV_FIX=$((INV_FIX+1)); }

check_install() {
  section "Install Inventory"
  echo "  ✓ already installed (would skip)   ✗ missing (would install)   ⚠ broken (would fix)"
  echo

  # --- toolchain ---
  if /usr/bin/xcode-select -p >/dev/null 2>&1; then
    inv_ok "Xcode CLT" "at $(/usr/bin/xcode-select -p)"
  else
    inv_missing "Xcode CLT" "system install dialog"
  fi

  if command -v brew >/dev/null 2>&1; then
    inv_ok "Homebrew" "$(brew --version | head -1 | awk '{print $2}')"
  else
    inv_missing "Homebrew" "official curl-based installer"
  fi

  if command -v jq >/dev/null 2>&1; then
    inv_ok "jq" "$(jq --version)"
  else
    inv_missing "jq" "brew install jq"
  fi

  if [[ "$(uname -m)" == "arm64" ]]; then
    if /usr/bin/arch -x86_64 /usr/bin/true >/dev/null 2>&1; then
      inv_ok "Rosetta 2" "ready"
    else
      inv_missing "Rosetta 2" "softwareupdate --install-rosetta"
    fi
  fi

  # --- container runtime ---
  local orb_app=""
  for p in /Applications/OrbStack.app "$HOME/Applications/OrbStack.app"; do
    [[ -d "$p" ]] && orb_app="$p" && break
  done
  if [[ -n "$orb_app" ]]; then
    inv_ok "OrbStack" "at $orb_app"
  else
    inv_missing "OrbStack" "brew install --cask orbstack"
  fi

  if ensure_docker_path && docker version >/dev/null 2>&1; then
    inv_ok "Docker daemon" "$(docker version --format '{{.Server.Version}}')"
  elif command -v docker >/dev/null 2>&1; then
    inv_broken "Docker daemon" "CLI present but daemon unreachable — open OrbStack.app"
  else
    inv_missing "Docker daemon" "comes with OrbStack"
  fi

  # --- Ollama (binary, agent, port, API) ---
  if command -v ollama >/dev/null 2>&1; then
    inv_ok "Ollama binary" "$(ollama --version 2>&1 | head -1 | sed 's/^.*version //')"
  else
    inv_missing "Ollama binary" "brew install ollama"
  fi

  if [[ -f "$LA_PLIST" ]]; then
    if launchctl print "$LA_TARGET/$LA_LABEL" >/dev/null 2>&1; then
      local lstate; lstate="$(launchctl print "$LA_TARGET/$LA_LABEL" 2>/dev/null | awk -F' = ' '/^\tstate/{print $2;exit}' | tr -d ' ')"
      inv_ok "Ollama LaunchAgent" "loaded (state=${lstate:-?})"
    else
      inv_broken "Ollama LaunchAgent" "plist present but not loaded — nomad reset-ollama"
    fi
  else
    inv_missing "Ollama LaunchAgent" "would write $LA_PLIST"
  fi

  if curl -fsS --max-time 3 http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
    local n_models; n_models="$(curl -fsS http://127.0.0.1:11434/api/tags | jq '.models | length' 2>/dev/null)"
    inv_ok "Ollama API" "responding on :11434, ${n_models:-0} model(s)"
  else
    inv_missing "Ollama API" "needs LaunchAgent running"
  fi

  if lsof -nP -iTCP:11434 -sTCP:LISTEN >/dev/null 2>&1; then
    local bind; bind="$(lsof -nP -iTCP:11434 -sTCP:LISTEN | awk 'NR==2{print $9}')"
    if [[ "$bind" == *"127.0.0.1:11434"* ]]; then
      inv_broken "Ollama port binding" "$bind — containers can't reach via host.docker.internal"
    else
      inv_ok "Ollama port binding" "$bind"
    fi
  fi

  # --- NOMAD-specific state ---
  if [[ -f "$ENV_FILE" ]]; then
    local missing_keys=()
    local key
    for key in NOMAD_DATA_ROOT APP_KEY MYSQL_ROOT_PASSWORD DB_PASSWORD URL; do
      grep -qE "^${key}=.+" "$ENV_FILE" 2>/dev/null || missing_keys+=("$key")
    done
    if [[ ${#missing_keys[@]} -eq 0 ]]; then
      inv_ok ".env secrets" "all 5 keys present at $ENV_FILE"
    else
      inv_broken ".env secrets" "missing/empty: ${missing_keys[*]}"
    fi
  else
    inv_missing ".env secrets" "would generate APP_KEY + DB passwords"
  fi

  local data_root="" state_root=""
  if [[ -f "$ENV_FILE" ]]; then
    data_root="$(grep '^NOMAD_DATA_ROOT='  "$ENV_FILE" | cut -d= -f2- 2>/dev/null)"
    state_root="$(grep '^NOMAD_STATE_ROOT=' "$ENV_FILE" | cut -d= -f2- 2>/dev/null)"
  fi
  [[ -z "$state_root" ]] && state_root="$NOMAD_STATE_ROOT_DEFAULT"

  # State root (always-internal hot state)
  if [[ -d "$state_root" ]]; then
    local sz; sz="$(du -sh "$state_root" 2>/dev/null | awk '{print $1}')"
    inv_ok "State root (mysql/redis)" "$state_root (${sz:-?}, internal)"
  else
    inv_missing "State root (mysql/redis)" "would create at $state_root"
  fi

  # Data root (configurable, possibly external)
  if [[ -n "$data_root" && -d "$data_root" ]]; then
    local free sz
    free="$(df -h "$data_root" 2>/dev/null | awk 'NR==2{print $4}')"
    sz="$(du -sh "$data_root" 2>/dev/null | awk '{print $1}')"
    local where="internal"
    [[ "$data_root" == /Volumes/* ]] && where="external — currently mounted"
    inv_ok "Data root (content)" "$data_root (${sz:-?} used, ${free:-?} free, $where)"
  elif [[ -n "$data_root" ]]; then
    inv_broken "Data root (content)" "$data_root not mounted — drive unplugged"
  else
    inv_missing "Data root (content)" "would prompt to pick disk"
  fi

  if ensure_docker_path && docker version >/dev/null 2>&1; then
    local needed=("ghcr.io/crosstalk-solutions/project-nomad:latest" \
                  "ghcr.io/crosstalk-solutions/project-nomad-sidecar-updater:latest" \
                  "amir20/dozzle:v10.0" "mysql:8.0" "redis:7-alpine")
    local cached=0 img
    for img in "${needed[@]}"; do
      docker image inspect "$img" >/dev/null 2>&1 && cached=$((cached+1))
    done
    if [[ "$cached" -eq ${#needed[@]} ]]; then
      inv_ok "Compose images" "all ${#needed[@]} cached locally"
    elif [[ "$cached" -gt 0 ]]; then
      inv_broken "Compose images" "$cached of ${#needed[@]} cached — would pull missing"
    else
      inv_missing "Compose images" "would pull all ${#needed[@]}"
    fi

    local running; running="$(docker ps --filter 'name=^nomad_' --format '{{.Names}}' 2>/dev/null | wc -l | tr -d ' ')"
    if [[ "$running" -ge 5 ]]; then
      inv_ok "NOMAD containers" "$running running"
    elif [[ "$running" -gt 0 ]]; then
      inv_broken "NOMAD containers" "$running running — would docker compose up -d"
    else
      inv_missing "NOMAD containers" "would start admin/mysql/redis/dozzle/updater"
    fi
  fi

  if curl -fsS --max-time 3 http://localhost:8080/api/health >/dev/null 2>&1; then
    inv_ok "Admin API" "responding on :8080"
    local rs cfg conn
    rs="$(curl -fsS --max-time 3 http://localhost:8080/api/ollama/remote-status 2>/dev/null)"
    cfg="$(echo "$rs" | jq -r '.configured' 2>/dev/null)"
    conn="$(echo "$rs" | jq -r '.connected'  2>/dev/null)"
    if [[ "$cfg" == "true" && "$conn" == "true" ]]; then
      inv_ok "Admin → Ollama wiring" "configured + connected"
    elif [[ "$cfg" == "true" ]]; then
      inv_broken "Admin → Ollama wiring" "configured but admin can't reach Ollama"
    else
      inv_missing "Admin → Ollama wiring" "POST /api/ollama/configure-remote"
    fi
  else
    inv_missing "Admin API" "needs containers running"
  fi

  # Plan summary
  echo
  printf "%s── plan if you run 'nomad install' now ──%s\n" "$C_HEAD" "$C_OFF"
  printf "  ${C_OK}skip${C_OFF}     %2d components already in place\n" "$INV_SKIP"
  printf "  ${C_ERR}install${C_OFF}  %2d missing components\n"          "$INV_INSTALL"
  printf "  ${C_WARN}fix${C_OFF}      %2d broken components\n"          "$INV_FIX"
  echo
  if [[ $((INV_INSTALL + INV_FIX)) -eq 0 ]]; then
    ok "Everything in place — 'nomad install' would be a no-op."
  elif [[ "$INV_INSTALL" -eq 0 ]]; then
    log "all components present; 'nomad install' would only fix the broken ones."
  else
    log "'nomad install' would install $INV_INSTALL and fix $INV_FIX, skipping $INV_SKIP."
  fi
}

print_findings() {
  if [[ ${#FINDINGS[@]} -eq 0 ]]; then
    ok "no issues detected"; return 0
  fi
  printf "\n%s── findings ──%s\n" "$C_HEAD" "$C_OFF"
  for f in "${FINDINGS[@]}"; do
    IFS='|' read -r sev title rec <<<"$f"
    printf "%s %s\n   %s→ %s%s\n" "$sev" "$title" "$C_DIM" "$rec" "$C_OFF"
  done
}

cmd_check() {
  local what="${1:-all}"
  # Tee output to a log file for iCloud sync
  local ts log_path latest_path
  ts="$(date +%Y%m%d-%H%M%S)"
  log_path="$HERE/nomad-check-${ts}.log"
  latest_path="$HERE/nomad-check-latest.log"
  exec > >(tee \
    >(sed -E 's/\x1B\[[0-9;]*[a-zA-Z]//g' > "$log_path") \
    >(sed -E 's/\x1B\[[0-9;]*[a-zA-Z]//g' > "$latest_path")) 2>&1

  printf "%s── nomad check (%s) — %s ──%s\n" "$C_HEAD" "$what" "$(date '+%Y-%m-%d %H:%M:%S')" "$C_OFF"
  printf "%s   log: %s%s\n" "$C_HEAD" "$log_path" "$C_OFF"
  case "$what" in
    system)    check_system ;;
    stack)     check_stack ;;
    install|inventory) check_install ;;
    all|*)     check_system; check_stack; check_install ;;
  esac
  print_findings
  echo
  dim "logs: $latest_path  (also $log_path)"
}

