step_deps() {
  section "Dependencies"

  # Xcode CLT
  if ! /usr/bin/xcode-select -p >/dev/null 2>&1; then
    log "installing Xcode Command Line Tools (system dialog will appear)"
    /usr/bin/xcode-select --install 2>/dev/null || true
    log "waiting for CLT install (5–20 min)…"
    while ! /usr/bin/xcode-select -p >/dev/null 2>&1; do sleep 10; printf "."; done
    echo; ok "Xcode CLT installed"
  else
    ok "Xcode CLT present"
  fi

  # Homebrew
  if ! command -v brew >/dev/null 2>&1; then
    log "installing Homebrew"
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    [[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
    [[ -x /usr/local/bin/brew   ]] && eval "$(/usr/local/bin/brew shellenv)"
    command -v brew >/dev/null 2>&1 || die "Homebrew install failed"
  fi
  ok "Homebrew $(brew --version | head -1 | awk '{print $2}')"
  brew update --quiet || warn "brew update hiccup — continuing"

  # jq
  command -v jq >/dev/null 2>&1 || brew install jq
  ok "jq $(jq --version)"

  # Rosetta on Apple Silicon
  if [[ "$(uname -m)" == "arm64" ]]; then
    if /usr/bin/arch -x86_64 /usr/bin/true >/dev/null 2>&1; then
      ok "Rosetta 2 ready"
    else
      log "installing Rosetta 2"
      sudo softwareupdate --install-rosetta --agree-to-license || warn "Rosetta install reported error — OrbStack may install on first amd64 pull"
    fi
  fi
}

# Returns the chosen DATA_ROOT on stdout
DATA_ROOT_RESOLVED=""
step_data_root() {
  section "Data root"
  local picked="$1"

  if [[ -z "$picked" ]]; then
    echo "Where should NOMAD store its data?"
    echo "  [0] Internal disk: $HOME/project-nomad-data  (default — works without external drive)"
    local cands=("INTERNAL")
    local i=1
    for v in /Volumes/*; do
      [[ -d "$v" ]] || continue
      local name; name="$(basename "$v")"
      [[ "$name" == "Macintosh HD" || "$name" == "Macintosh HD - Data" || "$name" == "Recovery" ]] && continue
      if ! touch "$v/.nomad-write-test" 2>/dev/null; then
        continue
      fi
      rm -f "$v/.nomad-write-test"
      local fs free
      fs="$(diskutil info "$v" 2>/dev/null | awk -F': *' '/Type \(Bundle\)/{print $2}' | xargs)"
      free="$(df -h "$v" 2>/dev/null | awk 'NR==2{print $4}')"
      printf "  [%d] External: %s  (fs=%s, free=%s)\n" "$i" "$v" "${fs:-?}" "${free:-?}"
      cands+=("$v"); i=$((i+1))
    done
    echo
    read -r -p "Pick a number [0=internal default], or paste a full path: " sel
    sel="${sel:-0}"
    if [[ "$sel" =~ ^[0-9]+$ ]]; then
      local idx="$sel"
      if [[ $idx -eq 0 ]]; then
        picked="$HOME/project-nomad-data"
      else
        [[ $idx -ge 1 && $idx -lt ${#cands[@]} ]] || die "out of range"
        picked="${cands[$idx]}/project-nomad"
      fi
    else
      picked="$sel"
    fi
  fi

  # Strict path resolution — no boot-drive fallthrough
  local parent; parent="$(dirname "$picked")"
  [[ -d "$parent" ]] || die "parent dir does not exist: $parent
Make sure your external drive is mounted, or pick another path."
  local parent_abs; parent_abs="$(cd "$parent" && pwd)"
  picked="$parent_abs/$(basename "$picked")"
  echo "Data root: $picked"

  # Filesystem (MySQL won't tolerate exFAT)
  local volume fs
  volume="$(df "$parent_abs" | awk 'NR==2{print $NF}')"
  fs="$(diskutil info "$volume" 2>/dev/null | awk -F': *' '/Type \(Bundle\)/{print $2}' | xargs)"
  case "$fs" in
    apfs|APFS) ok "$volume is APFS" ;;
    hfs+|HFS+|jhfs+|hfs|HFS) warn "$volume is $fs — APFS preferred" ;;
    exfat|*FAT*|msdos) die "$volume is $fs — MySQL requires APFS or HFS+. Reformat in Disk Utility." ;;
    *) warn "could not detect filesystem ($fs) — proceeding" ;;
  esac

  # Boot-drive guard
  local boot_vol; boot_vol="$(df / | awk 'NR==2{print $NF}')"
  if [[ "$volume" == "$boot_vol" ]]; then
    warn "$picked is on the BOOT volume — content can be 100s of GB"
    confirm "Install on boot drive?" || die "aborted — pick an external drive"
  fi

  # Disk space
  local free_gb; free_gb="$(df -g "$parent_abs" 2>/dev/null | awk 'NR==2{print $4}')"
  if [[ -n "$free_gb" && "$free_gb" =~ ^[0-9]+$ && "$free_gb" -lt 50 ]]; then
    warn "${free_gb} GB free — full English Wikipedia (96 GB) won't fit"
  fi

  # mysql + redis NO LONGER live here — they're on the internal state root.
  # Only content (Wikipedia, models, maps, etc.) goes on the data drive so
  # the drive can be safely unplugged without crashing the management plane.
  mkdir -p "$picked"/{storage,ollama-models}

  # Drop the portable HTML chat UI on the drive (alongside quick-chat.sh).
  # The shell script launches Ollama, then opens this page in the default browser.
  if [[ -f "$HERE/quick-chat.html" ]]; then
    cp "$HERE/quick-chat.html" "$picked/quick-chat.html"
    ok "quick-chat.html deployed to $picked/quick-chat.html  (browser UI)"
  else
    warn "quick-chat.html not found in bundle ($HERE) — drive will get only the shell version"
  fi

  # Drop a portable quick-chat script ON the drive — when this drive is plugged
  # into any other Mac, the user can run /Volumes/<drive>/project-nomad/quick-chat.sh
  # and immediately have ollama-as-a-server with all the cached models. No NOMAD
  # install needed on the second Mac, no Docker, no admin — just the LLM chat layer.
  cat > "$picked/quick-chat.sh" <<'QUICK_CHAT_EOF'
#!/usr/bin/env bash
# quick-chat.sh — portable Ollama bootstrapper for the NOMAD data drive.
# Lives on the drive so it travels with it. Run on ANY Mac:
#   bash /Volumes/<drive>/project-nomad/quick-chat.sh
# Result: native Ollama running, all the drive's cached models available, ready to chat.
#
# Does NOT install NOMAD. Just gets you LLM chat using the models on this drive.
# For the full NOMAD experience (admin UI / Wikipedia / RAG), install the bundle.

set -euo pipefail

C_OK=$'\033[0;32m'; C_WARN=$'\033[0;33m'; C_ERR=$'\033[0;31m'; C_HEAD=$'\033[1;36m'; C_OFF=$'\033[0m'
log()  { printf "%s==>%s %s\n"  "$C_HEAD" "$C_OFF" "$*"; }
ok()   { printf "%s ✓ %s%s\n"   "$C_OK"   "$*" "$C_OFF"; }
warn() { printf "%s ⚠ %s%s\n"   "$C_WARN" "$*" "$C_OFF"; }
die()  { printf "%s ✗ %s%s\n"   "$C_ERR"  "$*" "$C_OFF" >&2; exit 1; }

[[ "$(uname)" == "Darwin" ]] || die "macOS only — this is a Mac LLM bootstrapper"

DRIVE_ROOT="$(cd "$(dirname "$0")" && pwd)"
MODELS_DIR="$DRIVE_ROOT/ollama-models"
[[ -d "$MODELS_DIR" ]] || die "no ollama-models/ at $MODELS_DIR — is this the NOMAD data drive?"

log "Project NOMAD — quick-chat (portable LLM mode)"
echo "  drive:    $DRIVE_ROOT"
echo "  models:   $MODELS_DIR"
echo

# 1. Ensure ollama is installed
if ! command -v ollama >/dev/null 2>&1; then
  for o in /opt/homebrew/bin/ollama /usr/local/bin/ollama; do
    [[ -x "$o" ]] && export PATH="$(dirname "$o"):$PATH" && break
  done
fi
if ! command -v ollama >/dev/null 2>&1; then
  if command -v brew >/dev/null 2>&1; then
    log "installing ollama via Homebrew"
    brew install ollama
  else
    die "ollama not installed and Homebrew not present.
Install Homebrew first:
  /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\"
Then re-run this script."
  fi
fi
ok "ollama $(ollama --version 2>&1 | head -1)"

# 2. If a NOMAD LaunchAgent is already running on this Mac, just use it.
if curl -fsS --max-time 2 http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
  ok "ollama already serving on :11434 — using it"
else
  # Check if :11434 is squatted by something else
  if lsof -nP -iTCP:11434 -sTCP:LISTEN >/dev/null 2>&1; then
    warn ":11434 is in use but not responding. Stop the existing service first:"
    lsof -nP -iTCP:11434 -sTCP:LISTEN | head -3
    die "free :11434 then retry"
  fi
  log "starting ollama serve (Ctrl-C to stop the daemon when done)"
  log "models load lazily from the drive — first chat with each model is slower"
  echo
  export OLLAMA_MODELS="$MODELS_DIR"
  export OLLAMA_HOST="127.0.0.1:11434"
  export OLLAMA_KEEP_ALIVE="30m"
  export OLLAMA_FLASH_ATTENTION="1"
  export OLLAMA_KV_CACHE_TYPE="q8_0"
  # Allow browser pages (file:// or any local origin) to hit the API
  export OLLAMA_ORIGINS="*"
  ollama serve &
  OLLAMA_PID=$!
  trap 'kill $OLLAMA_PID 2>/dev/null || true' EXIT INT TERM

  # Wait for API
  for i in $(seq 1 15); do
    curl -fsS http://127.0.0.1:11434/api/tags >/dev/null 2>&1 && break
    sleep 1
  done
  ok "ollama serving on http://127.0.0.1:11434"
fi

# 3. List models
echo
log "models on this drive:"
OLLAMA_MODELS="$MODELS_DIR" ollama list 2>/dev/null | tail -n +1

# 4. Open the browser chat UI (preferred) — falls back to terminal chat if HTML missing
echo
HTML_UI="$DRIVE_ROOT/quick-chat.html"
if [[ -f "$HTML_UI" && -z "${1:-}" ]]; then
  log "opening browser chat: $HTML_UI"
  open "$HTML_UI"
  echo
  echo "  Browser tab is now talking to Ollama on http://127.0.0.1:11434"
  echo "  When you're done, return to this terminal and Ctrl-C to stop ollama serve."
  echo
  # Keep the daemon alive in the foreground until user quits
  wait "$OLLAMA_PID" 2>/dev/null
else
  # Terminal fallback — pass a model name as $1 to skip browser
  DEFAULT_MODEL="${1:-}"
  if [[ -z "$DEFAULT_MODEL" ]]; then
    DEFAULT_MODEL="$(OLLAMA_MODELS="$MODELS_DIR" ollama list 2>/dev/null | awk 'NR>1 {print $1, $3}' | sort -k2 -h | head -1 | awk '{print $1}')"
  fi
  if [[ -n "$DEFAULT_MODEL" ]]; then
    log "starting terminal chat with $DEFAULT_MODEL  (Ctrl-D or /bye to exit)"
    echo
    OLLAMA_MODELS="$MODELS_DIR" ollama run "$DEFAULT_MODEL"
  else
    warn "no models found on the drive at $MODELS_DIR"
    warn "to pull one: ollama pull llama3.2:3b"
  fi
fi
QUICK_CHAT_EOF
  chmod +x "$picked/quick-chat.sh"
  ok "quick-chat.sh deployed to $picked/quick-chat.sh  (portable across Macs)"

  DATA_ROOT_RESOLVED="$picked"
  ok "data tree ready under $picked  (storage + ollama-models + quick-chat.sh)"
}

step_orbstack() {
  section "OrbStack"
  local app=""
  for p in /Applications/OrbStack.app "$HOME/Applications/OrbStack.app"; do
    [[ -d "$p" ]] && app="$p" && break
  done
  if [[ -z "$app" ]]; then
    log "installing OrbStack via brew cask"
    brew install --cask orbstack
    [[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
    for p in /Applications/OrbStack.app "$HOME/Applications/OrbStack.app"; do
      [[ -d "$p" ]] && app="$p" && break
    done
    [[ -n "$app" ]] || die "OrbStack.app not found after brew install"
  fi
  ok "OrbStack at $app"

  /usr/bin/pgrep -x OrbStack >/dev/null 2>&1 || { log "launching OrbStack — accept any prompts"; open -a OrbStack; }

  log "waiting up to 3 min for docker daemon…"
  local deadline=$(( $(date +%s) + 180 ))
  while [[ $(date +%s) -lt $deadline ]]; do
    if ensure_docker_path && docker version >/dev/null 2>&1; then
      ok "docker daemon up: $(docker version --format '{{.Server.Version}}')"
      return 0
    fi
    sleep 2; printf "."
  done
  echo
  die "docker daemon never came up. Open OrbStack.app, finish first-run, re-run 'nomad install'"
}

step_ollama_native() {
  section "Native Ollama (Metal)"
  command -v ollama >/dev/null 2>&1 || brew install ollama
  ok "ollama $(ollama --version 2>/dev/null | head -1)"

  # Stop brew-managed service if present (we run our own LaunchAgent)
  if launchctl list 2>/dev/null | grep -q homebrew.mxcl.ollama; then
    brew services stop ollama >/dev/null || true
  fi

  # CRITICAL ORDERING: bootout the LaunchAgent BEFORE killing the ollama process.
  # If we kill first, launchd's KeepAlive=true immediately respawns the process,
  # and the subsequent bootstrap fails with "5: Input/output error" because the
  # label is still loaded.
  if launchctl print "$LA_TARGET/$LA_LABEL" >/dev/null 2>&1; then
    log "unloading existing LaunchAgent (preventing KeepAlive respawn)"
    launchctl bootout "$LA_TARGET/$LA_LABEL" 2>/dev/null || true
    sleep 2  # let launchd commit
  fi

  # Now free :11434 — any leftover process is an orphan, won't respawn
  if lsof -nP -iTCP:11434 -sTCP:LISTEN >/dev/null 2>&1; then
    local pid proc
    pid="$(lsof -nP -iTCP:11434 -sTCP:LISTEN -F p 2>/dev/null | awk '/^p/{sub(/^p/,"");print;exit}')"
    proc="$(lsof -nP -iTCP:11434 -sTCP:LISTEN -F c 2>/dev/null | awk '/^c/{sub(/^c/,"");print;exit}')"
    warn "process '$proc' (pid $pid) on :11434 after bootout — likely orphan"
    if confirm "Kill it?"; then
      kill "$pid" 2>/dev/null || true; sleep 1
      lsof -nP -iTCP:11434 -sTCP:LISTEN >/dev/null 2>&1 && kill -9 "$pid" 2>/dev/null || true
      sleep 1
      lsof -nP -iTCP:11434 -sTCP:LISTEN >/dev/null 2>&1 && die "could not free :11434"
    else
      die ":11434 must be free for native Ollama"
    fi
  fi

  # Write LaunchAgent — binds 0.0.0.0 so containers can reach via host.docker.internal
  mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"
  local ollama_bin; ollama_bin="$(command -v ollama)"
  # Compute MAX_LOADED_MODELS from RAM — controls how many models stay hot in
  # unified memory. Higher = faster model switching, more memory pressure.
  local ram_gb max_loaded
  ram_gb=$(( $(sysctl -n hw.memsize) / 1024 / 1024 / 1024 ))
  if   [[ $ram_gb -lt 16 ]];  then max_loaded=1
  elif [[ $ram_gb -lt 64 ]];  then max_loaded=2
  elif [[ $ram_gb -lt 128 ]]; then max_loaded=3
  else                             max_loaded=4
  fi

  # ---- LaunchAgent wrapper script ----
  # The LaunchAgent runs this wrapper (not ollama directly). The wrapper
  # resolves OLLAMA_MODELS at runtime so renamed/remounted drives don't break
  # the daemon. Falls back to ~/.ollama/models if the drive is unplugged.
  local LAUNCHER="$SECRETS_DIR/ollama-launcher.sh"
  cat > "$LAUNCHER" <<LAUNCH_EOF
#!/usr/bin/env bash
# Auto-generated by nomad install. Resolves NOMAD data drive at runtime.

# 1. Try the configured data root from .env
configured=""
if [[ -f "$ENV_FILE" ]]; then
  configured="\$(grep '^NOMAD_DATA_ROOT=' "$ENV_FILE" | cut -d= -f2-)"
fi
DRIVE_MODELS=""
if [[ -n "\$configured" && -d "\$configured/ollama-models" ]]; then
  DRIVE_MODELS="\$configured/ollama-models"
fi

# 2. Fallback: scan /Volumes for any drive that has project-nomad/ollama-models
#    (handles renames / remounts where the configured path doesn't match)
if [[ -z "\$DRIVE_MODELS" ]]; then
  for v in /Volumes/*; do
    if [[ -d "\$v/project-nomad/ollama-models" ]]; then
      DRIVE_MODELS="\$v/project-nomad/ollama-models"
      break
    fi
  done
fi

# 3. Internal fallback (drive missing — admin still works, just no models from drive)
if [[ -z "\$DRIVE_MODELS" ]]; then
  DRIVE_MODELS="\$HOME/.ollama/models"
  echo "[ollama-launcher] data drive not found at \$configured — falling back to \$DRIVE_MODELS" >&2
else
  echo "[ollama-launcher] using models from \$DRIVE_MODELS" >&2
fi

export OLLAMA_MODELS="\$DRIVE_MODELS"
exec ${ollama_bin} serve
LAUNCH_EOF
  chmod +x "$LAUNCHER"

  cat > "$LA_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>            <string>${LA_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${LAUNCHER}</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OLLAMA_HOST</key>             <string>0.0.0.0:11434</string>
    <key>OLLAMA_KEEP_ALIVE</key>       <string>30m</string>
    <key>OLLAMA_FLASH_ATTENTION</key>  <string>1</string>
    <key>OLLAMA_KV_CACHE_TYPE</key>    <string>q8_0</string>
    <key>OLLAMA_NUM_PARALLEL</key>     <string>4</string>
    <key>OLLAMA_MAX_LOADED_MODELS</key><string>${max_loaded}</string>
    <!-- OLLAMA_ORIGINS=* allows the quick-chat.html (file:// or any local origin)
         to hit the Ollama API. Single-user offline Mac — broad origin is fine. -->
    <key>OLLAMA_ORIGINS</key>          <string>*</string>
    <key>PATH</key>                    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>         <true/>
  <key>KeepAlive</key>         <true/>
  <key>StandardOutPath</key>   <string>${HOME}/Library/Logs/ollama.out.log</string>
  <key>StandardErrorPath</key> <string>${HOME}/Library/Logs/ollama.err.log</string>
</dict>
</plist>
EOF
  log "Ollama tuning: KV-cache=q8_0 (2× context for same RAM), num_parallel=4, max_loaded_models=$max_loaded for ${ram_gb} GB RAM"
  log "LaunchAgent wrapper at $LAUNCHER  (rename-safe drive resolution at runtime)"
  chmod 644 "$LA_PLIST"

  # Bootstrap with retry — "Input/output error" means launchd still has the label
  # in some transient state; sleep + bootout-again + retry is the documented dance.
  local attempt last_err=""
  for attempt in 1 2 3; do
    if launchctl bootstrap "$LA_TARGET" "$LA_PLIST" 2>/tmp/nomad-bootstrap.log; then
      last_err=""
      ok "LaunchAgent bootstrapped"
      break
    fi
    last_err="$(cat /tmp/nomad-bootstrap.log)"
    warn "bootstrap attempt $attempt failed: $last_err"
    if echo "$last_err" | grep -q "Input/output error"; then
      launchctl bootout "$LA_TARGET/$LA_LABEL" 2>/dev/null || true
      sleep $((attempt * 2))
    else
      sleep 2
    fi
  done
  if [[ -n "$last_err" ]]; then
    die "bootstrap failed after 3 attempts: $last_err
Manual recovery:
  launchctl bootout $LA_TARGET/$LA_LABEL 2>/dev/null
  pkill -f 'ollama serve'
  sleep 5
  launchctl bootstrap $LA_TARGET $LA_PLIST"
  fi

  log "waiting for Ollama API on :11434…"
  local deadline=$(( $(date +%s) + 30 ))
  while [[ $(date +%s) -lt $deadline ]]; do
    curl -fsS http://127.0.0.1:11434/api/tags >/dev/null 2>&1 && { ok "Ollama API responding"; return 0; }
    sleep 1
  done
  die "Ollama did not start — check ~/Library/Logs/ollama.err.log"
}

# Symlink ourselves into brew's bin dir so `nomad <cmd>` works without the
# 'bash' prefix or cd'ing into the bundle folder. Also install the manpage so
# `man nomad` works. Silent on failure.
step_self_install_to_path() {
  local prefix bindir target manpath manpage_target
  prefix="$(brew --prefix 2>/dev/null)"
  [[ -z "$prefix" ]] && return 0

  # CLI symlink
  bindir="$prefix/bin"
  target="$bindir/nomad"
  if [[ -d "$bindir" && -w "$bindir" ]]; then
    if [[ -L "$target" && "$(readlink "$target")" == "$HERE/nomad" ]]; then
      :   # already linked
    elif ln -sf "$HERE/nomad" "$target" 2>/dev/null; then
      ok "linked: $target → $HERE/nomad  (you can now run 'nomad <cmd>' directly)"
    fi
  fi

  # Manpage — only if we have one in the bundle
  if [[ -f "$HERE/nomad.1" ]]; then
    manpath="$prefix/share/man/man1"
    manpage_target="$manpath/nomad.1"
    mkdir -p "$manpath" 2>/dev/null
    if [[ -d "$manpath" && -w "$manpath" ]]; then
      if [[ -L "$manpage_target" && "$(readlink "$manpage_target")" == "$HERE/nomad.1" ]]; then
        :
      elif ln -sf "$HERE/nomad.1" "$manpage_target" 2>/dev/null; then
        ok "manpage: $manpage_target  ('man nomad' now works)"
      fi
    fi
  fi
}

step_secrets() {
  section "Secrets (.env, off-iCloud) + state root (always-internal)"
  mkdir -p "$SECRETS_DIR" && chmod 700 "$SECRETS_DIR"

  # State root: hot mysql/redis state, always internal — survives drive eject
  mkdir -p "$NOMAD_STATE_ROOT_DEFAULT"/{mysql,redis}
  chmod 700 "$NOMAD_STATE_ROOT_DEFAULT"
  ok "state root: $NOMAD_STATE_ROOT_DEFAULT  (mysql+redis go here)"

  # Capture host hardware ONCE so admin can identify the real Apple chip via
  # APPLE_CHIP_MODEL / APPLE_GPU_MODEL env vars (proximasan's fork reads these
  # in si.cpu() / si.graphics() fallback paths)
  local apple_chip apple_gpu
  apple_chip="$(/usr/sbin/system_profiler SPHardwareDataType 2>/dev/null \
    | /usr/bin/awk -F': *' '/Chip|Processor Name/{print $2; exit}' | xargs)"
  [[ -z "$apple_chip" ]] && apple_chip="$(/usr/sbin/sysctl -n machdep.cpu.brand_string 2>/dev/null | xargs)"
  if [[ "$(uname -m)" == "arm64" && -n "$apple_chip" ]]; then
    apple_gpu="${apple_chip} (Metal)"
  else
    apple_gpu="$(/usr/sbin/system_profiler SPDisplaysDataType 2>/dev/null \
      | /usr/bin/awk -F': *' '/Chipset Model/{print $2; exit}' | xargs)"
  fi

  if [[ -f "$ENV_FILE" ]]; then
    warn ".env exists — preserving secrets"
    # Backfill new keys for envs created before the split / Apple-chip injection
    grep -qE "^NOMAD_STATE_ROOT=" "$ENV_FILE" || \
      printf "NOMAD_STATE_ROOT=%s\n" "$NOMAD_STATE_ROOT_DEFAULT" >> "$ENV_FILE"
    grep -qE "^APPLE_CHIP_MODEL=" "$ENV_FILE" || \
      printf "APPLE_CHIP_MODEL=%s\n" "$apple_chip" >> "$ENV_FILE"
    grep -qE "^APPLE_GPU_MODEL=" "$ENV_FILE" || \
      printf "APPLE_GPU_MODEL=%s\n" "$apple_gpu"  >> "$ENV_FILE"
    grep -qE "^HOST_PLATFORM=" "$ENV_FILE" || \
      printf "HOST_PLATFORM=darwin\n" >> "$ENV_FILE"
  else
    cat > "$ENV_FILE" <<EOF
NOMAD_DATA_ROOT=${DATA_ROOT_RESOLVED}
NOMAD_STATE_ROOT=${NOMAD_STATE_ROOT_DEFAULT}
APP_KEY=$(openssl rand -hex 32)
MYSQL_ROOT_PASSWORD=$(openssl rand -hex 24)
DB_PASSWORD=$(openssl rand -hex 24)
URL=http://localhost:8080
APPLE_CHIP_MODEL=${apple_chip}
APPLE_GPU_MODEL=${apple_gpu}
HOST_PLATFORM=darwin
EOF
    chmod 600 "$ENV_FILE"
    ok "$ENV_FILE written (chmod 600)"
    log "host hardware injected for admin: $apple_chip / $apple_gpu"
  fi
  echo "$ENV_FILE" > "$HERE/.env-pointer"

  # Validate required keys (Apple chip vars are best-effort, not required)
  for key in NOMAD_DATA_ROOT NOMAD_STATE_ROOT APP_KEY MYSQL_ROOT_PASSWORD DB_PASSWORD URL; do
    grep -qE "^${key}=.+" "$ENV_FILE" || die ".env at $ENV_FILE missing $key — delete and re-run"
  done

  # Drive-change is now safe — mysql/redis live on internal state root,
  # so swapping data roots only relocates content (Wikipedia, models, maps).
  # No credential mismatch possible.
  local current; current="$(grep '^NOMAD_DATA_ROOT=' "$ENV_FILE" | cut -d= -f2-)"
  if [[ "$current" != "$DATA_ROOT_RESOLVED" ]]; then
    /usr/bin/sed -i '' "s|^NOMAD_DATA_ROOT=.*|NOMAD_DATA_ROOT=$DATA_ROOT_RESOLVED|" "$ENV_FILE"
    log "switched NOMAD_DATA_ROOT: $current → $DATA_ROOT_RESOLVED  (mysql/redis stay on internal state root)"
  fi
}

# Pull a single model via Ollama's HTTP API, rendering our own progress line.
# Args: model name, current index, total count, overall start timestamp.
# Always-visible counter format:
#   [2/4] qwen3:14b      pulling   42%   3845 MB / 9100 MB    elapsed 1m23s   total 4m07s
# Falls back to per-line output (no \r) when stdout isn't a TTY (logging/piped).
pull_one_model() {
  local m="$1" idx="$2" tot="$3" overall_start="$4"
  local model_start; model_start="$(date +%s)"
  local last_pct=-1 last_status=""
  local cr; [[ -t 1 ]] && cr=$'\r' || cr=$'\n'

  fmt_dur() {
    local s="$1"
    if [[ "$s" -ge 60 ]]; then printf '%dm%02ds' $((s/60)) $((s%60))
    else printf '%ds' "$s"; fi
  }

  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    local fields status total_b done_b
    fields="$(echo "$line" | jq -r '"\(.status // "")|\(.total // 0)|\(.completed // 0)|\(.error // "")"' 2>/dev/null || echo "||0|0|")"
    IFS='|' read -r status total_b done_b err <<<"$fields"
    [[ ! "$total_b" =~ ^[0-9]+$ ]] && total_b=0
    [[ ! "$done_b"  =~ ^[0-9]+$ ]] && done_b=0
    if [[ -n "$err" ]]; then
      printf "\n"
      warn "API error for $m: $err"
      return 1
    fi

    local elapsed=$(( $(date +%s) - model_start ))
    local total_elapsed=$(( $(date +%s) - overall_start ))
    if [[ "$total_b" -gt 0 ]]; then
      local pct=$(( done_b * 100 / total_b ))
      if [[ "$pct" -ne "$last_pct" || "$status" != "$last_status" ]]; then
        printf "%s[%d/%d] %-22s %-9s %3d%%  %5d MB / %5d MB  elapsed %-7s total %-7s   " \
          "$cr" "$idx" "$tot" "$m" "${status:0:9}" "$pct" \
          "$(( done_b / 1048576 ))" "$(( total_b / 1048576 ))" \
          "$(fmt_dur $elapsed)" "$(fmt_dur $total_elapsed)"
        last_pct=$pct
        last_status="$status"
      fi
    elif [[ -n "$status" && "$status" != "$last_status" ]]; then
      printf "%s[%d/%d] %-22s %-50s elapsed %-7s   " \
        "$cr" "$idx" "$tot" "$m" "${status:0:50}" \
        "$(fmt_dur $elapsed)"
      last_status="$status"
    fi
  done < <(curl -fsSN -X POST http://127.0.0.1:11434/api/pull \
              -H 'Content-Type: application/json' \
              -d "{\"name\":\"$m\",\"stream\":true}" 2>/dev/null)

  printf "\n"
  return 0
}

# Pre-pull the embedding model BEFORE wiring admin. ~270 MB, ~30 sec on
# residential broadband. Means the moment admin learns about Ollama, RAG and
# file embeddings work immediately. Without this, admin reports "Ollama
# installed" but any embedding-dependent feature returns 500 until the main
# foreground pull finishes the chat models.
step_pull_embedding_quick() {
  [[ "$SKIP_MODELS" -eq 1 ]] && return 0
  local m="nomic-embed-text"
  # Skip if already present
  if curl -fsS http://127.0.0.1:11434/api/tags 2>/dev/null \
     | jq -e --arg m "$m" '.models[]? | select(.name | startswith($m + ":") or .name == $m)' >/dev/null 2>&1; then
    ok "embedding model $m already present"
    return 0
  fi
  log "pre-pulling embedding model ($m, ~270 MB) so admin's RAG works the moment we wire it"
  if pull_one_model "$m" 1 1 "$(date +%s)"; then
    ok "embedding model ready"
  else
    warn "embedding pre-pull failed — admin will be wired but RAG is degraded until you 'nomad models pull $m'"
  fi
}

# Warn loudly if the user forced a tier larger than what their RAM can handle.
# Exits via die unless they confirm or pass --yes.
warn_if_tier_above_auto() {
  [[ "$TIER" == "auto" ]] && return 0
  local auto_t; auto_t="$(auto_tier)"
  local order=(tiny small medium large xl dreamy)
  local auto_idx=-1 picked_idx=-1 i=0
  for t in "${order[@]}"; do
    [[ "$t" == "$auto_t" ]] && auto_idx=$i
    [[ "$t" == "$TIER"   ]] && picked_idx=$i
    i=$((i+1))
  done
  if [[ "$picked_idx" -gt "$auto_idx" ]]; then
    local ram_gb; ram_gb=$(( $(sysctl -n hw.memsize) / 1024 / 1024 / 1024 ))
    echo
    warn "you picked --tier $TIER but your ${ram_gb} GB Mac auto-resolves to '$auto_t'."
    warn "Models in '$TIER' use up to $(tier_size_gb "$TIER") GB RAM at peak."
    warn "Inference will be slow and may swap to disk during chat."
    if ! confirm "Continue with --tier $TIER anyway?"; then
      die "aborted — try 'nomad install --tier $auto_t' for auto-sized models"
    fi
    log "proceeding with oversized tier — you've been warned"
  fi
}

# Pull the resolved tier — runs AFTER admin is up so the admin UI is usable
# while models stream in. Each model pulled via the Ollama API so we render
# our own counter (always visible, works when piped).
step_pull_models() {
  [[ "$SKIP_MODELS" -eq 1 ]] && return 0
  local resolved_tier="$TIER"
  [[ "$resolved_tier" == "auto" ]] && resolved_tier="$(auto_tier)"
  local size_gb; size_gb="$(tier_size_gb "$resolved_tier")"

  section "Model pulls — tier '$resolved_tier' (~${size_gb} GB total)"
  log "models: $MODELS"
  log "you can open http://localhost:8080 now — models stream into admin as they finish"
  echo

  local total ok_count=0 fail_count=0 i=0
  total="$(echo "$MODELS" | wc -w | tr -d ' ')"
  local overall_start; overall_start="$(date +%s)"

  for m in $MODELS; do
    i=$((i+1))
    if pull_one_model "$m" "$i" "$total" "$overall_start"; then
      ok "[$i/$total] $m ready"
      ok_count=$((ok_count+1))
    else
      warn "[$i/$total] $m FAILED — admin works without it; retry: nomad models pull $m"
      fail_count=$((fail_count+1))
    fi
  done

  local total_dur=$(( $(date +%s) - overall_start ))
  if [[ "$fail_count" -eq 0 ]]; then
    ok "all $ok_count model(s) pulled in $((total_dur / 60))m$((total_dur % 60))s"
  else
    warn "$ok_count succeeded, $fail_count failed in $((total_dur / 60))m$((total_dur % 60))s"
  fi
}

step_compose_pull() {
  section "Compose pull"
  ensure_docker_path
  if ! dc pull 2>&1 | tee /tmp/nomad-pull.log; then
    # Did proximasan's images fail? Fall back to upstream amd64 (slower, Rosetta-emulated)
    if grep -qiE "proximasan|manifest unknown|not found|denied" /tmp/nomad-pull.log; then
      warn "proximasan's images unreachable — falling back to upstream amd64 (Rosetta-emulated)"
      # Append fallback overrides to .env so subsequent dc commands inherit them
      grep -q "^NOMAD_ADMIN_IMAGE="   "$ENV_FILE" \
        || echo "NOMAD_ADMIN_IMAGE=ghcr.io/crosstalk-solutions/project-nomad:latest" >> "$ENV_FILE"
      grep -q "^NOMAD_UPDATER_IMAGE=" "$ENV_FILE" \
        || echo "NOMAD_UPDATER_IMAGE=ghcr.io/crosstalk-solutions/project-nomad-sidecar-updater:latest" >> "$ENV_FILE"
      # Re-add platform amd64 to the running compose (sed-injection if not already there)
      if ! grep -q "platform: linux/amd64" "$COMPOSE_BASE"; then
        cp "$COMPOSE_BASE" "$COMPOSE_BASE.bak"
        awk '/^services:/{p=1} p && /^  (admin|updater):/{print; print "    platform: linux/amd64  # nomad: amd64-fallback"; next} {print}' \
          "$COMPOSE_BASE" > "$COMPOSE_BASE.tmp" && mv "$COMPOSE_BASE.tmp" "$COMPOSE_BASE"
      fi
      log "retrying pull with upstream + platform: linux/amd64"
      dc pull 2>&1 | tee /tmp/nomad-pull.log \
        || die "fallback pull also failed — see /tmp/nomad-pull.log"
      ok "compose images pulled (upstream amd64 fallback)"
    else
      die "compose pull failed — see /tmp/nomad-pull.log
(common causes: no network, GHCR rate limit, auth issue)"
    fi
  else
    ok "compose images pulled (proximasan multi-arch — native)"
  fi
}

step_compose_up() {
  section "Compose up"
  dc up -d
  ok "containers up"
}

step_wait_admin() {
  section "Admin /api/health"
  local deadline=$(( $(date +%s) + 180 ))
  while [[ $(date +%s) -lt $deadline ]]; do
    curl -fsS http://localhost:8080/api/health >/dev/null 2>&1 && { ok "admin healthy"; return 0; }
    sleep 3
  done
  warn "admin slow to come up — last status:"
  dc ps || true
  die "investigate: nomad logs admin"
}

# Install a background LaunchAgent that polls admin's benchmark_results table
# every 30 seconds and patches any unpatched rows with this Mac's real Apple
# chip + Metal GPU. Means the upstream leaderboard never sees "-" for our
# hardware — even after re-runs, even after Macs change. Idempotent: re-running
# the install just rewrites the script and re-bootstraps the agent.
step_install_benchmark_patcher() {
  section "Benchmark host-info auto-patcher"

  cat > "$PATCHER_SCRIPT" <<PATCHER_EOF
#!/bin/bash
# Auto-patch admin's benchmark_results with the Mac's real CPU/GPU. Containers
# can't see Apple Silicon — admin records empty fields, leaderboard shows "-".
# This script fixes any unpatched rows. Runs every 30s via LaunchAgent.

set -uo pipefail

ENV_FILE="$ENV_FILE"
[[ -f "\$ENV_FILE" ]] || exit 0

# Read DB password from .env without sourcing (avoid expansion issues)
DB_PASSWORD="\$(grep '^DB_PASSWORD=' "\$ENV_FILE" | cut -d= -f2-)"
[[ -n "\$DB_PASSWORD" ]] || exit 0

# Find docker on PATH
for d in /opt/homebrew/bin/docker /usr/local/bin/docker /Applications/OrbStack.app/Contents/MacOS/xbin/docker; do
  if [[ -x "\$d" ]]; then
    export PATH="\$(dirname "\$d"):\$PATH"
    break
  fi
done
command -v docker >/dev/null 2>&1 || exit 0
docker version >/dev/null 2>&1 || exit 0

# Quick existence check — if mysql container isn't running, nothing to patch
docker ps --format '{{.Names}}' 2>/dev/null | grep -qE '^nomad_mysql$' || exit 0

# Collect host hardware (cheap, ~10ms)
chip="\$(/usr/sbin/system_profiler SPHardwareDataType 2>/dev/null | /usr/bin/awk -F': *' '/Chip|Processor Name/{print \$2; exit}' | xargs)"
[[ -z "\$chip" ]] && chip="\$(/usr/sbin/sysctl -n machdep.cpu.brand_string 2>/dev/null | xargs)"
[[ -z "\$chip" ]] && exit 0   # nothing to do if we can't even identify the chip

cores="\$(/usr/sbin/sysctl -n hw.ncpu)"
arch="\$(/usr/bin/uname -m)"
if [[ "\$arch" == "arm64" ]]; then
  gpu_model="\${chip} (Metal)"
else
  gpu_model="\$(/usr/sbin/system_profiler SPDisplaysDataType 2>/dev/null | /usr/bin/awk -F': *' '/Chipset Model/{print \$2; exit}' | xargs)"
  [[ -z "\$gpu_model" ]] && gpu_model="\$chip"
fi

# Patch any rows where the model isn't already an Apple chip name (so we
# don't keep rewriting already-correct rows uselessly)
SQL="UPDATE benchmark_results
     SET cpu_model = '\$chip',
         cpu_cores = \$cores,
         cpu_threads = \$cores,
         gpu_model = '\$gpu_model'
     WHERE (cpu_model = '' OR cpu_model IS NULL OR cpu_model NOT LIKE 'Apple%');"

# Run silently — log only if there's an error worth investigating
echo "\$SQL" | docker exec -i -e MYSQL_PWD="\$DB_PASSWORD" nomad_mysql \
  /usr/bin/mysql -u nomad_user nomad >/dev/null 2>>"\$HOME/Library/Logs/nomad-benchmark-patcher.err.log" || true
PATCHER_EOF
  chmod 755 "$PATCHER_SCRIPT"
  ok "patcher script: $PATCHER_SCRIPT"

  # LaunchAgent — runs every 30s
  cat > "$PATCHER_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>            <string>${PATCHER_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${PATCHER_SCRIPT}</string>
  </array>
  <key>StartInterval</key>    <integer>30</integer>
  <key>RunAtLoad</key>        <true/>
  <key>StandardOutPath</key>  <string>${HOME}/Library/Logs/nomad-benchmark-patcher.out.log</string>
  <key>StandardErrorPath</key><string>${HOME}/Library/Logs/nomad-benchmark-patcher.err.log</string>
</dict>
</plist>
EOF
  chmod 644 "$PATCHER_PLIST"

  # Re-bootstrap (replaces any prior version)
  if launchctl print "$LA_TARGET/$PATCHER_LABEL" >/dev/null 2>&1; then
    launchctl bootout "$LA_TARGET/$PATCHER_LABEL" 2>/dev/null || true
    sleep 1
  fi
  if launchctl bootstrap "$LA_TARGET" "$PATCHER_PLIST" 2>/dev/null; then
    ok "auto-patcher loaded (every 30s, fills in real Apple chip on benchmark rows)"
  else
    warn "couldn't bootstrap patcher — leaderboard submissions will still show '-'.  Manual: nomad benchmark patch-host"
  fi
}

# Wire admin → native Ollama via the admin's own API.
# POST /api/ollama/configure-remote runs the full side-effect chain:
#   • validates URL format
#   • tests connectivity to the remote /v1/models endpoint
#   • sets KV ai.remoteOllamaUrl
#   • marks services.nomad_ollama installed=1
#   • stops local nomad_ollama container if running
#   • triggers Qdrant preflight install (for RAG embeddings)
#   • sets chat.suggestionsEnabled=false
#   • triggers RAG docs discovery
# Idempotent — safe to re-run.
step_configure_native_ollama() {
  section "Wire admin → native Ollama (via admin API)"
  api_check_up
  local body resp
  body='{"remoteUrl":"http://host.docker.internal:11434"}'
  if resp="$(api_post /api/ollama/configure-remote "$body" 2>&1)"; then
    if echo "$resp" | jq -e '.success == true' >/dev/null 2>&1; then
      ok "configured: $(echo "$resp" | jq -r '.message // "Remote Ollama configured."')"
      return 0
    fi
    warn "API returned: $resp"
  else
    warn "POST /api/ollama/configure-remote failed: $resp"
  fi
  # Defensive fallback for the rare case admin's API is up but configureRemote
  # can't reach native Ollama (e.g., DNS for host.docker.internal not resolving
  # inside the admin container yet). Direct SQL bypasses the connectivity test.
  warn "falling back to direct SQL seed"
  local db_pw; db_pw="$(grep '^DB_PASSWORD=' "$ENV_FILE" | cut -d= -f2-)"
  echo '
INSERT INTO kv_store (`key`, value, created_at, updated_at)
VALUES ("ai.remoteOllamaUrl", "http://host.docker.internal:11434", NOW(), NOW()) AS new
ON DUPLICATE KEY UPDATE
  value      = IF(kv_store.value IS NULL OR kv_store.value = "", new.value, kv_store.value),
  updated_at = NOW();
UPDATE services SET installed = 1, installation_status = "idle", updated_at = NOW()
WHERE service_name = "nomad_ollama" AND installed = 0;
' | dc exec -T -e MYSQL_PWD="$db_pw" mysql mysql -u nomad_user nomad >/dev/null 2>&1 \
  && { ok "seeded via SQL fallback"; dc restart admin >/dev/null; sleep 5; return 0; } \
  || warn "both API and SQL paths failed — manually set Settings → Models → Remote Ollama URL"
}

cmd_install() {
  sudo_bootstrap
  log "Project NOMAD — macOS install (target: $(uname -m), $(sw_vers -productVersion))"

  # If user picked a tier larger than auto-detected, warn explicitly about
  # slowness/swap before committing — let them confirm or back off.
  warn_if_tier_above_auto

  step_deps
  step_data_root "$DATA_ROOT_ARG"
  step_orbstack
  step_orbstack_tune_quiet  # auto-bump VM RAM to 80% of host (proportional, no prompt during install)
  step_ollama_native
  step_self_install_to_path
  step_secrets
  step_compose_pull
  step_compose_up
  step_wait_admin
  step_pull_embedding_quick    # ~270 MB, ~30s — admin's RAG works the moment we wire
  step_configure_native_ollama
  step_install_benchmark_patcher   # background daemon that fixes leaderboard CPU/GPU automatically

  # Admin is now usable. Print the URL banner BEFORE the long model pull so the
  # user can open the admin in a browser while models stream in.
  cat <<EOF

${C_OK}── Admin is up ──${C_OFF}
  Admin UI ........ http://localhost:8080
  Log viewer ...... http://localhost:9999  (Dozzle)
  Native Ollama ... http://localhost:11434  (Metal-accelerated)

