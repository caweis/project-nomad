# ─── lifecycle subcommands ────────────────────────────────────────────────────
cmd_up()     { ensure_docker_path; dc up -d; }
cmd_down()   { ensure_docker_path; dc down; }
cmd_restart(){
  ensure_docker_path
  local svc="${1:-admin}"
  # Compose-managed services live in our compose.yaml; admin-spawned content
  # services (kiwix/kolibri/cyberchef/flatnotes/etc) are launched by admin
  # via the docker socket and aren't visible to docker compose. Detect by
  # querying compose for the service list — if the requested name isn't there,
  # fall through to plain `docker restart` against the matching container.
  if dc config --services 2>/dev/null | grep -qx "$svc"; then
    dc restart "$svc"
    return $?
  fi
  # Try the literal name + the nomad_ prefix (so `nomad restart kiwix` works
  # even though the actual container is `nomad_kiwix_server`).
  local container=""
  for candidate in "$svc" "nomad_$svc" "nomad_${svc}_server"; do
    if docker inspect "$candidate" >/dev/null 2>&1; then
      container="$candidate"
      break
    fi
  done
  if [[ -z "$container" ]]; then
    die "no compose service or container matching: $svc
Compose services: $(dc config --services 2>/dev/null | tr '\n' ' ')
Try: docker ps --format '{{.Names}}' to see all running containers"
  fi
  log "restarting $container (admin-spawned container — not in compose.yaml)"
  docker restart "$container"
}
cmd_logs() {
  ensure_docker_path
  # Default: snapshot last 100 lines of admin (no follow).
  # Pass-through any flags + service names: nomad logs -f admin / nomad logs --tail 500 mysql
  if [[ $# -eq 0 ]]; then
    dc logs --tail=100 admin
  else
    dc logs "$@"
  fi
}

cmd_models() {
  local sub="${1:-list}"
  case "$sub" in
    list|"")
      if ! curl -fsS --max-time 3 http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
        die "native Ollama not responding — run 'nomad install' or 'nomad reset-ollama'"
      fi
      local ram_gb; ram_gb=$(( $(sysctl -n hw.memsize) / 1024 / 1024 / 1024 ))
      # Rule of thumb: a Q4 model needs ~1.2× its file size in RAM for inference
      # (weights + KV cache + overhead). Compare against (RAM - 6 GB OS+apps reserve).
      local usable_ram_gb=$(( ram_gb - 6 ))
      [[ $usable_ram_gb -lt 2 ]] && usable_ram_gb=2

      echo "Installed models (native Ollama on :11434, this Mac has ${ram_gb} GB RAM, ~${usable_ram_gb} GB usable for inference):"
      # Per-model fits check: emit name | size | fits | modified
      curl -fsS http://127.0.0.1:11434/api/tags \
        | jq -r --arg ur "$usable_ram_gb" '
          .models[]? |
          (.size/1024/1024/1024) as $gb |
          ($gb * 1.2) as $needed |
          (if $needed <= ($ur|tonumber) then "✓ fits"
           elif $needed <= ($ur|tonumber)*1.3 then "⚠ tight (may swap)"
           else "✗ too big" end) as $verdict |
          "  \(.name)\t\($gb | tostring | .[0:5]) GB\t\($needed | tostring | .[0:5]) GB needed\t\($verdict)\tmodified=\(.modified_at[0:19])"' \
        | column -t -s $'\t'
      echo
      local detected; detected="$(auto_tier)"
      echo "Tiers (auto-detected for this Mac: ${ram_gb} GB RAM → '$detected'):"
      printf "  %-7s ~%4s GB   %s\n" "tiny"   "$(tier_size_gb tiny)"   "$TIER_TINY"
      printf "  %-7s ~%4s GB   %s\n" "small"  "$(tier_size_gb small)"  "$TIER_SMALL"
      printf "  %-7s ~%4s GB   %s\n" "medium" "$(tier_size_gb medium)" "$TIER_MEDIUM"
      printf "  %-7s ~%4s GB   %s\n" "large"  "$(tier_size_gb large)"  "$TIER_LARGE"
      printf "  %-7s ~%4s GB   %s\n" "xl"     "$(tier_size_gb xl)"     "$TIER_XL"
      printf "  %-7s ~%4s GB   %s\n" "dreamy" "$(tier_size_gb dreamy)" "$TIER_DREAMY"
      echo
      echo "Pull a tier:           nomad models pull <tier>"
      echo "Pull specific names:   nomad models pull qwen3:32b deepseek-r1:32b"
      ;;
    pull)
      shift
      ensure_ollama_path || die "ollama not found anywhere — run 'nomad install' first"
      if ! curl -fsS --max-time 3 http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
        die "native Ollama not responding — run 'nomad reset-ollama'"
      fi
      prevent_sleep  # 80 GB+ pulls can run an hour — don't let the Mac sleep
      # Args: nothing (use --tier or auto), tier name, or specific model names
      local to_pull
      if [[ $# -eq 0 ]]; then
        to_pull="$MODELS"   # already resolved from --tier or auto at dispatch
        local t="$TIER"; [[ "$t" == "auto" ]] && t="$(auto_tier)"
        log "pulling tier '$t' (~$(tier_size_gb "$t") GB): $to_pull"
      elif [[ $# -eq 1 ]] && echo " auto tiny small medium large xl dreamy " | grep -q " $1 "; then
        to_pull="$(resolve_tier_models "$1")"
        local t="$1"; [[ "$t" == "auto" ]] && t="$(auto_tier)"
        log "pulling tier '$t' (~$(tier_size_gb "$t") GB): $to_pull"
      else
        to_pull="$*"
        log "pulling: $to_pull"
      fi
      local ok_count=0 fail_count=0
      for m in $to_pull; do
        if ollama pull "$m"; then
          ok "pulled: $m"
          ok_count=$((ok_count+1))
        else
          warn "failed: $m  (check name at https://ollama.com/library)"
          fail_count=$((fail_count+1))
        fi
      done
      if [[ "$fail_count" -eq 0 ]]; then
        ok "all $ok_count model(s) pulled"
      else
        warn "$ok_count succeeded, $fail_count failed"
        [[ "$ok_count" -eq 0 ]] && exit 1
      fi
      ;;
    *)
      die "usage: nomad models [list|pull [NAME ...]]" ;;
  esac
}

# Software upgrade router. Three different upgrade paths exist on this stack:
#   1. compose stack (admin/mysql/redis/dozzle/updater) — managed by docker compose
#   2. native Ollama — installed via Homebrew, runs as LaunchAgent
#   3. admin-spawned content services (kiwix/cyberchef/kolibri/flatnotes) — admin
#      manages the lifecycle via Docker socket, but image pulls go through plain docker
#
# Each has its own pre-flight + apply pattern. This subcommand wraps them with
# safety checks per service. The big footgun: admin's "AI Assistant" Update button
# tries to update admin's container Ollama (which we don't use), would conflict
# with our native daemon for :11434. Always use 'nomad upgrade ollama' instead.
cmd_upgrade() {
  local target="all"
  local force=0
  local check=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=1; shift ;;
      --check) check=1; shift ;;
      "")      shift ;;
      *)       target="$1"; shift ;;
    esac
  done

  ensure_docker_path
  # Compose pulls can run several GB; native-Ollama upgrades trigger a brew
  # bottle download; admin-spawned image pulls (kiwix, etc.) are similar.
  # Don't let the Mac sleep mid-stream.
  [[ "$check" -eq 0 ]] && prevent_sleep

  case "$target" in
    all)
      section "Upgrade — full stack (dry run: pass --check)"
      log "1/3  compose stack (admin/mysql/redis/dozzle/updater)"
      _upgrade_compose_stack "$check"
      echo
      log "2/3  native Ollama (Homebrew)"
      _upgrade_native_ollama "$check"
      echo
      log "3/3  admin-spawned services"
      cat <<NOTES
  Use 'nomad upgrade <service>' for kiwix/cyberchef/kolibri/flatnotes — each
  has service-specific safety checks. Or click Update in admin's Apps UI for
  most services (but NOT AI Assistant — see warning below).

  ${C_WARN}DO NOT click admin's "AI Assistant" Update button.${C_OFF}
  That tries to update a container-Ollama we don't use. Run
  'nomad upgrade ollama' instead — upgrades native Metal Ollama via brew.
NOTES
      ;;

    ollama|nomad_ollama)
      _upgrade_native_ollama "$check"
      ;;

    kiwix|nomad_kiwix|nomad_kiwix_server)
      _upgrade_kiwix "$force" "$check"
      ;;

    admin|mysql|redis|dozzle|updater)
      _upgrade_compose_one "$target" "$check"
      ;;

    *)
      _upgrade_admin_spawned_one "$target" "$check"
      ;;
  esac
}

_upgrade_native_ollama() {
  local check="$1"
  if ! command -v brew >/dev/null 2>&1; then
    warn "Homebrew not found — can't upgrade native Ollama"
    return 1
  fi
  local current
  current="$(brew list --versions ollama 2>/dev/null | awk '{print $2}')"
  log "current native ollama: ${current:-not installed via brew}"
  if [[ "$check" == "1" ]]; then
    log "(pass --check off to apply: brew update + brew upgrade ollama + reset-ollama)"
    return 0
  fi
  log "running brew update + brew upgrade ollama..."
  brew update >/dev/null 2>&1 || warn "brew update returned non-zero (network? formula tap?) — continuing with cached formulas"
  if ! brew upgrade ollama 2>&1 | tail -10; then
    warn "brew upgrade ollama exited non-zero"
    return 1
  fi
  ok "ollama upgraded (or already at latest)"
  log "restarting native Ollama LaunchAgent..."
  cmd_reset_ollama

  # Don't claim success until Ollama's actually responding. The LaunchAgent
  # comes up async — between `launchctl bootstrap` returning and Ollama
  # binding :11434 there's typically 2-8 seconds of nothing. Without this
  # wait, the next `nomad models` or admin API call may hit ECONNREFUSED.
  log "waiting up to 30s for Ollama API on :11434..."
  local waited=0
  while [[ "$waited" -lt 30 ]]; do
    if curl -fsS --max-time 2 http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
      ok "native Ollama back up with current version: $(brew list --versions ollama 2>/dev/null | awk '{print $2}')"
      return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done

  # Never came back. Dump diagnostic state so the user can see WHY before
  # they ssh in and start poking around.
  warn "Ollama API didn't respond within 30s after upgrade — daemon may have failed to start"
  local plist_label="com.projectnomad.ollama"
  log "launchctl state for $plist_label:"
  launchctl list 2>/dev/null | awk -v label="$plist_label" '$3==label {print "  PID="$1" rc="$2" label="$3}' | sed 's/^/  /'
  local err_log="$HOME/Library/Logs/nomad-ollama.err.log"
  if [[ -s "$err_log" ]]; then
    log "tail of $err_log:"
    tail -20 "$err_log" | sed 's/^/  /'
  fi
  log "recovery: try 'nomad reset-ollama', or 'tail -f $err_log' to watch the daemon retry"
  return 1
}

_upgrade_kiwix() {
  local force="$1" check="$2"
  if ! docker inspect nomad_kiwix_server >/dev/null 2>&1; then
    warn "no kiwix container — admin spawns it once a ZIM download completes"
    return 0
  fi
  local current_image
  current_image="$(docker inspect nomad_kiwix_server --format '{{.Config.Image}}' 2>/dev/null)"
  log "current kiwix image: $current_image"
  if [[ "$check" == "1" ]]; then
    log "(pass --check off to apply: pull + remove container — admin re-spawns)"
    return 0
  fi
  # Safety check — don't restart kiwix mid-write.
  # Previously: a curl/jq failure produced active_zim=unknown which was then
  # treated as ">0 active downloads, block upgrade" — indistinguishable from
  # an actual full queue. Now: surface "couldn't query admin" explicitly and
  # tell the user to pass --force if they accept the risk.
  local active_zim
  active_zim="$(curl -fsS --max-time 4 http://localhost:8080/api/downloads/jobs 2>/dev/null \
    | jq -r '[.[]? | select(.filetype=="zim" and .status=="active")] | length' 2>/dev/null || echo unknown)"
  if [[ "$active_zim" == "unknown" ]]; then
    if [[ "$force" == "1" ]]; then
      warn "couldn't reach admin's queue API — proceeding anyway (--force)"
    else
      warn "couldn't reach admin's queue API at :8080/api/downloads/jobs"
      warn "Can't verify whether a ZIM is mid-write — refusing to restart kiwix blind."
      warn "If admin is down or unreachable and no ZIM download is active, pass --force."
      return 1
    fi
  elif [[ "$active_zim" != "0" && "$force" != "1" ]]; then
    warn "$active_zim active ZIM download(s) in admin's queue"
    warn "Restarting kiwix mid-write would crash on the partial and break the download."
    warn "Wait for queue to drain (nomad downloads list), or pass --force"
    return 1
  fi
  log "pulling latest image..."
  docker pull "$current_image" || { warn "pull failed"; return 1; }
  log "removing old container; admin will re-spawn with new image..."
  docker rm -f nomad_kiwix_server >/dev/null 2>&1 || true
  ok "kiwix removed. Admin re-spawns within ~30s. Watch: docker ps --filter name=kiwix"
}

_upgrade_compose_one() {
  local svc="$1" check="$2"
  if [[ "$check" == "1" ]]; then
    log "compose service: $svc (use 'dc pull $svc && dc up -d --force-recreate $svc' to apply)"
    return 0
  fi
  log "pulling latest image for $svc..."
  dc pull "$svc" || { warn "pull failed for $svc"; return 1; }
  log "recreating $svc with new image..."
  dc up -d --force-recreate "$svc"
  ok "$svc upgraded"
}

_upgrade_compose_stack() {
  local check="$1"
  if [[ "$check" == "1" ]]; then
    log "compose services: $(dc config --services 2>/dev/null | tr '\n' ' ')"
    log "(pass --check off to apply: dc pull + dc up -d)"
    return 0
  fi
  log "pulling latest compose images..."
  dc pull || { warn "compose pull failed"; return 1; }
  log "recreating containers with new images..."
  dc up -d
  ok "compose stack upgraded"
}

_upgrade_admin_spawned_one() {
  local svc="$1" check="$2"
  local container=""
  for candidate in "$svc" "nomad_$svc" "nomad_${svc}_server"; do
    if docker inspect "$candidate" >/dev/null 2>&1; then
      container="$candidate"
      break
    fi
  done
  [[ -z "$container" ]] && die "no compose service or admin-spawned container matching: $svc
Try one of: ollama | kiwix | admin | mysql | redis | dozzle | updater | cyberchef | kolibri | flatnotes
Or 'nomad upgrade --check' to see what's available."
  local current_image
  current_image="$(docker inspect "$container" --format '{{.Config.Image}}' 2>/dev/null)"
  log "$container current image: $current_image"
  if [[ "$check" == "1" ]]; then
    log "(pass --check off to apply: pull + remove container — admin re-spawns)"
    return 0
  fi
  log "pulling latest image..."
  docker pull "$current_image" || { warn "pull failed"; return 1; }
  log "removing $container; admin will re-spawn..."
  docker rm -f "$container" >/dev/null 2>&1 || true
  ok "$container removed — admin re-spawns with the new image"
}

cmd_upgrade_models() {
  if ! curl -fsS --max-time 3 http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
    die "native Ollama not responding"
  fi
  prevent_sleep
  # Capture curl + jq exit status separately so we can tell "no models" apart
  # from "API/jq failed" — those mean very different things to the user.
  local tags_json installed
  if ! tags_json="$(curl -fsS http://127.0.0.1:11434/api/tags 2>/dev/null)"; then
    die "couldn't read Ollama /api/tags — daemon up but request failed"
  fi
  if ! installed="$(echo "$tags_json" | jq -r '.models[]?.name' 2>/dev/null)"; then
    die "couldn't parse Ollama /api/tags response — got: ${tags_json:0:120}"
  fi
  [[ -z "$installed" ]] && { warn "no models installed — pull some first"; return 0; }
  log "upgrading installed models (re-pull = latest tag of same family):"
  local ok_count=0 fail_count=0 failed_models=()
  for m in $installed; do
    log "  $m"
    if ollama pull "$m"; then
      ok_count=$((ok_count+1))
    else
      fail_count=$((fail_count+1))
      failed_models+=("$m")
      warn "  refresh failed: $m"
    fi
  done
  if [[ "$fail_count" -eq 0 ]]; then
    ok "all $ok_count model(s) refreshed"
    return 0
  fi
  warn "$ok_count refreshed, $fail_count failed: ${failed_models[*]}"
  return 1
}

# ─── API-backed subcommands ───────────────────────────────────────────────────

# Generic escape hatch for any admin endpoint. Pretty-prints JSON via jq.
# Usage: nomad api /api/system/info
#        nomad api /api/system/services/install '{"service_name":"nomad_qdrant"}'
#        nomad api /api/downloads/jobs/zim
cmd_api() {
  api_check_up
  local path="${1:?usage: nomad api <PATH> [JSON_BODY]}"
  local body="${2:-}"
  local method="GET"
  [[ -n "$body" ]] && method="POST"
  local resp
  if [[ "$method" == "POST" ]]; then
    resp="$(api_post "$path" "$body")"
  else
    resp="$(api_get "$path")"
  fi
  if echo "$resp" | jq . >/dev/null 2>&1; then
    echo "$resp" | jq .
  else
    echo "$resp"
  fi
}

# List download jobs across all queues (downloads, embed, etc.).
# Subcommands: cancel, remove
cmd_downloads() {
  api_check_up
  local sub="${1:-list}"
  case "$sub" in
    list|"")
      local resp; resp="$(api_get /api/downloads/jobs)"
      if [[ -z "$resp" || "$resp" == "[]" || "$resp" == "{}" ]]; then
        ok "no download jobs in any state"; return 0
      fi
      # Pretty-print: state | filetype | url | progress | error
      echo "$resp" | jq -r '
        if type == "object" then
          (.active // []) + (.waiting // []) + (.delayed // []) + (.failed // []) + (.completed // [])
        else . end
        | .[] |
        [
          (.state // "?"),
          (.filetype // .data.filetype // "?"),
          (.data.url // .url // "?" | tostring | .[-60:]),
          (.progress.percent // .progress // 0 | tostring + "%"),
          ((.failedReason // "") | .[0:60])
        ] | @tsv
      ' 2>/dev/null | column -t -s $'\t' || echo "$resp" | jq .
      ;;
    cancel)
      local jid="${2:?usage: nomad downloads cancel JOBID}"
      api_post "/api/downloads/jobs/$jid/cancel" >/dev/null && ok "cancelled $jid"
      ;;
    remove)
      local jid="${2:?usage: nomad downloads remove JOBID}"
      api_delete "/api/downloads/jobs/$jid" >/dev/null && ok "removed $jid"
      ;;
    *)
      die "unknown subcommand: $sub
usage: nomad downloads [list|cancel JOBID|remove JOBID]" ;;
  esac
}

