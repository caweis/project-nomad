#!/usr/bin/env bash
# nomad — Project NOMAD installer + lifecycle CLI for macOS (Apple Silicon).
#
# Apache-2.0 — companion to upstream Project NOMAD (Crosstalk Solutions).
# Idempotent. Safe to re-run; that's also the repair path.
#
# Usage:
#   bash nomad install [--data-root PATH] [--tier auto|tiny|small|medium|large|xl|dreamy]
#                      [--models "names..."] [--no-models] [--yes]
#   bash nomad check   [system|stack|install|all]   # default: all (writes log)
#                                            # install = pre-flight inventory
#   bash nomad up
#   bash nomad down
#   bash nomad restart [SERVICE]             # default: admin
#   bash nomad logs    [SERVICE]             # default: admin
#   bash nomad models [list|pull [TIER|NAMES...]]
#                                            # tier: tiny→2GB, small→10, medium→26,
#                                            # large→65, xl→130, dreamy→215 (Studio)
#   bash nomad upgrade-models                # pull latest tags of installed
#   bash nomad downloads [list|cancel ID|remove ID]   # admin's job queue
#   bash nomad zim wikipedia [state|select VARIANT]   # Wikipedia download state
#   bash nomad zim [list|remote]
#   bash nomad stl [list|scan|import DIR [CAT]|path]  # Workshop STL library:
#                                            # list = admin's catalog;
#                                            # scan = rescan disk → index;
#                                            # import = copy files into the
#                                            # library + auto-rescan;
#                                            # path = print the library root
#   bash nomad services [list|install NAME|affect ACTION NAME]
#   bash nomad system [info|debug|internet]
#   bash nomad api PATH [JSON_BODY]          # raw admin API call (escape hatch)
#   bash nomad benchmark [run|patch-host]    # run = native vs Rosetta tokens/sec
#                                            # patch-host = inject real Apple chip into
#                                            # admin's latest benchmark row before Submit
#   bash nomad orbstack-tune [GB]            # bump OrbStack VM RAM (default: 80% of host)
#   bash nomad reset-ollama [--internal|--drive]
#                                            # recover Ollama; auto-detects a
#                                            # wedged data drive and falls back to
#                                            # internal models (auto-pulls a
#                                            # disk-gated, RAM-sized model set).
#                                            # --internal: force internal models.
#                                            # --drive: restore to the data drive
#                                            # (refused if still wedged).
#   bash nomad fix-kiwix                     # manual trigger of kiwix self-heal
#                                            # (LaunchAgent runs same logic every 60s)
#   bash nomad install-field-desk [--port N] [--foreground] [--force]
#                                            # SysAdminDoc Field Desk alongside
#                                            # admin (default :8081, shares
#                                            # Ollama on :11434, SHA-256 verified)
#   bash nomad uninstall-field-desk          # remove Field Desk (Ollama untouched)
#   bash nomad clean [--apply]               # safe cleanup: /tmp logs, dangling
#                                            # Docker images, builder cache, stopped
#                                            # admin-spawned containers, quarantined
#                                            # partial ZIMs. Dry-run unless --apply.
#   bash nomad uninstall                     # clean wipe (containers, agent, .env, opt. data)
#   bash nomad reinstall                     # nuclear: wipe everything + reinstall in one shot
#   bash nomad self-update                   # fetch latest nomad script (also runs
#                                            # implicitly at the start of install/reinstall)
#   bash nomad update                        # fetch latest bundle + reinstall
#                                            # in place (no data loss; see
#                                            # 'man nomad-update')
#
# Globals at the top, all logic in named functions, single dispatch at the bottom.

set -euo pipefail

# ─── constants ────────────────────────────────────────────────────────────────
# Resolve symlinks so HERE points at the real script location, not the symlink.
# When invoked via $(brew --prefix)/bin/nomad (a symlink), $0 is the symlink path —
# without this, COMPOSE_BASE ends up at /opt/homebrew/bin/compose.yaml (wrong).
_NOMAD_SCRIPT="$0"
while [[ -L "$_NOMAD_SCRIPT" ]]; do
  _link="$(readlink "$_NOMAD_SCRIPT")"
  if [[ "$_link" = /* ]]; then _NOMAD_SCRIPT="$_link"
  else _NOMAD_SCRIPT="$(dirname "$_NOMAD_SCRIPT")/$_link"; fi
done
HERE="$(cd "$(dirname "$_NOMAD_SCRIPT")" && pwd)"
COMPOSE_BASE="$HERE/compose.yaml"

# Bundle integrity check — fail loud and early if HERE somehow resolved wrong
# (stale or self-referential symlink, weird $0, etc). Without this, the script
# limps for ~50 lines and dies with "compose.yaml not found" buried in a step.
# Skip the check for help/usage so 'nomad help' still works from anywhere.
_NOMAD_FIRST_ARG="${1:-help}"
case "$_NOMAD_FIRST_ARG" in
  help|--help|-h) ;;
  *)
    if [[ ! -f "$COMPOSE_BASE" ]]; then
      printf '\n\033[0;31m✗ Bundle integrity check failed\033[0m\n\n' >&2
      printf '  compose.yaml not found at: %s\n' "$COMPOSE_BASE" >&2
      printf '  HERE resolved to:          %s\n' "$HERE" >&2
      printf '  invocation $0:             %s\n' "$0" >&2
      printf '  resolved script:           %s\n\n' "$_NOMAD_SCRIPT" >&2
      printf '  Most likely cause: stale or self-referential symlink at\n' >&2
      printf '  $(brew --prefix)/bin/nomad pointing at the wrong location.\n\n' >&2
      printf '  Recovery (one paste):\n' >&2
      printf '    rm -f "$(brew --prefix)/bin/nomad"\n' >&2
      printf '    cd ~/Applications/project-nomad\n' >&2
      printf '    git fetch && git reset --hard origin/main\n' >&2
      printf '    bash install/macos/nomad install\n\n' >&2
      exit 1
    fi
    ;;
esac
unset _NOMAD_FIRST_ARG

# Self-update: fetches the latest nomad script from the repo and re-execs.
# Runs ONLY for `install` / `reinstall` (gated below at the dispatch site).
# Skipped for `nomad check`, `nomad up`, `nomad upgrade kiwix`, etc. — those
# are quick commands where a 30s curl round-trip would be friction.
#
# Why this exists: the nomad CLI lives at $HERE/nomad on the user's Mac
# (typically ~/Developer/nomad-bundle-v2/nomad, symlinked from
# $(brew --prefix)/bin/nomad). When we ship a fix to the script itself —
# new quick-chat.sh template, new step in the install pipeline, new
# self-heal logic — the user's local copy is stale until they manually
# update it. This closes that gap: install/reinstall first refreshes
# the script, then runs the latest install steps.
#
# Safe-skip rules:
#   - NOMAD_NO_SELF_UPDATE=1 env var → skip (dev escape hatch)
#   - NOMAD_SKIP_SELF_UPDATE=1 env var → skip (set internally after re-exec)
#   - $HERE looks like a git working copy ($HERE/.git or $HERE/../.git exists) → skip
#   - Offline (api.github.com unreachable in 5s) → skip
#   - Fetched file fails sanity checks (shebang, bash -n) → skip
#   - Identical to current → no-op
#   - Can't write to target file → skip with a warning
self_update_nomad() {
  [[ -n "${NOMAD_NO_SELF_UPDATE:-}" ]] && return 0
  [[ -n "${NOMAD_SKIP_SELF_UPDATE:-}" ]] && return 0

  # Don't blow away an active git working copy (developer using a worktree)
  if [[ -d "$HERE/.git" || -d "$HERE/../.git" ]]; then
    return 0
  fi

  # Network check — fail fast when offline
  if ! /usr/bin/curl -fsS --max-time 5 https://api.github.com >/dev/null 2>&1; then
    return 0
  fi

  local branch="${NOMAD_BRANCH:-main}"
  local raw_url="https://raw.githubusercontent.com/caweis/project-nomad/$branch/install/macos/nomad"
  local tmp
  tmp="$(/usr/bin/mktemp)" || return 0

  log "self-update: checking $branch for a newer nomad script"
  if ! /usr/bin/curl -fsSL --max-time 30 "$raw_url" -o "$tmp"; then
    warn "self-update: couldn't fetch — continuing with current version"
    /bin/rm -f "$tmp"
    return 0
  fi

  # Sanity: must look like a bash script
  if ! /usr/bin/head -1 "$tmp" | /usr/bin/grep -q '^#!.*bash'; then
    warn "self-update: fetched file doesn't look like a bash script — skipping"
    /bin/rm -f "$tmp"
    return 0
  fi

  # Sanity: must pass syntax check
  if ! /bin/bash -n "$tmp" 2>/dev/null; then
    warn "self-update: fetched script has syntax errors — keeping current version"
    /bin/rm -f "$tmp"
    return 0
  fi

  # If identical, no-op (silent)
  if /usr/bin/cmp -s "$HERE/nomad" "$tmp"; then
    /bin/rm -f "$tmp"
    return 0
  fi

  # Atomic replace at the real bundle location (not the brew symlink)
  /bin/chmod +x "$tmp"
  if ! /bin/mv "$tmp" "$HERE/nomad" 2>/dev/null; then
    warn "self-update: couldn't write to $HERE/nomad — keeping current version"
    /bin/rm -f "$tmp"
    return 0
  fi
  ok "self-update: refreshed $HERE/nomad from $branch"
  log "self-update: re-execing with new script"
  export NOMAD_SKIP_SELF_UPDATE=1
  exec "$HERE/nomad" "${ORIGINAL_ARGS[@]}"
}

# Refresh compose.yaml from the repo. Same safe-skip rules as
# self_update_nomad. Called as a sibling step during self-update so the
# CLI script and compose.yaml stay in sync — many features land in both
# files together (e.g., the port-80 dual-binding from 1bea9ca which set
# the compose port mapping and added install-step assumptions to the
# CLI).
self_update_compose() {
  [[ -n "${NOMAD_NO_SELF_UPDATE:-}" ]] && return 0

  if [[ -d "$HERE/.git" || -d "$HERE/../.git" ]]; then
    return 0
  fi

  if ! /usr/bin/curl -fsS --max-time 5 https://api.github.com >/dev/null 2>&1; then
    return 0
  fi

  local branch="${NOMAD_BRANCH:-main}"
  local raw_url="https://raw.githubusercontent.com/caweis/project-nomad/$branch/install/macos/compose.yaml"
  local tmp
  tmp="$(/usr/bin/mktemp)" || return 0
  local target="$HERE/compose.yaml"

  if ! /usr/bin/curl -fsSL --max-time 30 "$raw_url" -o "$tmp"; then
    /bin/rm -f "$tmp"
    return 0
  fi

  # Sanity: must look like a docker-compose file
  if ! /usr/bin/head -5 "$tmp" | /usr/bin/grep -qE '^(name|services|version):'; then
    /bin/rm -f "$tmp"
    return 0
  fi

  # If identical, no-op (silent)
  if [[ -f "$target" ]] && /usr/bin/cmp -s "$target" "$tmp"; then
    /bin/rm -f "$tmp"
    return 0
  fi

  if ! /bin/mv "$tmp" "$target" 2>/dev/null; then
    warn "self-update: couldn't write to $target — keeping current version"
    /bin/rm -f "$tmp"
    return 0
  fi
  ok "self-update: refreshed $target from $branch (run 'nomad down && nomad up' to apply new port/env bindings)"
}

SECRETS_DIR="${SECRETS_DIR:-$HOME/.config/project-nomad}"
ENV_FILE="$SECRETS_DIR/.env"
# Forced-internal-models marker. Presence ⇒ Ollama uses ~/.ollama/models
# instead of the data-drive store. Set by `nomad reset-ollama --internal` or
# auto-fallback when the drive is wedged; cleared on restore. Honored by the
# generated ollama-launcher.sh at step 0 so KeepAlive respawns stay internal.
MARKER_FILE="$SECRETS_DIR/.force-internal-models"
# Hot state — always on internal disk, never on a detachable drive.
# MySQL + Redis bind-mount here so the data drive can be safely unplugged
# without killing the management plane.
NOMAD_STATE_ROOT_DEFAULT="$SECRETS_DIR/state"
LA_LABEL="com.projectnomad.ollama"
LA_PLIST="$HOME/Library/LaunchAgents/${LA_LABEL}.plist"
LA_TARGET="gui/$(id -u)"

# Second LaunchAgent: auto-patches admin's benchmark_results with this Mac's
# real Apple chip + Metal GPU, so the upstream leaderboard shows correct
# hardware instead of "-". Polls every 30s.
PATCHER_LABEL="com.projectnomad.benchmark-patcher"
PATCHER_PLIST="$HOME/Library/LaunchAgents/${PATCHER_LABEL}.plist"
PATCHER_SCRIPT="$SECRETS_DIR/benchmark-patcher.sh"

# Third LaunchAgent: kiwix self-heal. Admin's downloader writes ZIM files
# directly to /data/<name>.zim with no .tmp suffix, so partial downloads
# have valid filenames but invalid libzim headers. kiwix-serve's *.zim
# glob picks them up, fails to parse, exits, restart-loops. This polls
# every 60s; when kiwix is unhealthy, reads its log for the named bad
# file ("Unable to add the ZIM file 'X' to the internal library."),
# quarantines it to storage/zim-inprogress/, restarts kiwix. Idempotent.
KIWIX_SELF_HEAL_LABEL="com.projectnomad.kiwix-self-heal"
KIWIX_SELF_HEAL_PLIST="$HOME/Library/LaunchAgents/${KIWIX_SELF_HEAL_LABEL}.plist"
KIWIX_SELF_HEAL_SCRIPT="$SECRETS_DIR/kiwix-self-heal.sh"

# Fourth LaunchAgent: Bonjour service advertisement. Advertises the admin's
# HTTP endpoint on the local network via mDNS/Bonjour so other devices can
# discover NOMAD without typing a URL. Shows up in Safari's Bookmarks →
# Bonjour menu, the Edge / Chrome network discovery, and any app that
# listens for `_http._tcp` services. Runs `dns-sd -R` as a foreground
# process; launchd keeps it alive (it has no daemon-mode).
BONJOUR_LABEL="com.projectnomad.bonjour-advertise"
BONJOUR_PLIST="$HOME/Library/LaunchAgents/${BONJOUR_LABEL}.plist"

# Fifth LaunchAgent: host-command bridge. Admin (inside Docker) can't directly
# invoke host-side commands like `nomad upgrade ollama` (brew lives on the
# host, not in the container). This LaunchAgent polls a directory on the
# bind-mounted storage volume for request marker files; when admin's UI
# button writes one, the bridge runs the matching nomad command (from a
# strict allow-list) and writes a result file admin polls for status.
# Pattern matches the existing benchmark-patcher / kiwix-self-heal LAs but
# goes the opposite direction (admin → host instead of host → admin).
HOST_BRIDGE_LABEL="com.projectnomad.host-command-bridge"
HOST_BRIDGE_PLIST="$HOME/Library/LaunchAgents/${HOST_BRIDGE_LABEL}.plist"
HOST_BRIDGE_SCRIPT="$SECRETS_DIR/host-command-bridge.sh"

# Model tiers — auto-selected from RAM, override with --tier or --models.
# All names are confirmed-existing on ollama.com/library as of 2026.
# Note: Llama 3.2 only ships 1b/3b (text); the 8b size lives in Llama 3.1.
#
# Approx sizes (Q4 quantization) — stack these to estimate pull total:
#   llama3.2:3b ~2GB   gemma3:1b ~0.8GB   gemma3:4b ~3GB   llama3.1:8b ~5GB
#   qwen2.5:7b ~5GB   qwen2.5-coder:7b ~5GB   gemma3:12b ~8GB
#   qwen3:14b ~9GB   qwen2.5-coder:14b ~9GB   phi4:14b ~9GB
#   mistral-small:24b ~14GB   gemma3:27b ~17GB   qwen3:32b ~20GB
#   qwen2.5-coder:32b ~20GB   deepseek-r1:32b ~20GB   llama3.3:70b ~40GB
#   qwen2.5:72b ~41GB   deepseek-r1:70b ~40GB
#   nomic-embed-text ~0.3GB   mxbai-embed-large ~0.7GB

TIER_TINY="llama3.2:3b gemma3:1b nomic-embed-text"
TIER_SMALL="llama3.1:8b qwen2.5-coder:7b gemma3:4b nomic-embed-text"
TIER_MEDIUM="llama3.1:8b qwen3:14b qwen2.5-coder:14b gemma3:12b nomic-embed-text"
TIER_LARGE="llama3.1:8b qwen3:14b qwen2.5-coder:32b gemma3:27b mistral-small:24b nomic-embed-text"
TIER_XL="llama3.1:8b qwen3:32b qwen2.5-coder:32b llama3.3:70b deepseek-r1:32b gemma3:27b mistral-small:24b nomic-embed-text mxbai-embed-large"
TIER_DREAMY="llama3.1:8b qwen3:32b qwen2.5:72b qwen2.5-coder:32b llama3.3:70b deepseek-r1:32b deepseek-r1:70b mistral-small:24b gemma3:27b phi4:14b nomic-embed-text mxbai-embed-large"

# Approx pull-size estimate per tier (GB) — used only for the confirm prompt
tier_size_gb() {
  case "$1" in
    tiny)   echo 3   ;;
    small)  echo 13  ;;
    medium) echo 34  ;;
    large)  echo 65  ;;
    xl)     echo 147 ;;
    dreamy) echo 215 ;;
    *)      echo "?" ;;
  esac
}

# Auto-pick tier from system RAM (works on Intel + Apple Silicon).
# Tier ladder vs hardware:
#   <12 GB  → tiny    (M1/M2 Air base, low-RAM Macs)
#   <20 GB  → small   (16 GB MacBook Pro)
#   <40 GB  → medium  (24/32 GB MacBook Pro / mini M2 Pro)
#   <72 GB  → large   (Mac Studio M2 Max 64 GB)
#   <128 GB → xl      (Mac Studio M2 Ultra 96–128 GB)
#   ≥128 GB → dreamy  (Mac Studio M2/M3 Ultra 192/256/512 GB)
auto_tier() {
  local ram_gb
  ram_gb=$(( $(sysctl -n hw.memsize) / 1024 / 1024 / 1024 ))
  if   [[ $ram_gb -lt 12 ]];  then echo tiny
  elif [[ $ram_gb -lt 20 ]];  then echo small
  elif [[ $ram_gb -lt 40 ]];  then echo medium
  elif [[ $ram_gb -lt 72 ]];  then echo large
  elif [[ $ram_gb -lt 128 ]]; then echo xl
  else                             echo dreamy
  fi
}

# OS/arch detection with injectable test seams (NOMAD_TEST_OS / NOMAD_TEST_ARCH).
# _nomad_os_major echoes the macOS major version as an integer (e.g. 15).
_nomad_os_major() {
  local ver="${NOMAD_TEST_OS:-$(sw_vers -productVersion 2>/dev/null)}"
  echo "${ver%%.*}"
}

# _nomad_arch echoes the CPU arch (arm64 | x86_64).
_nomad_arch() {
  echo "${NOMAD_TEST_ARCH:-$(uname -m)}"
}

# oMLX needs Apple Silicon + macOS 15 (Sequoia). Returns 0 if eligible.
backend_eligible() {
  local arch major
  arch="$(_nomad_arch)"; major="$(_nomad_os_major)"
  [[ "$arch" == "arm64" && -n "$major" && "$major" -ge 15 ]]
}

# Hardware-recommended default backend: oMLX when eligible, else Ollama.
recommend_backend() {
  if backend_eligible; then echo omlx; else echo ollama; fi
}

# Resolve the active backend into the global BACKEND. Reads NOMAD_AI_BACKEND from
# the .env; anything other than a known backend falls back to ollama (covers old
# .env files and typos). ENV_FILE is defined globally near SECRETS_DIR.
_load_backend() {
  local v=""
  [[ -f "$ENV_FILE" ]] && v="$(grep '^NOMAD_AI_BACKEND=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"
  case "$v" in
    ollama|omlx) BACKEND="$v" ;;
    *)           BACKEND="ollama" ;;
  esac
}

# Precedence: explicit --backend flag (BACKEND_ARG) > hardware recommendation.
# Does NOT enforce eligibility here (the install gate does that, so an explicit
# --backend omlx on an ineligible Mac can produce a clear hard-stop message).
resolve_backend_choice() {
  if [[ -n "${BACKEND_ARG:-}" ]]; then echo "$BACKEND_ARG"; else recommend_backend; fi
}

# Resolve a tier name to its model list. "auto" = auto_tier.
resolve_tier_models() {
  local tier="${1:-auto}"
  [[ "$tier" == "auto" ]] && tier="$(auto_tier)"
  case "$tier" in
    tiny)   echo "$TIER_TINY"   ;;
    small)  echo "$TIER_SMALL"  ;;
    medium) echo "$TIER_MEDIUM" ;;
    large)  echo "$TIER_LARGE"  ;;
    xl)     echo "$TIER_XL"     ;;
    dreamy) echo "$TIER_DREAMY" ;;
    *) die "unknown tier: $tier (valid: auto|tiny|small|medium|large|xl|dreamy)" ;;
  esac
}

# Ports we rely on — system-check looks for collisions
NOMAD_PORTS="8080 9999 11434 3306 6379"

# ─── output helpers ───────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
  C_OK=$'\033[0;32m'; C_WARN=$'\033[0;33m'; C_ERR=$'\033[0;31m'
  C_HEAD=$'\033[1;36m'; C_DIM=$'\033[0;90m'; C_OFF=$'\033[0m'
else
  C_OK=''; C_WARN=''; C_ERR=''; C_HEAD=''; C_DIM=''; C_OFF=''
fi
log()     { printf "%s==>%s %s\n" "$C_HEAD" "$C_OFF" "$*"; }
ok()      { printf "%s ✓ %s%s\n"  "$C_OK"   "$*" "$C_OFF"; }
warn()    { printf "%s ⚠ %s%s\n"  "$C_WARN" "$*" "$C_OFF"; }
die()     { printf "%s ✗ %s%s\n"  "$C_ERR"  "$*" "$C_OFF" >&2; exit 1; }
section() { printf "\n%s── %s ──%s\n" "$C_HEAD" "$*" "$C_OFF"; }
dim()     { printf "%s%s%s\n" "$C_DIM" "$*" "$C_OFF"; }
flag()    { FINDINGS+=("$1|$2|$3"); }   # severity|title|recommendation

NOMAD_YES=0
confirm() {
  [[ "$NOMAD_YES" -eq 1 ]] && { echo "$1 [auto-yes]"; return 0; }
  read -r -p "$1 [y/N] " a; [[ "$a" =~ ^[Yy]$ ]]
}

# Non-fatal install degradations — install completed but a feature is missing.
# Steps that hit this push a one-line description; the final summary banner
# surfaces them so the green "complete" message doesn't hide real gaps.
NOMAD_INSTALL_DEGRADED=()

# ─── admin API client ─────────────────────────────────────────────────────────
# All admin routes are unauthenticated (single-user appliance design — see
# admin/start/kernel.ts). We hit them directly. jq required for parsing.
ADMIN_BASE="${NOMAD_ADMIN_URL:-http://localhost:8080}"

api_check_up() {
  curl -fsS --max-time 3 "$ADMIN_BASE/api/health" >/dev/null 2>&1 \
    || die "admin not reachable at $ADMIN_BASE — start the stack with 'nomad up' or check 'nomad check stack'"
}

api_get()    { curl -fsS --max-time 30 "$ADMIN_BASE$1"; }
api_delete() { curl -fsS --max-time 30 -X DELETE "$ADMIN_BASE$1"; }
api_post()   {
  local path="$1" body="${2:-}"
  if [[ -n "$body" ]]; then
    curl -fsS --max-time 30 -H 'Content-Type: application/json' -X POST -d "$body" "$ADMIN_BASE$path"
  else
    curl -fsS --max-time 30 -X POST "$ADMIN_BASE$path"
  fi
}
api_patch() {
  curl -fsS --max-time 30 -H 'Content-Type: application/json' -X PATCH -d "$2" "$ADMIN_BASE$1"
}

# ─── docker discovery + compose wrapper ───────────────────────────────────────
find_docker() {
  command -v docker >/dev/null 2>&1 && { command -v docker; return 0; }
  for d in /opt/homebrew/bin/docker /usr/local/bin/docker \
           "$HOME/.orbstack/bin/docker" \
           /Applications/OrbStack.app/Contents/MacOS/xbin/docker \
           /Applications/OrbStack.app/Contents/MacOS/bin/docker; do
    [[ -x "$d" ]] && { echo "$d"; return 0; }
  done
  return 1
}
ensure_docker_path() {
  local d; d="$(find_docker)" || return 1
  local dir; dir="$(dirname "$d")"
  case ":$PATH:" in *":$dir:"*) ;; *) export PATH="$dir:$PATH" ;; esac
}

# Same pattern for ollama — when nomad runs in a fresh shell that hasn't
# sourced brew shellenv yet, /opt/homebrew/bin isn't on PATH.
ensure_ollama_path() {
  command -v ollama >/dev/null 2>&1 && return 0
  for o in /opt/homebrew/bin/ollama /usr/local/bin/ollama; do
    if [[ -x "$o" ]]; then
      export PATH="$(dirname "$o"):$PATH"
      return 0
    fi
  done
  return 1
}

# Compose wrapper — base compose.yaml has platform: linux/amd64 baked in for
# the amd64-only GHCR images, so no override-layering needed.
dc() { docker compose -f "$COMPOSE_BASE" --env-file "$ENV_FILE" "$@"; }

# ─── sudo bootstrap ───────────────────────────────────────────────────────────
sudo_bootstrap() {
  [[ $EUID -eq 0 ]] && die "do NOT run with sudo. Run as your user; you'll be prompted once."
  sudo -n true 2>/dev/null && return 0
  log "admin rights needed once for Homebrew + Rosetta — prompting"
  sudo -v || die "sudo authentication failed"
  ( while true; do sudo -n true 2>/dev/null || exit 0; sleep 50; kill -0 $$ 2>/dev/null || exit 0; done ) &
  trap 'kill $! 2>/dev/null || true' EXIT INT TERM
}

# ─── sleep prevention ─────────────────────────────────────────────────────────
# A full install can run 30–90 minutes (model pulls of 80 GB+ on slower
# connections). If the Mac sleeps mid-stream, downloads stall, kiwix
# crash-loops, and the user comes back to a broken install. caffeinate
# blocks idle/disk/system sleep for as long as our shell PID is alive
# (-w $$); when the install exits, caffeinate exits with it. No-op if
# caffeinate isn't on PATH (rare — it's a macOS built-in).
prevent_sleep() {
  command -v caffeinate >/dev/null 2>&1 || return 0
  # Already running for this PID? Don't stack instances.
  pgrep -f "caffeinate.*-w $$" >/dev/null 2>&1 && return 0
  caffeinate -i -m -s -w $$ >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

# ─── system check ─────────────────────────────────────────────────────────────
FINDINGS=()
check_system() {
  section "System"

  # OS / arch
  local os ver arch
  os="$(uname)"; ver="$(sw_vers -productVersion 2>/dev/null)"; arch="$(uname -m)"
  [[ "$os" == "Darwin" ]] || { flag "🔴" "Not macOS ($os)" "This installer is macOS-only"; return 1; }
  ok "macOS $ver on $arch"
  if [[ "$arch" != "arm64" ]]; then
    warn "$arch — tuned for Apple Silicon; Intel Macs work but slower (no Metal)"
  fi

  # OS version >= 13
  local major; major="$(echo "$ver" | cut -d. -f1)"
  if [[ -n "$major" && "$major" -lt 13 ]]; then
    flag "🟡" "macOS $ver is older than 13" "OrbStack requires macOS 13+; consider updating"
  fi

  # RAM
  local ram_gb
  ram_gb=$(( $(sysctl -n hw.memsize) / 1024 / 1024 / 1024 ))
  if [[ "$ram_gb" -lt 8 ]]; then
    flag "🔴" "${ram_gb} GB RAM is below minimum" "Need 16+ GB for Ollama + container stack"
  elif [[ "$ram_gb" -lt 16 ]]; then
    flag "🟡" "${ram_gb} GB RAM is tight" "8B-param models will be slow; use --models llama3.2:3b"
  else
    ok "${ram_gb} GB RAM"
  fi

  # Boot disk (we don't install here, but warn if low)
  local boot_free_gb
  boot_free_gb="$(df -g / 2>/dev/null | awk 'NR==2{print $4}')"
  if [[ -n "$boot_free_gb" && "$boot_free_gb" -lt 10 ]]; then
    flag "🟡" "Only ${boot_free_gb} GB free on boot disk" "OrbStack VM caches some data on boot disk; free space is tight"
  fi

  # Rosetta on Apple Silicon
  if [[ "$arch" == "arm64" ]]; then
    if /usr/bin/arch -x86_64 /usr/bin/true >/dev/null 2>&1; then
      ok "Rosetta 2 ready"
    else
      warn "Rosetta 2 not installed (will install during 'nomad install')"
    fi
  fi

  # Port collisions
  for p in $NOMAD_PORTS; do
    if lsof -nP -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1; then
      local proc; proc="$(lsof -nP -iTCP:"$p" -sTCP:LISTEN | awk 'NR==2{print $1}')"
      flag "🟡" "Port $p in use by '$proc'" "NOMAD needs $p; stop the other service or it won't bind"
    fi
  done
  ok "checked ports: $NOMAD_PORTS"

  # Network reachability — 2xx/3xx/401/403 all mean "server reachable" (registries
  # legitimately return 401 to unauthenticated HEAD probes)
  for host in download.kiwix.org ghcr.io registry.ollama.ai; do
    local code
    code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 5 -I "https://$host" 2>/dev/null)"
    case "$code" in
      000)     flag "🟡" "$host unreachable" "Check network" ;;
      5*)      flag "🟡" "$host returned HTTP $code (server error)" "Try again later" ;;
      *)       ok "$host reachable (HTTP $code)" ;;
    esac
  done

  # Homebrew
  if command -v brew >/dev/null 2>&1; then
    ok "Homebrew $(brew --version | head -1 | awk '{print $2}')"
  else
    warn "Homebrew not installed (will install during 'nomad install')"
  fi
}

check_stack() {
  section "Stack"
  if ! ensure_docker_path; then
    flag "🔴" "Docker CLI not found" "Run: nomad install"
    return 0
  fi
  if ! docker version >/dev/null 2>&1; then
    flag "🔴" "Docker daemon not reachable" "Open OrbStack.app"
    return 0
  fi
  ok "docker $(docker version --format '{{.Server.Version}}')"

  if [[ ! -f "$ENV_FILE" ]]; then
    flag "🔴" ".env missing at $ENV_FILE" "Run: nomad install"
    return 0
  fi

  # Storage architecture — split state (internal, hot) vs data (configurable, cold)
  local state_root data_root
  state_root="$(grep '^NOMAD_STATE_ROOT=' "$ENV_FILE" 2>/dev/null | cut -d= -f2-)"
  data_root="$(grep '^NOMAD_DATA_ROOT=' "$ENV_FILE" 2>/dev/null | cut -d= -f2-)"
  # Mirror check_install's defensive fallback: an empty state_root from a
  # stale .env shouldn't report "(unset)" if the on-disk default exists.
  [[ -z "$state_root" ]] && state_root="$NOMAD_STATE_ROOT_DEFAULT"
  echo
  echo "  Storage architecture:"
  if [[ -n "$state_root" && -d "$state_root" ]]; then
    local sz; sz="$(du -sh "$state_root" 2>/dev/null | awk '{print $1}')"
    printf "    %s✓%s state (mysql/redis): %s   (%s used, internal)\n" "$C_OK" "$C_OFF" "$state_root" "$sz"
  else
    printf "    %s✗%s state root missing: %s\n" "$C_ERR" "$C_OFF" "${state_root:-(unset)}"
    flag "🔴" "NOMAD_STATE_ROOT missing or unset" "Run: nomad install (will recreate at $NOMAD_STATE_ROOT_DEFAULT)"
  fi
  if [[ -n "$data_root" && -d "$data_root" ]]; then
    local sz; sz="$(du -sh "$data_root" 2>/dev/null | awk '{print $1}')"
    local free; free="$(df -h "$data_root" 2>/dev/null | awk 'NR==2{print $4}')"
    local on_external="no"
    [[ "$data_root" == /Volumes/* ]] && on_external="yes — drive currently mounted"
    printf "    %s✓%s data (content): %s   (%s used, %s free, on external drive: %s)\n" \
      "$C_OK" "$C_OFF" "$data_root" "${sz:-?}" "${free:-?}" "$on_external"
  elif [[ -n "$data_root" ]]; then
    printf "    %s⚠%s data drive unplugged: %s\n" "$C_WARN" "$C_OFF" "$data_root"
    flag "🟡" "Data drive disconnected ($data_root)" "Replug the drive then 'nomad up' — admin keeps running, content services need it"
  fi
  echo

  for svc in admin mysql redis; do
    local state; state="$(dc ps --format '{{.State}}' "$svc" 2>/dev/null)"
    [[ "$state" != "running" ]] && flag "🔴" "$svc not running (state=${state:-missing})" "Run: nomad up"
  done

  # Native Ollama
  if curl -fsS --max-time 3 http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
    ok "native Ollama responding on :11434"
  else
    flag "🔴" "Native Ollama not responding" "Check ~/Library/Logs/nomad-ollama.err.log"
  fi

  # Admin's view of the world (via its own API — same auth-free routes the UI uses)
  if ! curl -fsS --max-time 3 "$ADMIN_BASE/api/health" >/dev/null 2>&1; then
    flag "🔴" "Admin API ($ADMIN_BASE) not responding" "Run: nomad logs admin"
    return 0
  fi
  ok "admin API responding"

  # Remote-Ollama wiring (via /api/ollama/remote-status)
  local rs; rs="$(api_get /api/ollama/remote-status 2>/dev/null)"
  local configured connected
  configured="$(echo "$rs" | jq -r '.configured' 2>/dev/null)"
  connected="$(echo "$rs"  | jq -r '.connected'  2>/dev/null)"
  if [[ "$configured" == "true" && "$connected" == "true" ]]; then
    ok "admin → native Ollama wired up (configured + connected)"
  elif [[ "$configured" == "true" ]]; then
    flag "🔴" "Remote Ollama configured but admin can't reach it" "Run: nomad install (re-runs configureRemote)"
  else
    flag "🔴" "Remote Ollama not configured in admin" "Run: nomad install (idempotent — runs configureRemote)"
  fi

  # Download jobs — failed jobs are usually what brings users to 'nomad check'
  local jobs failed_n active_n waiting_n
  jobs="$(api_get /api/downloads/jobs 2>/dev/null)"
  if [[ -n "$jobs" ]]; then
    failed_n="$(echo "$jobs"  | jq '(.failed  // []) | length' 2>/dev/null)"
    active_n="$(echo "$jobs"  | jq '(.active  // []) | length' 2>/dev/null)"
    waiting_n="$(echo "$jobs" | jq '(.waiting // []) | length' 2>/dev/null)"
    [[ -z "$failed_n"  || ! "$failed_n"  =~ ^[0-9]+$ ]] && failed_n=0
    [[ -z "$active_n"  || ! "$active_n"  =~ ^[0-9]+$ ]] && active_n=0
    [[ -z "$waiting_n" || ! "$waiting_n" =~ ^[0-9]+$ ]] && waiting_n=0
    if [[ "$failed_n" -gt 0 ]]; then
      flag "🟡" "$failed_n failed download(s)" "Run: nomad downloads list  (and: nomad downloads remove JOBID to clear)"
    fi
    if [[ "$waiting_n" -gt 0 && "$active_n" -eq 0 ]]; then
      flag "🟡" "$waiting_n waiting download(s) but 0 active" "Worker may be stuck — try: nomad restart admin"
    fi
    ok "downloads — active=$active_n waiting=$waiting_n failed=$failed_n"
  fi

  # Wikipedia state — Chris's frequent issue
  local wiki; wiki="$(api_get /api/zim/wikipedia 2>/dev/null)"
  if [[ -n "$wiki" ]]; then
    local selected status
    selected="$(echo "$wiki" | jq -r '.selectedOptionId // .selected_option_id // "(none)"' 2>/dev/null)"
    status="$(echo "$wiki"   | jq -r '.status // "?"' 2>/dev/null)"
    ok "Wikipedia — selected=$selected status=$status"
  fi
}

# Pre-flight install inventory — what's already in place, what's missing, what's
# broken. Run before 'nomad install' to see exactly what it would and wouldn't
# touch on a re-run. Read-only.
INV_SKIP=0
INV_INSTALL=0
INV_FIX=0
inv_ok()      { printf "  %s✓%s %-26s %s\n" "$C_OK"   "$C_OFF" "$1" "$2"; INV_SKIP=$((INV_SKIP+1)); }
inv_missing() { printf "  %s✗%s %-26s %s\n" "$C_ERR"  "$C_OFF" "$1" "$2"; INV_INSTALL=$((INV_INSTALL+1)); }
inv_broken()  { printf "  %s⚠%s %-26s %s\n" "$C_WARN" "$C_OFF" "$1" "$2"; INV_FIX=$((INV_FIX+1)); }

check_install() {
  section "Install Inventory"
  echo "  ✓ already installed (would skip)   ✗ missing (would install)   ⚠ broken (would fix)"
  echo

  # --- toolchain ---
  if /usr/bin/xcode-select -p >/dev/null 2>&1; then
    inv_ok "Xcode CLT" "at $(/usr/bin/xcode-select -p)"
  else
    inv_missing "Xcode CLT" "system install dialog"
  fi

  if command -v brew >/dev/null 2>&1; then
    inv_ok "Homebrew" "$(brew --version | head -1 | awk '{print $2}')"
  else
    inv_missing "Homebrew" "official curl-based installer"
  fi

  if command -v jq >/dev/null 2>&1; then
    inv_ok "jq" "$(jq --version)"
  else
    inv_missing "jq" "brew install jq"
  fi

  if [[ "$(uname -m)" == "arm64" ]]; then
    if /usr/bin/arch -x86_64 /usr/bin/true >/dev/null 2>&1; then
      inv_ok "Rosetta 2" "ready"
    else
      inv_missing "Rosetta 2" "softwareupdate --install-rosetta"
    fi
  fi

  # --- container runtime ---
  local orb_app=""
  for p in /Applications/OrbStack.app "$HOME/Applications/OrbStack.app"; do
    [[ -d "$p" ]] && orb_app="$p" && break
  done
  if [[ -n "$orb_app" ]]; then
    inv_ok "OrbStack" "at $orb_app"
  else
    inv_missing "OrbStack" "brew install --cask orbstack"
  fi

  if ensure_docker_path && docker version >/dev/null 2>&1; then
    inv_ok "Docker daemon" "$(docker version --format '{{.Server.Version}}')"
  elif command -v docker >/dev/null 2>&1; then
    inv_broken "Docker daemon" "CLI present but daemon unreachable — open OrbStack.app"
  else
    inv_missing "Docker daemon" "comes with OrbStack"
  fi

  # --- Ollama (binary, agent, port, API) ---
  if command -v ollama >/dev/null 2>&1; then
    inv_ok "Ollama binary" "$(ollama --version 2>&1 | head -1 | sed 's/^.*version //')"
  else
    inv_missing "Ollama binary" "brew install ollama"
  fi

  if [[ -f "$LA_PLIST" ]]; then
    if launchctl print "$LA_TARGET/$LA_LABEL" >/dev/null 2>&1; then
      local lstate; lstate="$(launchctl print "$LA_TARGET/$LA_LABEL" 2>/dev/null | awk -F' = ' '/^\tstate/{print $2;exit}' | tr -d ' ')"
      inv_ok "Ollama LaunchAgent" "loaded (state=${lstate:-?})"
    else
      inv_broken "Ollama LaunchAgent" "plist present but not loaded — nomad reset-ollama"
    fi
  else
    inv_missing "Ollama LaunchAgent" "would write $LA_PLIST"
  fi

  if curl -fsS --max-time 3 http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
    # Split capture from parse so a curl failure isn't reported as "0 models"
    # — that's how the API-down case used to render, indistinguishable from a
    # responsive API with no models installed.
    local tags_json n_models
    tags_json="$(curl -fsS --max-time 3 http://127.0.0.1:11434/api/tags 2>/dev/null)"
    if [[ -z "$tags_json" ]]; then
      inv_broken "Ollama API" "/api/tags reachable then transient-failed — investigate"
    else
      n_models="$(jq '.models | length' 2>/dev/null <<<"$tags_json")"
      if [[ -z "$n_models" || "$n_models" == "null" ]]; then
        inv_broken "Ollama API" "/api/tags returned unparseable JSON"
      else
        inv_ok "Ollama API" "responding on :11434, ${n_models} model(s)"
      fi
    fi
  else
    inv_missing "Ollama API" "needs LaunchAgent running"
  fi

  if lsof -nP -iTCP:11434 -sTCP:LISTEN >/dev/null 2>&1; then
    local bind; bind="$(lsof -nP -iTCP:11434 -sTCP:LISTEN | awk 'NR==2{print $9}')"
    if [[ "$bind" == *"127.0.0.1:11434"* ]]; then
      inv_broken "Ollama port binding" "$bind — containers can't reach via host.docker.internal"
    else
      inv_ok "Ollama port binding" "$bind"
    fi
  fi

  # --- NOMAD-specific state ---
  if [[ -f "$ENV_FILE" ]]; then
    local missing_keys=()
    local key
    for key in NOMAD_DATA_ROOT APP_KEY MYSQL_ROOT_PASSWORD DB_PASSWORD URL; do
      grep -qE "^${key}=.+" "$ENV_FILE" 2>/dev/null || missing_keys+=("$key")
    done
    if [[ ${#missing_keys[@]} -eq 0 ]]; then
      inv_ok ".env secrets" "all 5 keys present at $ENV_FILE"
    else
      inv_broken ".env secrets" "missing/empty: ${missing_keys[*]}"
    fi
  else
    inv_missing ".env secrets" "would generate APP_KEY + DB passwords"
  fi

  local data_root="" state_root=""
  if [[ -f "$ENV_FILE" ]]; then
    data_root="$(grep '^NOMAD_DATA_ROOT='  "$ENV_FILE" | cut -d= -f2- 2>/dev/null)"
    state_root="$(grep '^NOMAD_STATE_ROOT=' "$ENV_FILE" | cut -d= -f2- 2>/dev/null)"
  fi
  [[ -z "$state_root" ]] && state_root="$NOMAD_STATE_ROOT_DEFAULT"

  # State root (always-internal hot state)
  if [[ -d "$state_root" ]]; then
    local sz; sz="$(du -sh "$state_root" 2>/dev/null | awk '{print $1}')"
    inv_ok "State root (mysql/redis)" "$state_root (${sz:-?}, internal)"
  else
    inv_missing "State root (mysql/redis)" "would create at $state_root"
  fi

  # Data root (configurable, possibly external)
  if [[ -n "$data_root" && -d "$data_root" ]]; then
    local free sz
    free="$(df -h "$data_root" 2>/dev/null | awk 'NR==2{print $4}')"
    sz="$(du -sh "$data_root" 2>/dev/null | awk '{print $1}')"
    local where="internal"
    [[ "$data_root" == /Volumes/* ]] && where="external — currently mounted"
    inv_ok "Data root (content)" "$data_root (${sz:-?} used, ${free:-?} free, $where)"
  elif [[ -n "$data_root" ]]; then
    inv_broken "Data root (content)" "$data_root not mounted — drive unplugged"
  else
    inv_missing "Data root (content)" "would prompt to pick disk"
  fi

  if ensure_docker_path && docker version >/dev/null 2>&1; then
    local needed=("ghcr.io/crosstalk-solutions/project-nomad:latest" \
                  "ghcr.io/crosstalk-solutions/project-nomad-sidecar-updater:latest" \
                  "amir20/dozzle:v10.0" "mysql:8.0" "redis:7-alpine")
    local cached=0 img
    for img in "${needed[@]}"; do
      docker image inspect "$img" >/dev/null 2>&1 && cached=$((cached+1))
    done
    if [[ "$cached" -eq ${#needed[@]} ]]; then
      inv_ok "Compose images" "all ${#needed[@]} cached locally"
    elif [[ "$cached" -gt 0 ]]; then
      inv_broken "Compose images" "$cached of ${#needed[@]} cached — would pull missing"
    else
      inv_missing "Compose images" "would pull all ${#needed[@]}"
    fi

    local running; running="$(docker ps --filter 'name=^nomad_' --format '{{.Names}}' 2>/dev/null | wc -l | tr -d ' ')"
    if [[ "$running" -ge 5 ]]; then
      inv_ok "NOMAD containers" "$running running"
    elif [[ "$running" -gt 0 ]]; then
      inv_broken "NOMAD containers" "$running running — would docker compose up -d"
    else
      inv_missing "NOMAD containers" "would start admin/mysql/redis/dozzle/updater"
    fi
  fi

  if curl -fsS --max-time 3 http://localhost:8080/api/health >/dev/null 2>&1; then
    inv_ok "Admin API" "responding on :8080"
    local rs cfg conn
    rs="$(curl -fsS --max-time 3 http://localhost:8080/api/ollama/remote-status 2>/dev/null)"
    cfg="$(echo "$rs" | jq -r '.configured' 2>/dev/null)"
    conn="$(echo "$rs" | jq -r '.connected'  2>/dev/null)"
    if [[ "$cfg" == "true" && "$conn" == "true" ]]; then
      inv_ok "Admin → Ollama wiring" "configured + connected"
    elif [[ "$cfg" == "true" ]]; then
      inv_broken "Admin → Ollama wiring" "configured but admin can't reach Ollama"
    else
      inv_missing "Admin → Ollama wiring" "run 'nomad install' (seeds via SQL)"
    fi
  else
    inv_missing "Admin API" "needs containers running"
  fi

  # Plan summary
  echo
  printf "%s── plan if you run 'nomad install' now ──%s\n" "$C_HEAD" "$C_OFF"
  printf "  ${C_OK}skip${C_OFF}     %2d components already in place\n" "$INV_SKIP"
  printf "  ${C_ERR}install${C_OFF}  %2d missing components\n"          "$INV_INSTALL"
  printf "  ${C_WARN}fix${C_OFF}      %2d broken components\n"          "$INV_FIX"
  echo
  if [[ $((INV_INSTALL + INV_FIX)) -eq 0 ]]; then
    ok "Everything in place — 'nomad install' would be a no-op."
  elif [[ "$INV_INSTALL" -eq 0 ]]; then
    log "all components present; 'nomad install' would only fix the broken ones."
  else
    log "'nomad install' would install $INV_INSTALL and fix $INV_FIX, skipping $INV_SKIP."
  fi
}

print_findings() {
  if [[ ${#FINDINGS[@]} -eq 0 ]]; then
    ok "no issues detected"; return 0
  fi
  printf "\n%s── findings ──%s\n" "$C_HEAD" "$C_OFF"
  for f in "${FINDINGS[@]}"; do
    IFS='|' read -r sev title rec <<<"$f"
    printf "%s %s\n   %s→ %s%s\n" "$sev" "$title" "$C_DIM" "$rec" "$C_OFF"
  done
}

cmd_check() {
  local what="${1:-all}"
  # Tee output to a log file for iCloud sync
  local ts log_path latest_path
  ts="$(date +%Y%m%d-%H%M%S)"
  log_path="$HERE/nomad-check-${ts}.log"
  latest_path="$HERE/nomad-check-latest.log"
  exec > >(tee \
    >(sed -E 's/\x1B\[[0-9;]*[a-zA-Z]//g' > "$log_path") \
    >(sed -E 's/\x1B\[[0-9;]*[a-zA-Z]//g' > "$latest_path")) 2>&1

  printf "%s── nomad check (%s) — %s ──%s\n" "$C_HEAD" "$what" "$(date '+%Y-%m-%d %H:%M:%S')" "$C_OFF"
  printf "%s   log: %s%s\n" "$C_HEAD" "$log_path" "$C_OFF"
  case "$what" in
    system)    check_system ;;
    stack)     check_stack ;;
    install|inventory) check_install ;;
    all|*)     check_system; check_stack; check_install ;;
  esac
  print_findings
  echo
  dim "logs: $latest_path  (also $log_path)"
}

# ─── install steps ────────────────────────────────────────────────────────────
step_deps() {
  section "Dependencies"

  # Xcode CLT
  if ! /usr/bin/xcode-select -p >/dev/null 2>&1; then
    log "installing Xcode Command Line Tools (system dialog will appear)"
    /usr/bin/xcode-select --install 2>/dev/null || true
    log "waiting for CLT install (5–20 min)..."
    while ! /usr/bin/xcode-select -p >/dev/null 2>&1; do sleep 10; printf "."; done
    echo; ok "Xcode CLT installed"
  else
    ok "Xcode CLT present"
  fi

  # Homebrew
  if ! command -v brew >/dev/null 2>&1; then
    log "installing Homebrew"
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    [[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
    [[ -x /usr/local/bin/brew   ]] && eval "$(/usr/local/bin/brew shellenv)"
    command -v brew >/dev/null 2>&1 || die "Homebrew install failed"
  fi
  ok "Homebrew $(brew --version | head -1 | awk '{print $2}')"

  # Persist brew on PATH for future zsh sessions. Homebrew's installer
  # prints "Next steps" telling the user to add `eval "$(brew shellenv)"`
  # to ~/.zprofile manually; we do it for them so the `nomad` symlink
  # installed at step_self_install_to_path is discoverable in any new
  # terminal without the user having to source brew shellenv first.
  # Caught when a fresh MacBook Air install left `nomad: command not
  # found` after install — brew was installed, symlink was created, but
  # /opt/homebrew/bin wasn't on the interactive shell's PATH.
  local brew_bin=""
  [[ -x /opt/homebrew/bin/brew ]] && brew_bin="/opt/homebrew/bin/brew"
  [[ -z "$brew_bin" && -x /usr/local/bin/brew ]] && brew_bin="/usr/local/bin/brew"
  if [[ -n "$brew_bin" ]]; then
    local zprofile="$HOME/.zprofile"
    if ! grep -q 'brew shellenv' "$zprofile" 2>/dev/null \
       && ! grep -q 'brew shellenv' "$HOME/.zshrc" 2>/dev/null; then
      printf '\n# Added by NOMAD installer — keep brew binaries on PATH for new shells\neval "$(%s shellenv)"\n' "$brew_bin" >> "$zprofile"
      ok "added brew shellenv to ~/.zprofile (new terminals will find nomad)"
    fi
  fi

  brew update --quiet || warn "brew update hiccup — continuing"

  # jq
  command -v jq >/dev/null 2>&1 || brew install jq
  ok "jq $(jq --version)"

  # Rosetta on Apple Silicon
  if [[ "$(uname -m)" == "arm64" ]]; then
    if /usr/bin/arch -x86_64 /usr/bin/true >/dev/null 2>&1; then
      ok "Rosetta 2 ready"
    else
      log "installing Rosetta 2"
      sudo softwareupdate --install-rosetta --agree-to-license || warn "Rosetta install reported error — OrbStack may install on first amd64 pull"
    fi
  fi
}

# Returns the chosen DATA_ROOT on stdout
DATA_ROOT_RESOLVED=""
step_data_root() {
  section "Data root"
  local picked="$1"

  if [[ -z "$picked" ]]; then
    echo "Where should NOMAD store its data?"
    echo "  [0] Internal disk: $HOME/project-nomad-data  (default — works without external drive)"
    local cands=("INTERNAL")
    local i=1
    for v in /Volumes/*; do
      [[ -d "$v" ]] || continue
      local name; name="$(basename "$v")"
      [[ "$name" == "Macintosh HD" || "$name" == "Macintosh HD - Data" || "$name" == "Recovery" ]] && continue
      if ! touch "$v/.nomad-write-test" 2>/dev/null; then
        continue
      fi
      rm -f "$v/.nomad-write-test"
      local fs free
      fs="$(diskutil info "$v" 2>/dev/null | awk -F': *' '/Type \(Bundle\)/{print $2}' | xargs)"
      free="$(df -h "$v" 2>/dev/null | awk 'NR==2{print $4}')"
      printf "  [%d] External: %s  (fs=%s, free=%s)\n" "$i" "$v" "${fs:-?}" "${free:-?}"
      cands+=("$v"); i=$((i+1))
    done
    echo
    read -r -p "Pick a number [0=internal default], or paste a full path: " sel
    sel="${sel:-0}"
    if [[ "$sel" =~ ^[0-9]+$ ]]; then
      local idx="$sel"
      if [[ $idx -eq 0 ]]; then
        picked="$HOME/project-nomad-data"
      else
        [[ $idx -ge 1 && $idx -lt ${#cands[@]} ]] || die "out of range"
        picked="${cands[$idx]}/project-nomad"
      fi
    else
      picked="$sel"
    fi
  fi

  # Strict path resolution — no boot-drive fallthrough
  local parent; parent="$(dirname "$picked")"
  [[ -d "$parent" ]] || die "parent dir does not exist: $parent
Make sure your external drive is mounted, or pick another path."
  local parent_abs; parent_abs="$(cd "$parent" && pwd)"
  picked="$parent_abs/$(basename "$picked")"
  echo "Data root: $picked"

  # Filesystem (MySQL won't tolerate exFAT)
  local volume fs
  volume="$(df "$parent_abs" | awk 'NR==2{print $NF}')"
  fs="$(diskutil info "$volume" 2>/dev/null | awk -F': *' '/Type \(Bundle\)/{print $2}' | xargs)"
  case "$fs" in
    apfs|APFS) ok "$volume is APFS" ;;
    hfs+|HFS+|jhfs+|hfs|HFS) warn "$volume is $fs — APFS preferred" ;;
    exfat|*FAT*|msdos) die "$volume is $fs — MySQL requires APFS or HFS+. Reformat in Disk Utility." ;;
    *) warn "could not detect filesystem ($fs) — proceeding" ;;
  esac

  # Boot-drive guard
  local boot_vol; boot_vol="$(df / | awk 'NR==2{print $NF}')"
  if [[ "$volume" == "$boot_vol" ]]; then
    warn "$picked is on the BOOT volume — content can be 100s of GB"
    confirm "Install on boot drive?" || die "aborted — pick an external drive"
  fi

  # Disk space
  local free_gb; free_gb="$(df -g "$parent_abs" 2>/dev/null | awk 'NR==2{print $4}')"
  if [[ -n "$free_gb" && "$free_gb" =~ ^[0-9]+$ && "$free_gb" -lt 50 ]]; then
    warn "${free_gb} GB free — full English Wikipedia (96 GB) won't fit"
  fi

  # mysql + redis NO LONGER live here — they're on the internal state root.
  # Only content (Wikipedia, models, maps, etc.) goes on the data drive so
  # the drive can be safely unplugged without crashing the management plane.
  #
  # storage/logs MUST exist before admin starts — Pino's ThreadStream opens
  # /app/storage/logs/admin.log eagerly on boot and crash-loops the container
  # if the host-mounted parent dir is missing. (Hit on a fresh-drive install
  # 2026-05-10 — admin restart-looped 11 times with ENOENT before we caught it.)
  # storage/zim-inprogress is created by the kiwix-self-heal LaunchAgent at
  # runtime, but pre-creating costs nothing and makes the layout discoverable
  # before any quarantine has happened.
  mkdir -p "$picked"/{storage,storage/logs,storage/zim-inprogress,ollama-models}

  # Workshop's STL library lives at storage/stl-library/<category>/. The admin
  # Workshop page reports "data drive holding the STL library is not mounted"
  # when /app/storage/stl-library is missing — pre-creating the 7 canonical
  # category dirs (from admin/types/stl_library.ts STL_CATEGORIES) makes the
  # Workshop page show an empty-but-functional library out of the box instead
  # of a scary "unavailable" banner. Caught on Chris's 2026-05-11 install
  # where Workshop showed unavailable despite the drive being mounted.
  mkdir -p \
    "$picked"/storage/stl-library/medical \
    "$picked"/storage/stl-library/tools \
    "$picked"/storage/stl-library/household \
    "$picked"/storage/stl-library/replacement-parts \
    "$picked"/storage/stl-library/agriculture \
    "$picked"/storage/stl-library/firearm-accessories \
    "$picked"/storage/stl-library/other

  # Drop the portable HTML chat UI on the drive (alongside quick-chat.sh).
  # The shell script launches Ollama, then opens this page in the default browser.
  if [[ -f "$HERE/quick-chat.html" ]]; then
    cp "$HERE/quick-chat.html" "$picked/quick-chat.html"
    ok "quick-chat.html deployed to $picked/quick-chat.html  (browser UI)"
  else
    warn "quick-chat.html not found in bundle ($HERE) — drive will get only the shell version"
  fi

  # Drop a portable quick-chat script ON the drive — when this drive is plugged
  # into any other Mac, the user can run /Volumes/<drive>/project-nomad/quick-chat.sh
  # and immediately have ollama-as-a-server with all the cached models. No NOMAD
  # install needed on the second Mac, no Docker, no admin — just the LLM chat layer.
  cat > "$picked/quick-chat.sh" <<'QUICK_CHAT_EOF'
#!/usr/bin/env bash
# quick-chat.sh — portable Ollama bootstrapper for the NOMAD data drive.
# Lives on the drive so it travels with it. Run on ANY Mac:
#   bash /Volumes/<drive>/project-nomad/quick-chat.sh
# Result: native Ollama running, all the drive's cached models available, ready to chat.
#
# Does NOT install NOMAD. Just gets you LLM chat using the models on this drive.
# For the full NOMAD experience (admin UI / Wikipedia / RAG), install the bundle.

set -euo pipefail

C_OK=$'\033[0;32m'; C_WARN=$'\033[0;33m'; C_ERR=$'\033[0;31m'; C_HEAD=$'\033[1;36m'; C_OFF=$'\033[0m'
log()  { printf "%s==>%s %s\n"  "$C_HEAD" "$C_OFF" "$*"; }
ok()   { printf "%s ✓ %s%s\n"   "$C_OK"   "$*" "$C_OFF"; }
warn() { printf "%s ⚠ %s%s\n"   "$C_WARN" "$*" "$C_OFF"; }
die()  { printf "%s ✗ %s%s\n"   "$C_ERR"  "$*" "$C_OFF" >&2; exit 1; }

[[ "$(uname)" == "Darwin" ]] || die "macOS only — this is a Mac LLM bootstrapper"

DRIVE_ROOT="$(cd "$(dirname "$0")" && pwd)"
MODELS_DIR="$DRIVE_ROOT/ollama-models"
[[ -d "$MODELS_DIR" ]] || die "no ollama-models/ at $MODELS_DIR — is this the NOMAD data drive?"

log "Project NOMAD — quick-chat (portable LLM mode)"
echo "  drive:    $DRIVE_ROOT"
echo "  models:   $MODELS_DIR"
echo

# 1. Ensure ollama is installed (and Homebrew, if needed, with consent)
if ! command -v ollama >/dev/null 2>&1; then
  # Pick up ollama from its canonical install locations even if not on PATH
  for o in /opt/homebrew/bin/ollama /usr/local/bin/ollama; do
    [[ -x "$o" ]] && export PATH="$(dirname "$o"):$PATH" && break
  done
fi
if ! command -v ollama >/dev/null 2>&1; then
  # Pick up brew from its canonical install locations even if not on PATH
  if ! command -v brew >/dev/null 2>&1; then
    for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
      [[ -x "$b" ]] && eval "$("$b" shellenv)" && break
    done
  fi
  # If brew still isn't present, offer to install it. Homebrew modifies
  # /opt/homebrew (Apple Silicon) or /usr/local (Intel) and asks for sudo
  # once — meaningful change, so we prompt instead of auto-installing.
  if ! command -v brew >/dev/null 2>&1; then
    warn "Ollama isn't installed on this Mac, and Homebrew isn't either."
    warn "Ollama installs via Homebrew, so we need Homebrew first."
    echo
    echo "  Homebrew (https://brew.sh) is the standard macOS package manager."
    echo "  Installing it modifies /opt/homebrew (Apple Silicon) or /usr/local"
    echo "  (Intel) and asks for your sudo password once. After Homebrew"
    echo "  finishes, this script continues into the Ollama install."
    echo
    printf "Install Homebrew now? [y/N] "
    read -r answer
    case "$answer" in
      [yY]|[yY][eE][sS])
        log "installing Homebrew — sudo prompt incoming, takes a few minutes"
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        # Re-source shellenv so brew is on PATH for the rest of this script
        for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
          [[ -x "$b" ]] && eval "$("$b" shellenv)" && break
        done
        command -v brew >/dev/null 2>&1 || die "Homebrew install didn't complete. See output above for the cause."
        ok "Homebrew installed"
        ;;
      *)
        die "Declined. To install Ollama manually:
  /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\"
  brew install ollama
Then re-run this script."
        ;;
    esac
  fi
  log "installing ollama via Homebrew"
  brew install ollama
fi
ok "ollama $(ollama --version 2>&1 | head -1)"

# 2. If a NOMAD LaunchAgent is already running on this Mac, just use it.
if curl -fsS --max-time 2 http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
  ok "ollama already serving on :11434 — using it"
else
  # Check if :11434 is squatted by something else
  if lsof -nP -iTCP:11434 -sTCP:LISTEN >/dev/null 2>&1; then
    warn ":11434 is in use but not responding. Stop the existing service first:"
    lsof -nP -iTCP:11434 -sTCP:LISTEN | head -3
    die "free :11434 then retry"
  fi
  log "starting ollama serve (Ctrl-C to stop the daemon when done)"
  log "models load lazily from the drive — first chat with each model is slower"
  echo
  export OLLAMA_MODELS="$MODELS_DIR"
  export OLLAMA_HOST="127.0.0.1:11434"
  export OLLAMA_KEEP_ALIVE="30m"
  export OLLAMA_FLASH_ATTENTION="1"
  export OLLAMA_KV_CACHE_TYPE="q8_0"
  # Allow browser pages (file:// or any local origin) to hit the API
  export OLLAMA_ORIGINS="*"
  ollama serve &
  OLLAMA_PID=$!
  trap 'kill $OLLAMA_PID 2>/dev/null || true' EXIT INT TERM

  # Wait for API
  for i in $(seq 1 15); do
    curl -fsS http://127.0.0.1:11434/api/tags >/dev/null 2>&1 && break
    sleep 1
  done
  ok "ollama serving on http://127.0.0.1:11434"
fi

# 3. List models
echo
log "models on this drive:"
OLLAMA_MODELS="$MODELS_DIR" ollama list 2>/dev/null | tail -n +1

# 4. Open the browser chat UI (preferred) — falls back to terminal chat if HTML missing
echo
HTML_UI="$DRIVE_ROOT/quick-chat.html"
if [[ -f "$HTML_UI" && -z "${1:-}" ]]; then
  log "opening browser chat: $HTML_UI"
  open "$HTML_UI"
  echo
  echo "  Browser tab is now talking to Ollama on http://127.0.0.1:11434"
  echo "  When you're done, return to this terminal and Ctrl-C to stop ollama serve."
  echo
  # Keep the daemon alive in the foreground until user quits
  wait "$OLLAMA_PID" 2>/dev/null
else
  # Terminal fallback — pass a model name as $1 to skip browser
  DEFAULT_MODEL="${1:-}"
  if [[ -z "$DEFAULT_MODEL" ]]; then
    # Filter embedding models (no chat support) — pick smallest chat model
    DEFAULT_MODEL="$(OLLAMA_MODELS="$MODELS_DIR" ollama list 2>/dev/null \
      | awk 'NR>1 {print $1, $3}' \
      | grep -viE '(embed|bge-)' \
      | sort -k2 -h \
      | head -1 \
      | awk '{print $1}')"
  fi
  if [[ -n "$DEFAULT_MODEL" ]]; then
    log "starting terminal chat with $DEFAULT_MODEL  (Ctrl-D or /bye to exit)"
    echo
    OLLAMA_MODELS="$MODELS_DIR" ollama run "$DEFAULT_MODEL"
  else
    warn "no models found on the drive at $MODELS_DIR"
    warn "to pull one: ollama pull llama3.2:3b"
  fi
fi
QUICK_CHAT_EOF
  chmod +x "$picked/quick-chat.sh"
  ok "quick-chat.sh deployed to $picked/quick-chat.sh  (portable across Macs)"

  # Mirror the install/macos/ bundle to the drive so that plugging this
  # drive into ANY other Apple Silicon Mac is enough to bootstrap a full
  # NOMAD install on that Mac — no need to download the bundle from
  # GitHub first. quick-chat.sh handles the LLM-chat-only path; this is
  # the full-install path.
  local bundle_dst="$picked/install-bundle"
  rm -rf "$bundle_dst"
  mkdir -p "$bundle_dst"
  # cp -R "$HERE/." copies the CONTENTS of HERE, not HERE itself.
  # Exclude obvious junk that would only confuse a future install.
  cp -R "$HERE/." "$bundle_dst/" 2>/dev/null || cp -R "$HERE/" "$bundle_dst/"
  rm -f "$bundle_dst"/*.bak "$bundle_dst"/*-latest.log "$bundle_dst"/nomad-check-*.log 2>/dev/null || true
  chmod +x "$bundle_dst/nomad" 2>/dev/null || true
  ok "install bundle mirrored to $bundle_dst  (offline-bootstrap on any other Mac)"

  # Drop the bootstrap entry-point at the drive's nomad root so a user
  # plugging the drive into a fresh Mac sees one obvious thing to
  # double-click. The script self-detects existing installs and either
  # opens admin in browser, runs check, or kicks off a fresh install
  # from the bundle next to it.
  cat > "$picked/install-nomad.command" <<INSTALL_NOMAD_EOF
#!/usr/bin/env bash
# install-nomad.command — Project NOMAD bootstrap from the data drive.
#
# Double-click this from any Apple Silicon Mac that has the NOMAD data
# drive plugged in. The script:
#   1. Detects whether NOMAD is already installed on this Mac
#   2. If yes: shows status + offers to open admin or run \`nomad check\`
#   3. If no: confirms with the user, then runs the installer from
#      the bundle on this drive — no internet fetch required for the
#      install code itself (Homebrew/Ollama/Docker still need network
#      for first-time downloads)
#
# Logs to install-nomad-<timestamp>.log next to this file for any
# post-mortem reading you might want later.

set -uo pipefail

HERE="\$( cd "\$(dirname "\$0")" && pwd -P )"
LOG="\$HERE/install-nomad-\$(date +%Y%m%d-%H%M%S).log"
exec > >(tee -a "\$LOG") 2>&1

cat <<BANNER
═══════════════════════════════════════════════════════════
  Project NOMAD — drive bootstrap
  \$(date)
  log: \$LOG
═══════════════════════════════════════════════════════════
BANNER

# Detect existing install (CLI symlink + active .env)
NOMAD_BIN=""
NOMAD_ENV=""
if command -v nomad >/dev/null 2>&1; then
  NOMAD_BIN="\$(command -v nomad)"
fi
if [[ -f "\$HOME/.config/project-nomad/.env" ]]; then
  NOMAD_ENV="\$HOME/.config/project-nomad/.env"
fi

if [[ -n "\$NOMAD_BIN" && -n "\$NOMAD_ENV" ]]; then
  echo "NOMAD is already installed on this Mac:"
  echo "  CLI:   \$NOMAD_BIN"
  echo "  .env:  \$NOMAD_ENV"
  echo
  echo "What would you like to do?"
  echo "  [1] Open admin in browser (http://localhost:8080)"
  echo "  [2] Run 'nomad check' to diagnose"
  echo "  [3] Reinstall from this drive's bundle"
  echo "  [Q] Quit"
  echo
  read -r -p "Choice [1]: " choice
  case "\${choice:-1}" in
    1)
      /usr/bin/open "http://localhost:8080"
      ;;
    2)
      "\$NOMAD_BIN" check
      ;;
    3)
      echo
      echo "Running fresh install from this drive's bundle..."
      bash "\$HERE/install-bundle/nomad" install
      ;;
    *)
      echo "Bye."
      ;;
  esac
  exit 0
fi

# Not installed — confirm + run
echo "NOMAD is not installed on this Mac."
echo
echo "This will install:"
echo "  • Homebrew (if missing), Xcode CLT, Rosetta 2"
echo "  • OrbStack (Docker for macOS)"
echo "  • Native Ollama via Homebrew (Metal-accelerated chat)"
echo "  • The Project NOMAD container stack"
echo "  • Background LaunchAgents (kiwix self-heal, benchmark patcher)"
echo
echo "When the installer asks where to store data, pick this drive."
echo "(It's offered as option [1] External in the prompt.)"
echo
read -r -p "Proceed with install? [y/N] " yn
if [[ ! "\$yn" =~ ^[Yy]\$ ]]; then
  echo "Aborted — nothing touched."
  exit 0
fi

# Run the installer from the bundle next to this script. Falls back to
# GitHub if the bundle is missing (drive was set up by an older NOMAD
# version that didn't ship the bundle, or someone deleted it).
if [[ -x "\$HERE/install-bundle/nomad" ]]; then
  bash "\$HERE/install-bundle/nomad" install
else
  echo "install-bundle missing from this drive — fetching from GitHub instead..."
  mkdir -p "\$HOME/Developer"
  cd "\$HOME/Developer"
  # GitHub serves the tarball with the CURRENT repo name as the top-level
  # dir. The repo was renamed to caweis/project-nomad, so the extracted dir
  # is project-nomad-main/ (repo name + branch with
  # slashes turned to dashes). Confirmed 2026-05-11 with \`tar tzf | head -1\`.
  # Verify with that command after any repo rename.
  curl -fsSL https://github.com/caweis/project-nomad/archive/refs/heads/main.tar.gz | tar xz
  bash project-nomad-main/install/macos/nomad install
fi
INSTALL_NOMAD_EOF
  chmod +x "$picked/install-nomad.command"
  ok "install-nomad.command deployed to $picked/install-nomad.command  (double-click to bootstrap a new Mac)"

  DATA_ROOT_RESOLVED="$picked"
  ok "data tree ready under $picked  (storage + ollama-models + quick-chat.sh + install-bundle + install-nomad.command)"
}

step_orbstack() {
  section "OrbStack"
  local app=""
  for p in /Applications/OrbStack.app "$HOME/Applications/OrbStack.app"; do
    [[ -d "$p" ]] && app="$p" && break
  done
  if [[ -z "$app" ]]; then
    log "installing OrbStack via brew cask"
    brew install --cask orbstack
    [[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
    for p in /Applications/OrbStack.app "$HOME/Applications/OrbStack.app"; do
      [[ -d "$p" ]] && app="$p" && break
    done
    [[ -n "$app" ]] || die "OrbStack.app not found after brew install"
  fi
  ok "OrbStack at $app"

  /usr/bin/pgrep -x OrbStack >/dev/null 2>&1 || { log "launching OrbStack — accept any prompts"; open -a OrbStack; }

  log "waiting up to 3 min for docker daemon..."
  local deadline=$(( $(date +%s) + 180 ))
  while [[ $(date +%s) -lt $deadline ]]; do
    if ensure_docker_path && docker version >/dev/null 2>&1; then
      ok "docker daemon up: $(docker version --format '{{.Server.Version}}')"
      return 0
    fi
    sleep 2; printf "."
  done
  echo
  die "docker daemon never came up. Open OrbStack.app, finish first-run, re-run 'nomad install'"
}

step_ollama_native() {
  section "Native Ollama (Metal)"
  command -v ollama >/dev/null 2>&1 || brew install ollama
  ok "ollama $(ollama --version 2>/dev/null | head -1)"

  # Stop brew-managed service if present (we run our own LaunchAgent)
  if launchctl list 2>/dev/null | grep -q homebrew.mxcl.ollama; then
    brew services stop ollama >/dev/null || true
  fi

  # CRITICAL ORDERING: bootout the LaunchAgent BEFORE killing the ollama process.
  # If we kill first, launchd's KeepAlive=true immediately respawns the process,
  # and the subsequent bootstrap fails with "5: Input/output error" because the
  # label is still loaded.
  if launchctl print "$LA_TARGET/$LA_LABEL" >/dev/null 2>&1; then
    log "unloading existing LaunchAgent (preventing KeepAlive respawn)"
    launchctl bootout "$LA_TARGET/$LA_LABEL" 2>/dev/null || true
    sleep 2  # let launchd commit
  fi

  # Now free :11434 — any leftover process is an orphan, won't respawn
  if lsof -nP -iTCP:11434 -sTCP:LISTEN >/dev/null 2>&1; then
    local pid proc
    pid="$(lsof -nP -iTCP:11434 -sTCP:LISTEN -F p 2>/dev/null | awk '/^p/{sub(/^p/,"");print;exit}')"
    proc="$(lsof -nP -iTCP:11434 -sTCP:LISTEN -F c 2>/dev/null | awk '/^c/{sub(/^c/,"");print;exit}')"
    warn "process '$proc' (pid $pid) on :11434 after bootout — likely orphan"
    if confirm "Kill it?"; then
      kill "$pid" 2>/dev/null || true; sleep 1
      lsof -nP -iTCP:11434 -sTCP:LISTEN >/dev/null 2>&1 && kill -9 "$pid" 2>/dev/null || true
      sleep 1
      lsof -nP -iTCP:11434 -sTCP:LISTEN >/dev/null 2>&1 && die "could not free :11434"
    else
      die ":11434 must be free for native Ollama"
    fi
  fi

  # Write LaunchAgent — binds 0.0.0.0 so containers can reach via host.docker.internal
  mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"
  local ollama_bin; ollama_bin="$(command -v ollama)"
  # Compute MAX_LOADED_MODELS from RAM — controls how many models stay hot in
  # unified memory. Higher = faster model switching, more memory pressure.
  local ram_gb max_loaded
  ram_gb=$(( $(sysctl -n hw.memsize) / 1024 / 1024 / 1024 ))
  if   [[ $ram_gb -lt 16 ]];  then max_loaded=1
  elif [[ $ram_gb -lt 64 ]];  then max_loaded=2
  elif [[ $ram_gb -lt 128 ]]; then max_loaded=3
  else                             max_loaded=4
  fi

  # ---- LaunchAgent wrapper script ----
  # The LaunchAgent runs this wrapper (not ollama directly). The wrapper
  # resolves OLLAMA_MODELS at runtime so renamed/remounted drives don't break
  # the daemon. Falls back to ~/.ollama/models if the drive is unplugged.
  # mkdir is needed because step_ollama_native runs BEFORE any other step
  # creates $SECRETS_DIR — on a fresh Mac (no prior nomad install) the
  # ~/.config/project-nomad directory doesn't exist yet, so the
  # `cat > "$LAUNCHER"` redirection below fails with "No such file or
  # directory." Caught when testing on a clean MacBook Air 2026-05-11.
  mkdir -p "$SECRETS_DIR" && chmod 700 "$SECRETS_DIR"
  local LAUNCHER="$SECRETS_DIR/ollama-launcher.sh"
  cat > "$LAUNCHER" <<LAUNCH_EOF
#!/usr/bin/env bash
# Auto-generated by nomad install. Resolves NOMAD data drive at runtime.

# 0. Forced-internal override. Set by 'nomad reset-ollama --internal' or by the
#    auto-fallback when the data drive is wedged. Honored here (not just in
#    reset-ollama) so launchd KeepAlive respawns also stay internal until the
#    marker is cleared. Survives reinstall because this check is baked into the
#    generator.
if [[ -f "$MARKER_FILE" ]]; then
  export OLLAMA_MODELS="\$HOME/.ollama/models"
  echo "[ollama-launcher] forced-internal marker present — using \$OLLAMA_MODELS" >&2
  exec ${ollama_bin} serve
fi

# (resolution logic mirrors _resolve_drive_models in nomad — keep in sync)
# 1. Try the configured data root from .env
configured=""
if [[ -f "$ENV_FILE" ]]; then
  configured="\$(grep '^NOMAD_DATA_ROOT=' "$ENV_FILE" | cut -d= -f2-)"
fi
DRIVE_MODELS=""
if [[ -n "\$configured" && -d "\$configured/ollama-models" ]]; then
  DRIVE_MODELS="\$configured/ollama-models"
fi

# 2. Fallback: scan /Volumes for any drive that has project-nomad/ollama-models
#    (handles renames / remounts where the configured path doesn't match)
if [[ -z "\$DRIVE_MODELS" ]]; then
  for v in /Volumes/*; do
    if [[ -d "\$v/project-nomad/ollama-models" ]]; then
      DRIVE_MODELS="\$v/project-nomad/ollama-models"
      break
    fi
  done
fi

# 3. Internal fallback (drive missing — admin still works, just no models from drive)
if [[ -z "\$DRIVE_MODELS" ]]; then
  DRIVE_MODELS="\$HOME/.ollama/models"
  echo "[ollama-launcher] data drive not found at \$configured — falling back to \$DRIVE_MODELS" >&2
else
  echo "[ollama-launcher] using models from \$DRIVE_MODELS" >&2
fi

export OLLAMA_MODELS="\$DRIVE_MODELS"
exec ${ollama_bin} serve
LAUNCH_EOF
  chmod +x "$LAUNCHER"

  cat > "$LA_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>            <string>${LA_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${LAUNCHER}</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OLLAMA_HOST</key>             <string>0.0.0.0:11434</string>
    <!-- KEEP_ALIVE=24h: models stay resident for a day after last use.
         First chat of the day pays cold-load cost (~5-10s for a 8B model
         on M-series); every chat after that is instant. Memory cost is
         covered by the bandwidth budget — see MAX_LOADED_MODELS below. -->
    <key>OLLAMA_KEEP_ALIVE</key>       <string>24h</string>
    <!-- FLASH_ATTENTION: 20-40% throughput improvement on Metal, no
         quality loss. Strictly better attention kernel. -->
    <key>OLLAMA_FLASH_ATTENTION</key>  <string>1</string>
    <!-- KV_CACHE_TYPE=q8_0: quantize the KV cache. ~1.3-1.5x speedup on
         long prompts (RAG context, multi-turn chat); cuts KV memory by
         half so larger contexts fit. Quality difference is below the
         noise floor at q8_0; q4_0 is more aggressive and starts to show. -->
    <key>OLLAMA_KV_CACHE_TYPE</key>    <string>q8_0</string>
    <!-- NUM_PARALLEL=1: serialize requests for max tokens/sec each.
         LLM token generation is memory-bandwidth-bound on Apple Silicon;
         concurrent requests share the same bandwidth pipe and each runs
         slower. For single-user offline Mac (NOMAD's target), serial is
         faster end-to-end. Multi-user / family deployments may want 2-4. -->
    <key>OLLAMA_NUM_PARALLEL</key>     <string>1</string>
    <key>OLLAMA_MAX_LOADED_MODELS</key><string>${max_loaded}</string>
    <!-- OLLAMA_ORIGINS=* allows the quick-chat.html (file:// or any local origin)
         to hit the Ollama API. Single-user offline Mac — broad origin is fine. -->
    <key>OLLAMA_ORIGINS</key>          <string>*</string>
    <key>PATH</key>                    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>         <true/>
  <!-- KeepAlive as a dict so launchd only restarts on CRASH (non-zero exit),
       not on clean shutdown. Bare <true/> tight-loops on a clean `ollama stop`
       and burns CPU until something kicks it. SuccessfulExit=false means
       "if the process exited zero, leave it alone." -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key> <false/>
  </dict>
  <!-- ThrottleInterval: minimum seconds between restart attempts. Without
       this, a configuration error that causes Ollama to crash on boot
       restart-loops at full CPU. 10s is the launchd doc default but worth
       being explicit. -->
  <key>ThrottleInterval</key> <integer>10</integer>
  <!-- ExitTimeOut: how long launchd waits between SIGTERM and SIGKILL.
       Default is 20s. We bump to 30s so an in-flight model generation has
       time to finish writing the conversation buffer to disk on shutdown. -->
  <key>ExitTimeOut</key>      <integer>30</integer>
  <key>StandardOutPath</key>   <string>${HOME}/Library/Logs/nomad-ollama.out.log</string>
  <key>StandardErrorPath</key> <string>${HOME}/Library/Logs/nomad-ollama.err.log</string>
</dict>
</plist>
EOF
  log "Ollama tuning: flash-attention=on, KV-cache=q8_0 (2× context for same RAM), keep-alive=24h, num_parallel=1 (single-user max throughput), max_loaded_models=$max_loaded for ${ram_gb} GB RAM"
  log "LaunchAgent wrapper at $LAUNCHER  (rename-safe drive resolution at runtime)"
  chmod 644 "$LA_PLIST"

  # Bootstrap with retry — "Input/output error" means launchd still has the label
  # in some transient state; sleep + bootout-again + retry is the documented dance.
  local attempt last_err=""
  for attempt in 1 2 3; do
    if launchctl bootstrap "$LA_TARGET" "$LA_PLIST" 2>/tmp/nomad-bootstrap.log; then
      last_err=""
      ok "LaunchAgent bootstrapped"
      break
    fi
    last_err="$(cat /tmp/nomad-bootstrap.log)"
    warn "bootstrap attempt $attempt failed: $last_err"
    if echo "$last_err" | grep -q "Input/output error"; then
      launchctl bootout "$LA_TARGET/$LA_LABEL" 2>/dev/null || true
      sleep $((attempt * 2))
    else
      sleep 2
    fi
  done
  if [[ -n "$last_err" ]]; then
    die "bootstrap failed after 3 attempts: $last_err
Manual recovery:
  launchctl bootout $LA_TARGET/$LA_LABEL 2>/dev/null
  pkill -f 'ollama serve'
  sleep 5
  launchctl bootstrap $LA_TARGET $LA_PLIST"
  fi

  log "waiting for Ollama API on :11434..."
  local deadline=$(( $(date +%s) + 30 ))
  while [[ $(date +%s) -lt $deadline ]]; do
    curl -fsS http://127.0.0.1:11434/api/tags >/dev/null 2>&1 && { ok "Ollama API responding"; return 0; }
    sleep 1
  done
  die "Ollama did not start — check ~/Library/Logs/nomad-ollama.err.log"
}

# Symlink ourselves into brew's bin dir so `nomad <cmd>` works without the
# 'bash' prefix or cd'ing into the bundle folder. Also install the manpage so
# `man nomad` works. Silent on failure.
step_self_install_to_path() {
  local prefix bindir target manpath manpage_target
  prefix="$(brew --prefix 2>/dev/null)"
  [[ -z "$prefix" ]] && return 0

  # CLI symlink
  bindir="$prefix/bin"
  target="$bindir/nomad"

  # Refuse to create a self-referential symlink. If HERE somehow resolved to
  # brew's bin dir (legacy script without symlink resolution, or some other
  # corruption), the symlink target equals the symlink itself — broken on
  # next invocation. Better to skip and let the user fix the underlying issue.
  if [[ "$HERE" == "$bindir" ]]; then
    warn "skipping symlink — HERE ($HERE) equals \$(brew --prefix)/bin"
    warn "would create self-referential link. Run install from the bundle dir instead:"
    warn "  bash ~/Applications/project-nomad/install/macos/nomad install"
    return 0
  fi

  if [[ -d "$bindir" && -w "$bindir" ]]; then
    if [[ -L "$target" && "$(readlink "$target")" == "$HERE/nomad" ]]; then
      :   # already linked
    elif ln -sf "$HERE/nomad" "$target" 2>/dev/null; then
      ok "linked: $target → $HERE/nomad  (you can now run 'nomad <cmd>' directly)"
    fi
  fi

  # Manpages — symlink the whole set (overview + per-command) from the bundle.
  if [[ -d "$HERE/man" ]]; then
    manpath="$prefix/share/man/man1"
    mkdir -p "$manpath" 2>/dev/null
    if [[ -d "$manpath" && -w "$manpath" ]]; then
      local mp count=0
      for mp in "$HERE"/man/nomad*.1; do
        [[ -f "$mp" ]] || continue
        if ln -sf "$mp" "$manpath/$(basename "$mp")" 2>/dev/null; then
          count=$((count+1))
        fi
      done
      [[ $count -gt 0 ]] && ok "manpages: $count pages in $manpath  ('man nomad', 'man nomad-<command>' now work)"
    fi
  fi
}

# Drop discoverable extras onto ~/Desktop/Project Nomad/ so the user finds them
# without spelunking the bundle dir. Two files today:
#   • wipe-and-pave.command   — double-click nuke (Desktop-droppable, .command
#                                runs in Terminal automatically)
#   • admin-same-tab.user.js  — Tampermonkey/Userscripts/Violentmonkey userscript
#                                that strips target="_blank" from admin links
# Symlinks (not copies) so subsequent bundle updates flow through automatically.
# Falls back to cp if symlinks are blocked (e.g., iCloud Drive-mounted Desktop).
step_drop_desktop_tools() {
  local desk="$HOME/Desktop/Project Nomad"
  mkdir -p "$desk" 2>/dev/null || return 0   # locked-down Desktop — skip silently

  # wipe-and-pave.command
  local wipe_src="$HERE/scripts/wipe-and-pave.command"
  local wipe_dst="$desk/wipe-and-pave.command"
  if [[ -f "$wipe_src" ]]; then
    if [[ -L "$wipe_dst" && "$(readlink "$wipe_dst")" == "$wipe_src" ]]; then
      :  # already linked through
    elif ln -sf "$wipe_src" "$wipe_dst" 2>/dev/null \
      || cp "$wipe_src" "$wipe_dst" 2>/dev/null; then
      chmod +x "$wipe_dst" 2>/dev/null
      ok "Desktop: $wipe_dst  (double-click to wipe install before re-testing)"
    fi
  fi

  # admin-same-tab.user.js + its README
  local us_src="$HERE/userscripts/admin-same-tab.user.js"
  local us_dst="$desk/admin-same-tab.user.js"
  if [[ -f "$us_src" ]]; then
    if [[ -L "$us_dst" && "$(readlink "$us_dst")" == "$us_src" ]]; then
      :
    elif ln -sf "$us_src" "$us_dst" 2>/dev/null \
      || cp "$us_src" "$us_dst" 2>/dev/null; then
      ok "Desktop: $us_dst  (drag into Tampermonkey/Userscripts to install)"
    fi
  fi
  local us_readme_src="$HERE/userscripts/README.md"
  local us_readme_dst="$desk/userscripts-README.md"
  if [[ -f "$us_readme_src" ]]; then
    if [[ -L "$us_readme_dst" && "$(readlink "$us_readme_dst")" == "$us_readme_src" ]]; then
      :
    elif ln -sf "$us_readme_src" "$us_readme_dst" 2>/dev/null \
      || cp "$us_readme_src" "$us_readme_dst" 2>/dev/null; then
      :
    fi
  fi
}

# Set this Mac's Bonjour/mDNS local hostname to "nomad" (or NOMAD_HOSTNAME if
# set), so any device on the same WiFi can hit the stack at:
#   http://nomad.local:8080   Command Center
#   http://nomad.local:8090   kiwix library
#   http://nomad.local:11434  Ollama API
# Without this, devices have to use the Mac's existing local hostname (often
# the unwieldy default like "Chriss-Mac-mini.local") or the raw LAN IP.
#
# Side effect: the Mac shows up as the new name in other Macs' Finder sidebar.
# Reversible later via System Settings → General → About → Local hostname.
# Skip with --no-rename or NOMAD_HOSTNAME=skip. Default: prompt.
step_set_local_hostname() {
  local target="${NOMAD_HOSTNAME:-nomad}"
  # NOMAD_NO_RENAME is documented as opt-out, never set by the install path
  # itself — guard against `set -u` exploding when the user hasn't exported it.
  if [[ "$target" == "skip" || "${NOMAD_NO_RENAME:-}" == "1" ]]; then
    return 0
  fi

  section "Local network name (Bonjour/mDNS)"

  local current
  current="$(scutil --get LocalHostName 2>/dev/null || echo "")"

  if [[ "$current" == "$target" ]]; then
    ok "already set to '$target' — http://${target}.local:8080"
    return 0
  fi

  cat <<INFO
Currently this Mac is reachable on your network as:
  http://${current:-?}.local:8080

We can change it to '$target' so devices can reach NOMAD at:
  http://${target}.local:8080   Command Center
  http://${target}.local:8090   Library
  http://${target}.local:11434  AI API

Side effect: this Mac shows as '$target' in other Macs' Finder sidebar.
Reversible later: System Settings → General → About → Local hostname.

INFO

  if confirm "Set local network name to '$target'?"; then
    if sudo scutil --set LocalHostName "$target" 2>/dev/null; then
      ok "local hostname set to '$target' — http://${target}.local:8080"
    else
      warn "couldn't set local hostname (sudo issue?). Manual: sudo scutil --set LocalHostName $target"
    fi
  else
    ok "kept existing local hostname: $current"
  fi
}

step_secrets() {
  section "Secrets (.env, off-iCloud) + state root (always-internal)"
  mkdir -p "$SECRETS_DIR" && chmod 700 "$SECRETS_DIR"

  # State root: hot mysql/redis state, always internal — survives drive eject
  mkdir -p "$NOMAD_STATE_ROOT_DEFAULT"/{mysql,redis}
  chmod 700 "$NOMAD_STATE_ROOT_DEFAULT"
  ok "state root: $NOMAD_STATE_ROOT_DEFAULT  (mysql+redis go here)"

  # Capture host hardware ONCE so admin can identify the real Apple chip via
  # APPLE_CHIP_MODEL / APPLE_GPU_MODEL env vars. The caweis admin image reads
  # these in si.cpu() / si.graphics() fallback paths (proximasan's image too,
  # for CHIP_MODEL only; GPU_MODEL is caweis-image-only).
  local apple_chip apple_gpu
  apple_chip="$(/usr/sbin/system_profiler SPHardwareDataType 2>/dev/null \
    | /usr/bin/awk -F': *' '/Chip|Processor Name/{print $2; exit}' | xargs)"
  [[ -z "$apple_chip" ]] && apple_chip="$(/usr/sbin/sysctl -n machdep.cpu.brand_string 2>/dev/null | xargs)"
  if [[ "$(uname -m)" == "arm64" && -n "$apple_chip" ]]; then
    apple_gpu="${apple_chip} (Metal)"
  else
    apple_gpu="$(/usr/sbin/system_profiler SPDisplaysDataType 2>/dev/null \
      | /usr/bin/awk -F': *' '/Chipset Model/{print $2; exit}' | xargs)"
  fi

  if [[ -f "$ENV_FILE" ]]; then
    warn ".env exists — preserving secrets"
    # Backfill new keys for envs created before the split / Apple-chip injection
    grep -qE "^NOMAD_STATE_ROOT=" "$ENV_FILE" || \
      printf "NOMAD_STATE_ROOT=%s\n" "$NOMAD_STATE_ROOT_DEFAULT" >> "$ENV_FILE"
    grep -qE "^APPLE_CHIP_MODEL=" "$ENV_FILE" || \
      printf "APPLE_CHIP_MODEL=%s\n" "$apple_chip" >> "$ENV_FILE"
    grep -qE "^APPLE_GPU_MODEL=" "$ENV_FILE" || \
      printf "APPLE_GPU_MODEL=%s\n" "$apple_gpu"  >> "$ENV_FILE"
    grep -qE "^HOST_PLATFORM=" "$ENV_FILE" || \
      printf "HOST_PLATFORM=darwin\n" >> "$ENV_FILE"
    grep -qE "^NOMAD_AI_BACKEND=" "$ENV_FILE" || \
      printf "NOMAD_AI_BACKEND=%s\n" "${BACKEND:-ollama}" >> "$ENV_FILE"
  else
    cat > "$ENV_FILE" <<EOF
NOMAD_DATA_ROOT=${DATA_ROOT_RESOLVED}
NOMAD_STATE_ROOT=${NOMAD_STATE_ROOT_DEFAULT}
APP_KEY=$(openssl rand -hex 32)
MYSQL_ROOT_PASSWORD=$(openssl rand -hex 24)
DB_PASSWORD=$(openssl rand -hex 24)
URL=http://localhost:8080
APPLE_CHIP_MODEL=${apple_chip}
APPLE_GPU_MODEL=${apple_gpu}
HOST_PLATFORM=darwin
NOMAD_BUNDLE_DIR=${HERE}
NOMAD_AI_BACKEND=${BACKEND:-ollama}
EOF
    chmod 600 "$ENV_FILE"
    ok "$ENV_FILE written (chmod 600)"
    log "host hardware injected for admin: $apple_chip / $apple_gpu"
  fi
  echo "$ENV_FILE" > "$HERE/.env-pointer"

  # Idempotent: ensure NOMAD_BUNDLE_DIR reflects the current bundle on every
  # install/repair (handles pre-existing .env files + a relocated bundle).
  if [[ -f "$ENV_FILE" ]]; then
    if grep -q '^NOMAD_BUNDLE_DIR=' "$ENV_FILE"; then
      /usr/bin/sed -i '' "s|^NOMAD_BUNDLE_DIR=.*|NOMAD_BUNDLE_DIR=$HERE|" "$ENV_FILE"
    else
      printf 'NOMAD_BUNDLE_DIR=%s\n' "$HERE" >> "$ENV_FILE"
    fi
  fi

  # Validate required keys (Apple chip vars are best-effort, not required)
  for key in NOMAD_DATA_ROOT NOMAD_STATE_ROOT APP_KEY MYSQL_ROOT_PASSWORD DB_PASSWORD URL; do
    grep -qE "^${key}=.+" "$ENV_FILE" || die ".env at $ENV_FILE missing $key — delete and re-run"
  done

  # Drive-change is now safe — mysql/redis live on internal state root,
  # so swapping data roots only relocates content (Wikipedia, models, maps).
  # No credential mismatch possible.
  local current; current="$(grep '^NOMAD_DATA_ROOT=' "$ENV_FILE" | cut -d= -f2-)"
  if [[ "$current" != "$DATA_ROOT_RESOLVED" ]]; then
    /usr/bin/sed -i '' "s|^NOMAD_DATA_ROOT=.*|NOMAD_DATA_ROOT=$DATA_ROOT_RESOLVED|" "$ENV_FILE"
    log "switched NOMAD_DATA_ROOT: $current → $DATA_ROOT_RESOLVED  (mysql/redis stay on internal state root)"
  fi
}

# Pull a single model via Ollama's HTTP API, rendering our own progress line.
# Args: model name, current index, total count, overall start timestamp.
# Always-visible counter format:
#   [2/4] qwen3:14b      pulling   42%   3845 MB / 9100 MB    elapsed 1m23s   total 4m07s
# Falls back to per-line output (no \r) when stdout isn't a TTY (logging/piped).
pull_one_model() {
  local m="$1" idx="$2" tot="$3" overall_start="$4"
  local model_start; model_start="$(date +%s)"
  local last_pct=-1 last_status=""
  local cr; [[ -t 1 ]] && cr=$'\r' || cr=$'\n'

  fmt_dur() {
    local s="$1"
    if [[ "$s" -ge 60 ]]; then printf '%dm%02ds' $((s/60)) $((s%60))
    else printf '%ds' "$s"; fi
  }

  # Capture curl's exit status out of the process substitution. The substitution
  # runs curl, then echoes its exit code into a tmp file; the while loop reads
  # the streamed JSON-lines from curl's stdout. When curl exits, the substitution
  # closes and the loop ends; the rc file is written by then.
  local rc_file; rc_file="$(mktemp -t nomad-pull-rc.XXXXXX)"
  local stderr_file; stderr_file="$(mktemp -t nomad-pull-err.XXXXXX)"
  local saw_progress=0

  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    saw_progress=1
    local fields status total_b done_b err
    if ! fields="$(echo "$line" | jq -r '"\(.status // "")|\(.total // 0)|\(.completed // 0)|\(.error // "")"' 2>/dev/null)"; then
      # jq couldn't parse this frame — surface it instead of silently pretending it was a no-op.
      printf "\n"
      warn "pull stream parse error for $m: ${line:0:120}"
      rm -f "$rc_file" "$stderr_file"
      return 1
    fi
    IFS='|' read -r status total_b done_b err <<<"$fields"
    [[ ! "$total_b" =~ ^[0-9]+$ ]] && total_b=0
    [[ ! "$done_b"  =~ ^[0-9]+$ ]] && done_b=0
    if [[ -n "$err" ]]; then
      printf "\n"
      warn "API error for $m: $err"
      rm -f "$rc_file" "$stderr_file"
      return 1
    fi

    local elapsed=$(( $(date +%s) - model_start ))
    local total_elapsed=$(( $(date +%s) - overall_start ))
    if [[ "$total_b" -gt 0 ]]; then
      local pct=$(( done_b * 100 / total_b ))
      if [[ "$pct" -ne "$last_pct" || "$status" != "$last_status" ]]; then
        printf "%s[%d/%d] %-22s %-9s %3d%%  %5d MB / %5d MB  elapsed %-7s total %-7s   " \
          "$cr" "$idx" "$tot" "$m" "${status:0:9}" "$pct" \
          "$(( done_b / 1048576 ))" "$(( total_b / 1048576 ))" \
          "$(fmt_dur $elapsed)" "$(fmt_dur $total_elapsed)"
        last_pct=$pct
        last_status="$status"
      fi
    elif [[ -n "$status" && "$status" != "$last_status" ]]; then
      printf "%s[%d/%d] %-22s %-50s elapsed %-7s   " \
        "$cr" "$idx" "$tot" "$m" "${status:0:50}" \
        "$(fmt_dur $elapsed)"
      last_status="$status"
    fi
  done < <(
    curl -fsSN -X POST http://127.0.0.1:11434/api/pull \
      -H 'Content-Type: application/json' \
      -d "{\"name\":\"$m\",\"stream\":true}" 2>"$stderr_file"
    echo $? > "$rc_file"
  )

  local curl_rc=0
  [[ -s "$rc_file" ]] && curl_rc="$(cat "$rc_file")"
  local stderr_blob=""
  [[ -s "$stderr_file" ]] && stderr_blob="$(head -c 200 "$stderr_file")"
  rm -f "$rc_file" "$stderr_file"

  printf "\n"
  if [[ "$curl_rc" -ne 0 ]]; then
    warn "pull failed for $m (curl rc=$curl_rc${stderr_blob:+, stderr: ${stderr_blob}})"
    return 1
  fi
  if [[ "$saw_progress" -eq 0 ]]; then
    warn "pull for $m completed with no progress frames — likely empty response"
    return 1
  fi
  return 0
}

# Pre-pull the embedding model BEFORE wiring admin. ~270 MB, ~30 sec on
# residential broadband. Means the moment admin learns about Ollama, RAG and
# file embeddings work immediately. Without this, admin reports "Ollama
# installed" but any embedding-dependent feature returns 500 until the main
# foreground pull finishes the chat models.
step_pull_embedding_quick() {
  [[ "$SKIP_MODELS" -eq 1 ]] && return 0
  local m="nomic-embed-text"
  # Skip if already present
  if curl -fsS http://127.0.0.1:11434/api/tags 2>/dev/null \
     | jq -e --arg m "$m" '.models[]? | select(.name | startswith($m + ":") or .name == $m)' >/dev/null 2>&1; then
    ok "embedding model $m already present"
    return 0
  fi
  log "pre-pulling embedding model ($m, ~270 MB) so admin's RAG works the moment we wire it"
  if pull_one_model "$m" 1 1 "$(date +%s)"; then
    ok "embedding model ready"
  else
    warn "embedding pre-pull failed — admin will be wired but RAG is degraded until you 'nomad models pull $m'"
  fi
}

