# Full reinstall — nuclear "wipe everything and start fresh" path. One command.
# Wipes all NOMAD state (containers, LaunchAgent, .env, drive contents, cached
# compose images), then runs cmd_install from scratch on the same drive.
# Preserves brew + OrbStack + Ollama (those are user-level tools).
cmd_reinstall() {
  section "Full reinstall — wipe + start fresh"
  echo "This wipes ALL NOMAD state and reinstalls from scratch:"
  echo "  • Stops + removes all NOMAD containers + named volumes"
  echo "  • Removes Ollama LaunchAgent + plist"
  echo "  • Removes secrets (~/.config/project-nomad/.env)"
  echo "  • Removes ALL data on the external drive (mysql, redis, ollama-models, storage)"
  echo "  • Removes cached compose images (forces fresh pull)"
  echo "  • Re-runs 'nomad install' from scratch"
  echo
  echo "Brew tools (ollama, orbstack, jq) and this bundle stay intact."
  echo
  confirm "Wipe everything and reinstall?" || die "aborted"

  # Capture data root before wipe so install reuses the same drive without prompting
  local saved_root=""
  [[ -f "$ENV_FILE" ]] && saved_root="$(grep '^NOMAD_DATA_ROOT=' "$ENV_FILE" | cut -d= -f2-)"

  # All subsequent prompts auto-yes (uninstall's "remove drive data" included)
  NOMAD_YES=1
  cmd_uninstall

  # Remove cached compose images so install pulls fresh
  if ensure_docker_path && docker version >/dev/null 2>&1; then
    log "removing cached compose images"
    for img in \
      ghcr.io/crosstalk-solutions/project-nomad:latest \
      ghcr.io/crosstalk-solutions/project-nomad-sidecar-updater:latest \
      amir20/dozzle:v10.0 mysql:8.0 redis:7-alpine; do
      docker image rm -f "$img" >/dev/null 2>&1 || true
    done
    # Also clear the amd64 override so install starts clean
    docker image prune -f >/dev/null 2>&1 || true
  fi

  # Clean any /tmp scratch from previous runs
  rm -f /tmp/nomad-*.log /tmp/nomad-*.result /tmp/nomad-pull.log /tmp/nomad-bootstrap.log 2>/dev/null || true

  echo
  log "starting fresh install in 3 seconds (Ctrl-C to abort)…"
  sleep 3

  # Reuse the same drive — install won't re-prompt
  DATA_ROOT_ARG="$saved_root"
  cmd_install
}

# Full uninstall — clean wipe of NOMAD state. Preserves user-level installs
# (Homebrew, OrbStack, Ollama) since other apps may depend on them.
# Removes:
#   • All NOMAD containers (admin/mysql/redis/dozzle/updater + admin-spawned
#     content containers like nomad_ollama, nomad_kiwix, nomad_qdrant, etc.)
#   • Named volumes (nomad-update-shared)
#   • Ollama LaunchAgent + plist
#   • Secrets at ~/.config/project-nomad/.env
#   • Optionally: data on the external drive (mysql, redis, ollama-models, storage)
cmd_uninstall() {
  section "Uninstall Project NOMAD"

  echo "This will remove:"
  echo "  • All nomad_* containers + named volumes"
  echo "  • Ollama LaunchAgent (~/Library/LaunchAgents/$LA_LABEL.plist)"
  echo "  • Secrets ($ENV_FILE)"
  echo "  • Optionally: data drive contents (you confirm separately)"
  echo
  echo "This will NOT remove: Homebrew, OrbStack, Ollama (user-level installs)."
  echo
  confirm "Proceed?" || die "aborted"

  # 1. Capture data-root before we delete .env
  local data_root=""
  [[ -f "$ENV_FILE" ]] && data_root="$(grep '^NOMAD_DATA_ROOT=' "$ENV_FILE" | cut -d= -f2-)"

  # 2. KILL everything NOMAD-related — SIGKILL first, no graceful shutdown.
  # Use SUBSTRING name match (more universal than regex anchor) plus the
  # compose-project labels for both 'project-nomad' (our stack) AND
  # 'project-nomad-management' (admin-spawned content containers OrbStack
  # groups separately). Also use -a so stopped containers are caught.
  if ensure_docker_path && docker version >/dev/null 2>&1; then
    log "discovering all NOMAD containers (running + stopped)…"
    # Find every container with 'nomad' in name OR labeled by our compose projects
    local all_ids
    all_ids="$( {
      docker ps -aq --filter 'name=nomad'
      docker ps -aq --filter 'label=com.docker.compose.project=project-nomad'
      docker ps -aq --filter 'label=com.docker.compose.project=project-nomad-management'
    } 2>/dev/null | sort -u )"

    if [[ -n "$all_ids" ]]; then
      log "containers to destroy:"
      docker ps -a --format '    {{.ID}}  {{.Names}}  {{.Status}}' 2>/dev/null \
        | grep -E "$(echo "$all_ids" | tr '\n' '|' | sed 's/|$//')" || true

      # SIGKILL anything still running
      local running_ids; running_ids="$(docker ps -q 2>/dev/null | grep -F -f <(echo "$all_ids") || true)"
      if [[ -n "$running_ids" ]]; then
        log "SIGKILL on running containers"
        # shellcheck disable=SC2086
        docker kill $running_ids >/dev/null 2>&1 || true
      fi

      # Tear down our compose project (network, named volumes)
      if [[ -f "$ENV_FILE" && -f "$COMPOSE_BASE" ]]; then
        dc down -v --remove-orphans --timeout 0 2>&1 | sed 's/^/  /' || true
      fi

      # Force-remove all discovered containers (stopped + alive)
      # shellcheck disable=SC2086
      docker rm -f $all_ids >/dev/null 2>&1 || true
    fi

    # Networks — both compose projects can leave one each
    docker network rm project-nomad_default project-nomad-management_default >/dev/null 2>&1 || true

    # Volumes — named volume + anything labeled by either compose project
    docker volume rm nomad-update-shared >/dev/null 2>&1 || true
    local labeled_vols
    labeled_vols="$( {
      docker volume ls -q --filter 'label=com.docker.compose.project=project-nomad'
      docker volume ls -q --filter 'label=com.docker.compose.project=project-nomad-management'
    } 2>/dev/null | sort -u )"
    if [[ -n "$labeled_vols" ]]; then
      # shellcheck disable=SC2086
      docker volume rm $labeled_vols >/dev/null 2>&1 || true
    fi

    # Verify nothing remains with 'nomad' in the name
    local remaining; remaining="$(docker ps -aq --filter 'name=nomad' 2>/dev/null)"
    if [[ -z "$remaining" ]]; then
      ok "all NOMAD containers + volumes + networks destroyed"
    else
      warn "some containers survived:"
      docker ps -a --filter 'name=nomad' --format '    {{.Names}}\t{{.Status}}'
    fi
  else
    warn "docker not reachable — skipping container removal"
  fi

  # 3. Bootout LaunchAgents + kill any orphan ollama
  for label in "$LA_LABEL" "$PATCHER_LABEL"; do
    if launchctl print "$LA_TARGET/$label" >/dev/null 2>&1; then
      launchctl bootout "$LA_TARGET/$label" 2>/dev/null || true
      sleep 1
    fi
  done
  pkill -f 'ollama serve' 2>/dev/null || true
  for plist in "$LA_PLIST" "$PATCHER_PLIST"; do
    [[ -f "$plist" ]] && rm -f "$plist" && ok "removed $plist"
  done
  [[ -f "$PATCHER_SCRIPT" ]] && rm -f "$PATCHER_SCRIPT"

  # 4. Capture state-root path before we remove .env
  local state_root=""
  [[ -f "$ENV_FILE" ]] && state_root="$(grep '^NOMAD_STATE_ROOT=' "$ENV_FILE" 2>/dev/null | cut -d= -f2-)"
  [[ -z "$state_root" ]] && state_root="$NOMAD_STATE_ROOT_DEFAULT"

  # 5. Remove secrets + pointer
  if [[ -f "$ENV_FILE" ]]; then
    rm -f "$ENV_FILE" && ok "removed $ENV_FILE"
  fi
  rm -f "$HERE/.env-pointer"

  # 6. State root (mysql + redis) — always wipe on uninstall (it's tied to the
  # secrets we just deleted; mysql can't decrypt itself with a new password)
  if [[ -d "$state_root" ]]; then
    rm -rf "$state_root" && ok "state root cleaned: $state_root  (mysql + redis data gone)"
  fi

  # 7. Optionally remove data drive contents (content — Wikipedia, models, maps)
  if [[ -n "$data_root" && -d "$data_root" ]]; then
    echo
    echo "Content at $data_root:"
    du -sh "$data_root"/* 2>/dev/null | sed 's/^/  /'
    echo
    if confirm "Also remove all content on the data drive? (storage, ollama-models)"; then
      rm -rf "$data_root"
      ok "data drive cleaned: $data_root"
    else
      log "preserving content at $data_root — re-run 'nomad install' to reuse it"
    fi
  fi

  echo
  ok "Project NOMAD uninstalled"
  dim "Reinstall:                bash nomad install"
  dim "Also remove brew tools:   brew uninstall ollama jq && brew uninstall --cask orbstack"
}

# Auto-tune variant called from install — no prompt, no human in loop.
# Skips silently if 'orb' isn't on PATH or if current allocation is already
# at/above target. Logs whatever it does.
step_orbstack_tune_quiet() {
  section "OrbStack memory tune (auto)"
  if ! command -v orb >/dev/null 2>&1; then
    for o in /Applications/OrbStack.app/Contents/MacOS/xbin/orb \
             /Applications/OrbStack.app/Contents/MacOS/bin/orb; do
      [[ -x "$o" ]] && { export PATH="$(dirname "$o"):$PATH"; break; }
    done
  fi
  if ! command -v orb >/dev/null 2>&1; then
    warn "'orb' CLI not found — skipping memory tune. Run 'nomad orbstack-tune' later if needed"
    return 0
  fi

  local host_gb target_gb current_mib current_gb
  host_gb=$(( $(sysctl -n hw.memsize) / 1024 / 1024 / 1024 ))
  target_gb=$(( host_gb * 8 / 10 ))
  [[ $(( host_gb - target_gb )) -lt 4 ]] && target_gb=$(( host_gb - 4 ))
  [[ $target_gb -lt 4 ]] && target_gb=4

  # `orb config show` outputs `memory_mib: <int>` — parse MiB explicitly,
  # convert to GiB for comparison. Earlier version compared MiB to GB which
  # was always-true (16384 >= 25), making this step a silent no-op.
  current_mib="$(orb config show 2>/dev/null | awk -F'[: ]+' '/^memory_mib/{print $2}' | head -1)"
  current_gb=0
  [[ "$current_mib" =~ ^[0-9]+$ ]] && current_gb=$(( current_mib / 1024 ))

  if [[ "$current_gb" -ge "$target_gb" ]]; then
    ok "OrbStack already at ${current_gb} GB (target was ${target_gb}) — skipping"
    return 0
  fi

  log "tuning OrbStack: ${current_gb} GB → ${target_gb} GB (80% of ${host_gb} GB host)"
  # OrbStack 1.x → 2.x renamed the setter from memory_gib to memory_mib.
  # Try memory_mib first (current API), fall back to memory_gib (old API).
  local target_mib=$(( target_gb * 1024 ))
  local set_ok=0
  if orb config set memory_mib "$target_mib" 2>/dev/null; then
    set_ok=1
  elif orb config set memory_gib "$target_gb" 2>/dev/null; then
    set_ok=1
  fi
  if [[ $set_ok -eq 1 ]]; then
    log "restarting OrbStack VM (~10s)…"
    orb stop  >/dev/null 2>&1 || true
    sleep 2
    orb start >/dev/null 2>&1 || true
    sleep 6
    # Re-wait for daemon since we just restarted it
    local d=$(( $(date +%s) + 60 ))
    while [[ $(date +%s) -lt $d ]]; do
      docker version >/dev/null 2>&1 && break
      sleep 2
    done
    ok "OrbStack tuned to ${target_gb} GB and restarted"
  else
    warn "'orb config set' failed for both memory_mib and memory_gib — your OrbStack version may not expose either."
    warn "Manual: OrbStack.app → Settings → Resources → Memory → ${target_gb} GB"
  fi
}

# OrbStack memory tuner — by default OrbStack allocates roughly half the host
# RAM to its Linux VM. On a 32 GB Mac that means admin's "System Information"
# panel reports ~15 GB, even though the host has 32. This bumps OrbStack to
# host_ram - 8 GB (capped at 96 GB) — leaves macOS enough headroom while
# giving the VM most of the unified memory pool.
#
# Note: this does NOT change inference speed. Native Ollama already uses the
# full 32 GB via Metal. The tune just makes admin's system stats honest.
cmd_orbstack_tune() {
  section "OrbStack memory tune"

  if ! command -v orb >/dev/null 2>&1; then
    for o in /Applications/OrbStack.app/Contents/MacOS/xbin/orb \
             /Applications/OrbStack.app/Contents/MacOS/bin/orb; do
      [[ -x "$o" ]] && { export PATH="$(dirname "$o"):$PATH"; break; }
    done
  fi
  command -v orb >/dev/null 2>&1 \
    || die "'orb' CLI not found. Install OrbStack first, or bump memory manually in OrbStack → Settings → Resources"

  # Optional explicit override: nomad orbstack-tune <gb>
  local explicit_target="${1:-}"
  local host_gb target_gb current_gb
  host_gb=$(( $(sysctl -n hw.memsize) / 1024 / 1024 / 1024 ))

  if [[ -n "$explicit_target" && "$explicit_target" =~ ^[0-9]+$ ]]; then
    target_gb="$explicit_target"
  else
    # 80% of host RAM (proportional, scales from 8 GB Air to 512 GB Studio).
    # Floor: 4 GB for the VM. Always reserve at least 4 GB for macOS.
    target_gb=$(( host_gb * 8 / 10 ))
    [[ $(( host_gb - target_gb )) -lt 4 ]] && target_gb=$(( host_gb - 4 ))
    [[ $target_gb -lt 4 ]] && target_gb=4
  fi

  # See note in step_orbstack_tune_quiet: orb reports memory_mib, not GB.
  local current_mib
  current_mib="$(orb config show 2>/dev/null | awk -F'[: ]+' '/^memory_mib/{print $2}' | head -1)"
  current_gb=0
  [[ "$current_mib" =~ ^[0-9]+$ ]] && current_gb=$(( current_mib / 1024 ))

  log "host RAM:         ${host_gb} GB"
  log "current OrbStack: ${current_gb} GB ($current_mib MiB)"
  log "target:           ${target_gb} GB ($([[ -n "$explicit_target" ]] && echo "explicit" || echo "80% of host, min 4 GB host reserve"))"

  if [[ "$current_gb" -ge "$target_gb" ]]; then
    ok "OrbStack already allocates ${current_gb} GB — no change needed"
    return 0
  fi

  confirm "Bump OrbStack memory limit to ${target_gb} GB and restart? (interrupts running containers briefly)" \
    || die "aborted"

  # OrbStack 1.x → 2.x renamed the setter from memory_gib to memory_mib.
  # Try the current API first, fall back to the older one.
  local target_mib=$(( target_gb * 1024 ))
  log "setting orb config memory_mib=${target_mib}  (= ${target_gb} GB)"
  if ! orb config set memory_mib "$target_mib" 2>&1; then
    log "memory_mib not accepted — falling back to memory_gib (older OrbStack)"
    if ! orb config set memory_gib "$target_gb" 2>&1; then
      warn "'orb config set' failed for both memory_mib and memory_gib"
      warn "Bump manually: OrbStack app → Settings → Resources → Memory → ${target_gb} GB"
      return 1
    fi
  fi

  log "restarting OrbStack to apply (~10–15s)…"
  orb stop  >/dev/null 2>&1 || true
  sleep 2
  orb start >/dev/null 2>&1 || true
  sleep 6

  ok "OrbStack memory limit now ${target_gb} GB"
  log "the NOMAD stack should auto-restart. If admin's System Information still shows the old number, run: nomad up"
}

# Reset the Ollama LaunchAgent — recovery for "bootstrap failed: 5: Input/output
# error" or any other stuck-launchd state. Bootout, kill orphan ollama processes,
# wait for launchd to commit, re-bootstrap, wait for API.
# Use this when 'nomad install' bombs at the LaunchAgent step on a machine that
# had an older buggy NOMAD install previously load the agent.
cmd_reset_ollama() {
  section "Reset Ollama LaunchAgent"

  # 1. Bootout (must happen BEFORE killing process so KeepAlive can't respawn)
  if launchctl print "$LA_TARGET/$LA_LABEL" >/dev/null 2>&1; then
    log "unloading $LA_LABEL"
    launchctl bootout "$LA_TARGET/$LA_LABEL" 2>/dev/null \
      || warn "bootout returned non-zero (continuing — likely already unloaded)"
    sleep 2
  else
    log "$LA_LABEL is not loaded — proceeding to clean up any orphan processes"
  fi

  # 2. Kill any orphan ollama serve processes (KeepAlive can't fight us now)
  if pgrep -f "ollama serve" >/dev/null 2>&1; then
    log "killing orphan 'ollama serve' processes"
    pkill -f "ollama serve" 2>/dev/null || true
    sleep 2
    if pgrep -f "ollama serve" >/dev/null 2>&1; then
      pkill -9 -f "ollama serve" 2>/dev/null || true
      sleep 1
    fi
    pgrep -f "ollama serve" >/dev/null 2>&1 \
      && die "could not kill ollama serve — manual: ps aux | grep ollama"
  fi

  # 3. Confirm :11434 is free
  if lsof -nP -iTCP:11434 -sTCP:LISTEN >/dev/null 2>&1; then
    warn ":11434 still has a listener after the kill"
    lsof -nP -iTCP:11434 -sTCP:LISTEN
    die "free it manually, then re-run: nomad reset-ollama"
  fi
  ok ":11434 free"

  # 4. Plist must exist (if not, user needs to run install which generates it)
  if [[ ! -f "$LA_PLIST" ]]; then
    die "LaunchAgent plist missing at $LA_PLIST
This means NOMAD has never been installed on this machine.
Run: bash nomad install"
  fi
  ok "plist present at $LA_PLIST"

  # 5. Re-bootstrap (with retry on residual I/O error)
  log "bootstrapping LaunchAgent"
  local attempt last_err=""
  for attempt in 1 2 3; do
    if launchctl bootstrap "$LA_TARGET" "$LA_PLIST" 2>/tmp/nomad-bootstrap.log; then
      last_err=""
      break
    fi
    last_err="$(cat /tmp/nomad-bootstrap.log)"
    warn "bootstrap attempt $attempt failed: $last_err"
    launchctl bootout "$LA_TARGET/$LA_LABEL" 2>/dev/null || true
    sleep $((attempt * 2))
  done
  [[ -n "$last_err" ]] && die "bootstrap still failing after 3 attempts: $last_err
Reboot the Mac and try again — this clears all launchd transient state."
  ok "LaunchAgent loaded"

  # 6. Wait for API to come back up
  log "waiting for Ollama API on :11434…"
  local deadline=$(( $(date +%s) + 30 ))
  while [[ $(date +%s) -lt $deadline ]]; do
    if curl -fsS http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
      ok "Ollama API responding"
      return 0
    fi
    sleep 1
  done
  warn "API not yet responding — tail ~/Library/Logs/ollama.err.log for hints"
}

# Benchmark — native Metal Ollama vs container (Rosetta-emulated) Ollama on
# the same Mac, same model, same prompt. The Council's #1 publish-gate ask:
# put one reproducible benchmark number in the README before any "10× faster"
# claim ships.
# Patch admin's latest benchmark row with this Mac's actual host hardware
# (Apple chip + Metal GPU). Containers can't see Metal — admin records empty
# CPU/GPU which then submits as "-" to the upstream leaderboard. This lets
# Mac submissions show real hardware before user clicks Submit in the UI.
cmd_benchmark_patch_host() {
  ensure_docker_path
  api_check_up
  [[ -f "$ENV_FILE" ]] || die ".env missing — run 'nomad install' first"

  # Collect host hardware from macOS, not from inside the container
  local chip cores ram_gb hw_block
  hw_block="$(system_profiler SPHardwareDataType 2>/dev/null)"
  chip="$(echo "$hw_block" | awk -F': *' '/Chip|Processor Name/{print $2; exit}' | xargs)"
  [[ -z "$chip" ]] && chip="$(sysctl -n machdep.cpu.brand_string 2>/dev/null | xargs)"
  cores="$(sysctl -n hw.ncpu)"
  ram_gb=$(( $(sysctl -n hw.memsize) / 1024 / 1024 / 1024 ))

  # GPU: on Apple Silicon, the GPU is integrated into the SoC (e.g. "Apple M4 (Metal)").
  # On Intel Macs there's a discrete or integrated GPU that we'd want to detect separately.
  local gpu_model
  if [[ "$(uname -m)" == "arm64" && -n "$chip" ]]; then
    gpu_model="$chip (Metal)"
  else
    gpu_model="$(system_profiler SPDisplaysDataType 2>/dev/null | awk -F': *' '/Chipset Model/{print $2; exit}' | xargs)"
    [[ -z "$gpu_model" ]] && gpu_model="(unknown)"
  fi

  log "Host hardware (macOS, real values, not container-view):"
  log "  CPU:    $chip"
  log "  Cores:  $cores"
  log "  GPU:    $gpu_model"
  log "  RAM:    ${ram_gb} GB"
  echo

  local db_pw; db_pw="$(grep '^DB_PASSWORD=' "$ENV_FILE" | cut -d= -f2-)"

  # Verify there IS a latest benchmark row to patch
  local row_count
  row_count="$(echo 'SELECT COUNT(*) FROM benchmark_results;' \
    | dc exec -T -e MYSQL_PWD="$db_pw" mysql mysql -u nomad_user --silent --skip-column-names nomad 2>/dev/null \
    | tr -d '[:space:]')"
  if [[ -z "$row_count" || "$row_count" == "0" ]]; then
    die "no benchmark_results in admin DB — run a benchmark from admin UI first (Settings → Benchmark)"
  fi

  log "patching latest of $row_count benchmark row(s) with host hardware…"
  # Single-quote the values for SQL safety (chip names are stable strings)
  local sql
  sql="UPDATE benchmark_results
       SET cpu_model = '$chip',
           cpu_cores = $cores,
           cpu_threads = $cores,
           gpu_model = '$gpu_model'
       WHERE id = (
         SELECT id FROM (
           SELECT id FROM benchmark_results ORDER BY id DESC LIMIT 1
         ) AS latest
       );"

  if echo "$sql" | dc exec -T -e MYSQL_PWD="$db_pw" mysql mysql -u nomad_user nomad >/tmp/nomad-bench-patch.log 2>&1; then
    ok "patched"
    # Show the patched row for confirmation
    echo
    echo 'SELECT id, cpu_model, cpu_cores, gpu_model, cpu_score, submitted_to_repository FROM benchmark_results ORDER BY id DESC LIMIT 1;' \
      | dc exec -T -e MYSQL_PWD="$db_pw" mysql mysql -u nomad_user --table nomad 2>/dev/null | sed 's/^/    /'
    echo
    log "now click Submit in admin UI (Settings → Benchmark) and upstream will see the real hardware."
    log "or if you've already submitted: re-run benchmark + patch-host + submit."
  else
    cat /tmp/nomad-bench-patch.log
    die "SQL update failed — see above"
  fi
}

cmd_benchmark() {
  local sub="${1:-run}"
  case "$sub" in
    patch-host) cmd_benchmark_patch_host; return 0 ;;
    run|"")     ;;  # fall through to native-vs-container comparison
    *)          die "usage: nomad benchmark [run|patch-host] [MODEL]" ;;
  esac
  shift 2>/dev/null || true
  local model="${1:-llama3.1:8b}"
  local prompt="Write a one-paragraph plain-English explanation of how ocean tides work."
  ensure_docker_path
  ensure_ollama_path || die "ollama not found anywhere — run 'nomad install' first"

  section "Benchmark — $model — native Metal vs container Rosetta"
  log "prompt: \"$prompt\""
  echo

  # ---- NATIVE ----
  log "[1/2] native Ollama (Metal)"
  if ! ollama list 2>/dev/null | awk '{print $1}' | grep -qE "^${model}$"; then
    log "pulling $model into native Ollama (~5 GB)…"
    ollama pull "$model"
  fi
  local native_log; native_log="$(mktemp)"
  echo "$prompt" | ollama run --verbose "$model" >"$native_log" 2>&1
  local native_eval_rate native_total_dur
  native_eval_rate="$(grep -E "eval rate" "$native_log" | tail -1 | grep -oE '[0-9.]+ tokens/s' || echo "?")"
  native_total_dur="$(grep -E "total duration" "$native_log" | tail -1 | awk '{print $NF}' || echo "?")"
  ok "native: $native_eval_rate (total wall time $native_total_dur)"

  # ---- CONTAINER (Rosetta) ----
  log "[2/2] container Ollama (linux/amd64 via Rosetta)"
  local cname=nomad_bench_ollama
  docker rm -f "$cname" >/dev/null 2>&1 || true
  log "starting $cname (forced platform=linux/amd64)…"
  docker run -d --rm --name "$cname" \
    --platform linux/amd64 \
    -p 11435:11434 \
    -v "/tmp/nomad-bench-models:/root/.ollama" \
    ollama/ollama:latest >/dev/null
  # Wait for the container's Ollama API
  log "waiting for container Ollama to come up (slow under Rosetta)…"
  local d=$(( $(date +%s) + 60 ))
  while [[ $(date +%s) -lt $d ]]; do
    docker exec "$cname" curl -fsS http://127.0.0.1:11434/api/tags >/dev/null 2>&1 && break
    sleep 2
  done
  log "pulling $model into container Ollama (~5 GB, slow under Rosetta)…"
  docker exec "$cname" ollama pull "$model"
  local container_log; container_log="$(mktemp)"
  docker exec -i "$cname" sh -c "echo '$prompt' | ollama run --verbose $model" >"$container_log" 2>&1
  local cont_eval_rate cont_total_dur
  cont_eval_rate="$(grep -E "eval rate" "$container_log" | tail -1 | grep -oE '[0-9.]+ tokens/s' || echo "?")"
  cont_total_dur="$(grep -E "total duration" "$container_log" | tail -1 | awk '{print $NF}' || echo "?")"
  ok "container: $cont_eval_rate (total wall time $cont_total_dur)"
  docker stop "$cname" >/dev/null 2>&1 || true

  # ---- REPORT ----
  cat <<EOF

${C_HEAD}── Benchmark Result ($(sw_vers -productVersion) on $(uname -m)) ──${C_OFF}

  Model:           $model
  Native (Metal):     $native_eval_rate     (total ${native_total_dur})
  Container (Rosetta): $cont_eval_rate    (total ${cont_total_dur})

Markdown for the README:

| Path                 | Eval rate         | Total wall time |
|----------------------|-------------------|-----------------|
| Native Ollama (Metal) | $native_eval_rate | $native_total_dur |
| Container (Rosetta) | $cont_eval_rate | $cont_total_dur |

Hardware: $(sw_vers -productVersion), $(uname -m), $(( $(sysctl -n hw.memsize) / 1024 / 1024 / 1024 )) GB RAM.
Model: $model. Prompt: "$prompt"

EOF
  rm -f "$native_log" "$container_log"
}

# System info via API
cmd_system() {
  api_check_up
  local sub="${1:-info}"
  case "$sub" in
    info)     api_get /api/system/info | jq . ;;
    debug)    api_get /api/system/debug-info | jq . ;;
    internet) api_get /api/system/internet-status | jq . ;;
    *)        die "usage: nomad system [info|debug|internet]" ;;
  esac
}

# ─── Field Desk coexistence install ───────────────────────────────────────────
# SysAdminDoc/project-nomad-desktop is a separate product (NOMAD Field Desk) —
# different architecture, broader survival-domain features. Coexists cleanly:
# both apps default to :8080 but Field Desk respects NOMAD_PORT, and both want
# Ollama on :11434 (good — single Metal daemon serves both). Pattern at
# SysAdminDoc/project-nomad-desktop#3.
cmd_install_field_desk() {
  local port="${NOMAD_FIELD_DESK_PORT:-8081}"
  local target="$HOME/Applications/NOMADFieldDesk-macOS"
  local url="https://github.com/SysAdminDoc/project-nomad-desktop/releases/latest/download/NOMADFieldDesk-macOS"
  local sha_url="https://github.com/SysAdminDoc/project-nomad-desktop/releases/latest/download/SHA256SUMS.txt"
  local foreground=0 force=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port)         port="$2"; shift 2 ;;
      --foreground)   foreground=1; shift ;;
      --force)        force=1; shift ;;
      *) die "usage: nomad install-field-desk [--port PORT] [--foreground] [--force]" ;;
    esac
  done

  # Refuse the port if already in use by something other than Field Desk itself
  if lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
    local owner
    owner="$(lsof -nP -iTCP:"$port" -sTCP:LISTEN | awk 'NR==2 {print $1}')"
    if [[ "$owner" != NOMADField* && "$owner" != "Python" ]]; then
      die ":$port already in use by $owner — pass --port with a free port"
    fi
    warn "Field Desk-like process already on :$port ($owner) — re-launching anyway"
  fi

  # Sanity-check the upstream Crosstalk admin (informational, not fatal)
  if curl -fsS --max-time 2 http://127.0.0.1:8080/api/health >/dev/null 2>&1; then
    ok "Crosstalk admin responding on :8080 — Ollama on :11434 will be shared"
  else
    warn "Crosstalk admin not on :8080 — Field Desk will run alone (still works)"
  fi

  # Sanity-check Ollama (Field Desk needs it for the AI Chat tab)
  if curl -fsS --max-time 2 http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
    ok "Ollama serving on :11434 — Field Desk's AI Chat will use it"
  else
    warn "Ollama not on :11434 — AI Chat won't work until 'nomad up' or 'nomad reset-ollama'"
  fi

  # Download the binary if missing or --force
  mkdir -p "$(dirname "$target")"
  if [[ ! -x "$target" || $force -eq 1 ]]; then
    log "downloading Field Desk → $target"
    curl -fL --progress-bar -o "$target.tmp" "$url" \
      || die "download failed — check network or fetch manually: $url"
    chmod +x "$target.tmp"

    # SHA256 verify against the release's SHA256SUMS.txt — defense in depth
    local sha_file expected actual
    sha_file="$(mktemp)"
    if curl -fsS -o "$sha_file" "$sha_url"; then
      expected="$(awk '/NOMADFieldDesk-macOS$/ {print $1}' "$sha_file")"
      actual="$(shasum -a 256 "$target.tmp" | awk '{print $1}')"
      if [[ -n "$expected" && "$expected" != "$actual" ]]; then
        rm -f "$target.tmp" "$sha_file"
        die "SHA256 mismatch — expected $expected, got $actual"
      fi
      ok "SHA256 verified ($actual)"
    else
      warn "couldn't fetch SHA256SUMS.txt — proceeding without verify"
    fi
    rm -f "$sha_file"
    mv "$target.tmp" "$target"
  else
    ok "Field Desk already at $target  (use --force to redownload)"
  fi

  # Launch on a non-conflicting port. NOMAD_HOST=127.0.0.1 keeps it loopback-only
  # per their security posture; user can override their .env for LAN sharing.
  log "starting Field Desk on http://127.0.0.1:$port  (Ollama shared from :11434)"
  if [[ $foreground -eq 1 ]]; then
    NOMAD_PORT="$port" NOMAD_OLLAMA_PORT=11434 NOMAD_HOST=127.0.0.1 "$target"
  else
    nohup env NOMAD_PORT="$port" NOMAD_OLLAMA_PORT=11434 NOMAD_HOST=127.0.0.1 \
      "$target" >/dev/null 2>&1 &
    local fd_pid=$!
    disown "$fd_pid" 2>/dev/null || true
    sleep 2
    if kill -0 "$fd_pid" 2>/dev/null; then
      ok "Field Desk pid $fd_pid → http://127.0.0.1:$port"
      ok "to stop later: kill $fd_pid  (or close from menu bar)"
      open "http://127.0.0.1:$port" 2>/dev/null || true
    else
      die "Field Desk exited on launch — re-run with --foreground to see stderr"
    fi
  fi
}

# ─── arg parsing + dispatch ───────────────────────────────────────────────────
DATA_ROOT_ARG=""
TIER="auto"            # auto | tiny | small | medium | large | xl | dreamy
MODELS=""              # if non-empty, overrides tier resolution
SKIP_MODELS=0

CMD="${1:-help}"
[[ $# -gt 0 ]] && shift
while [[ $# -gt 0 ]]; do
  case "$1" in
    --data-root)  DATA_ROOT_ARG="$2"; shift 2 ;;
    --tier)       TIER="$2"; shift 2 ;;
    --models)     MODELS="$2"; shift 2 ;;
    --no-models)  SKIP_MODELS=1; shift ;;
    --yes|-y)     NOMAD_YES=1; shift ;;
    --help|-h)    CMD="help"; shift ;;
    *)            EXTRA_ARGS+=("$1"); shift ;;
  esac
done

# Resolve final model list: --models takes precedence; otherwise resolve tier
if [[ -z "$MODELS" ]]; then
  MODELS="$(resolve_tier_models "$TIER")"
fi
EXTRA_ARGS=("${EXTRA_ARGS[@]:-}")

case "$CMD" in
  install)         cmd_install ;;
  check)           cmd_check "${EXTRA_ARGS[0]:-all}" ;;
  up)              cmd_up ;;
  down)            cmd_down ;;
  restart)         cmd_restart "${EXTRA_ARGS[0]:-admin}" ;;
  logs)            cmd_logs    "${EXTRA_ARGS[0]:-admin}" ;;
  models)          cmd_models   "${EXTRA_ARGS[@]}" ;;
  upgrade-models)  cmd_upgrade_models ;;
  downloads)       cmd_downloads "${EXTRA_ARGS[@]:-list}" ;;
  zim)             cmd_zim       "${EXTRA_ARGS[@]:-list}" ;;
  services)        cmd_services  "${EXTRA_ARGS[@]:-list}" ;;
  system)          cmd_system    "${EXTRA_ARGS[@]:-info}" ;;
  api)             cmd_api       "${EXTRA_ARGS[@]}" ;;
  benchmark)       cmd_benchmark "${EXTRA_ARGS[@]}" ;;
  orbstack-tune)   cmd_orbstack_tune "${EXTRA_ARGS[@]}" ;;
  reset-ollama)    cmd_reset_ollama ;;
  uninstall)       cmd_uninstall ;;
  reinstall)       cmd_reinstall ;;
  install-field-desk) cmd_install_field_desk "${EXTRA_ARGS[@]}" ;;
  help|--help|-h)
    sed -n '2,36p' "$0" | sed 's/^# //; s/^#//'
    ;;
  *) die "unknown command: $CMD
Run 'nomad help' for usage." ;;
esac
