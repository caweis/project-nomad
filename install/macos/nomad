# Service install/affect/list.
# Subcommands: list (default), install NAME, affect ACTION NAME (start/stop/restart)
cmd_services() {
  api_check_up
  local sub="${1:-list}"
  case "$sub" in
    list|"")
      log "services:"
      api_get /api/system/services \
        | jq -r '.[]? // empty | "\(.service_name // "?")\t\(.installed // false | tostring)\t\(.installation_status // "?")\t\(.container_image // "")"' 2>/dev/null \
        | column -t -s $'\t' \
        || api_get /api/system/services | jq . ;;
    install)
      local name="${2:?usage: nomad services install NAME}"
      api_post /api/system/services/install "{\"serviceName\":\"$name\"}" | jq . ;;
    affect)
      local action="${2:?}" name="${3:?usage: nomad services affect <start|stop|restart> NAME}"
      api_post /api/system/services/affect "{\"action\":\"$action\",\"serviceName\":\"$name\"}" | jq . ;;
    *)
      die "unknown subcommand: $sub
usage: nomad services [list|install NAME|affect ACTION NAME]" ;;
  esac
}

# Full reinstall — nuclear "wipe everything and start fresh" path. One command.
# Wipes all NOMAD state (containers, LaunchAgent, .env, drive contents, cached
# compose images), then runs cmd_install from scratch on the same drive.
# Preserves brew + OrbStack + Ollama (those are user-level tools).
cmd_reinstall() {
  section "Full reinstall — wipe + start fresh"
  echo "This wipes ALL NOMAD state and reinstalls from scratch:"
  echo "  • Stops + removes all NOMAD containers + named volumes"
  echo "  • Removes Ollama LaunchAgent + plist"
  echo "  • Removes secrets (~/.config/project-nomad/.env)"
  echo "  • Removes ALL data on the external drive (mysql, redis, ollama-models, storage)"
  echo "  • Removes cached compose images (forces fresh pull)"
  echo "  • Re-runs 'nomad install' from scratch"
  echo
  echo "Brew tools (ollama, orbstack, jq) and this bundle stay intact."
  echo
  confirm "Wipe everything and reinstall?" || die "aborted"

  # Capture data root before wipe so install reuses the same drive without prompting
  local saved_root=""
  [[ -f "$ENV_FILE" ]] && saved_root="$(grep '^NOMAD_DATA_ROOT=' "$ENV_FILE" | cut -d= -f2-)"

  # All subsequent prompts auto-yes (uninstall's "remove drive data" included)
  NOMAD_YES=1
  cmd_uninstall

  # Remove cached compose images so install pulls fresh
  if ensure_docker_path && docker version >/dev/null 2>&1; then
    log "removing cached compose images"
    for img in \
      ghcr.io/crosstalk-solutions/project-nomad:latest \
      ghcr.io/crosstalk-solutions/project-nomad-sidecar-updater:latest \
      amir20/dozzle:v10.0 mysql:8.0 redis:7-alpine; do
      docker image rm -f "$img" >/dev/null 2>&1 || true
    done
    # Also clear the amd64 override so install starts clean
    docker image prune -f >/dev/null 2>&1 || true
  fi

  # Clean any /tmp scratch from previous runs
  rm -f /tmp/nomad-*.log /tmp/nomad-*.result /tmp/nomad-pull.log /tmp/nomad-bootstrap.log 2>/dev/null || true

  echo
  log "starting fresh install in 3 seconds (Ctrl-C to abort)..."
  sleep 3

  # Reuse the same drive — install won't re-prompt
  DATA_ROOT_ARG="$saved_root"
  cmd_install
}

# Full uninstall — clean wipe of NOMAD state. Preserves user-level installs
# (Homebrew, OrbStack, Ollama) since other apps may depend on them.
# Removes:
#   • All NOMAD containers (admin/mysql/redis/dozzle/updater + admin-spawned
#     content containers like nomad_ollama, nomad_kiwix, nomad_qdrant, etc.)
#   • Named volumes (nomad-update-shared)
#   • Ollama LaunchAgent + plist
#   • Secrets at ~/.config/project-nomad/.env
#   • Optionally: data on the external drive (mysql, redis, ollama-models, storage)
cmd_uninstall() {
  section "Uninstall Project NOMAD"

  echo "This will remove:"
  echo "  • All nomad_* containers + named volumes"
  echo "  • Ollama LaunchAgent (~/Library/LaunchAgents/$LA_LABEL.plist)"
  echo "  • Secrets ($ENV_FILE)"
  echo "  • Optionally: data drive contents (you confirm separately)"
  echo
  echo "This will NOT remove: Homebrew, OrbStack, Ollama (user-level installs)."
  echo
  confirm "Proceed?" || die "aborted"

  # 1. Capture data-root before we delete .env
  local data_root=""
  [[ -f "$ENV_FILE" ]] && data_root="$(grep '^NOMAD_DATA_ROOT=' "$ENV_FILE" | cut -d= -f2-)"

  # 2. KILL everything NOMAD-related — SIGKILL first, no graceful shutdown.
  # Use SUBSTRING name match (more universal than regex anchor) plus the
  # compose-project labels for both 'project-nomad' (our stack) AND
  # 'project-nomad-management' (admin-spawned content containers OrbStack
  # groups separately). Also use -a so stopped containers are caught.
  if ensure_docker_path && docker version >/dev/null 2>&1; then
    log "discovering all NOMAD containers (running + stopped)..."
    # Find every container with 'nomad' in name OR labeled by our compose projects
    local all_ids
    all_ids="$( {
      docker ps -aq --filter 'name=nomad'
      docker ps -aq --filter 'label=com.docker.compose.project=project-nomad'
      docker ps -aq --filter 'label=com.docker.compose.project=project-nomad-management'
    } 2>/dev/null | sort -u )"

    if [[ -n "$all_ids" ]]; then
      log "containers to destroy:"
      docker ps -a --format '    {{.ID}}  {{.Names}}  {{.Status}}' 2>/dev/null \
        | grep -E "$(echo "$all_ids" | tr '\n' '|' | sed 's/|$//')" || true

      # SIGKILL anything still running.
      # Was: `docker ps -q | grep -F -f <(echo "$all_ids")` which is a
      # substring (fixed-string) match — if docker's default ID truncation
      # ever changes so the two sides return different-length IDs, a short
      # ID could prefix-match an unrelated longer one and we'd kill the
      # wrong container. comm -12 with sort -u gives exact set intersection.
      local running_ids
      running_ids="$(comm -12 <(echo "$all_ids") <(docker ps -q 2>/dev/null | sort -u))"
      if [[ -n "$running_ids" ]]; then
        log "SIGKILL on running containers"
        # shellcheck disable=SC2086
        docker kill $running_ids >/dev/null 2>&1 || true
      fi

      # Tear down our compose project (network, named volumes)
      if [[ -f "$ENV_FILE" && -f "$COMPOSE_BASE" ]]; then
        dc down -v --remove-orphans --timeout 0 2>&1 | sed 's/^/  /' || true
      fi

      # Force-remove all discovered containers (stopped + alive)
      # shellcheck disable=SC2086
      docker rm -f $all_ids >/dev/null 2>&1 || true
    fi

    # Networks — both compose projects can leave one each
    docker network rm project-nomad_default project-nomad-management_default >/dev/null 2>&1 || true

    # Volumes — named volume + anything labeled by either compose project
    docker volume rm nomad-update-shared >/dev/null 2>&1 || true
    local labeled_vols
    labeled_vols="$( {
      docker volume ls -q --filter 'label=com.docker.compose.project=project-nomad'
      docker volume ls -q --filter 'label=com.docker.compose.project=project-nomad-management'
    } 2>/dev/null | sort -u )"
    if [[ -n "$labeled_vols" ]]; then
      # shellcheck disable=SC2086
      docker volume rm $labeled_vols >/dev/null 2>&1 || true
    fi

    # Verify nothing remains with 'nomad' in the name
    local remaining; remaining="$(docker ps -aq --filter 'name=nomad' 2>/dev/null)"
    if [[ -z "$remaining" ]]; then
      ok "all NOMAD containers + volumes + networks destroyed"
    else
      warn "some containers survived:"
      docker ps -a --filter 'name=nomad' --format '    {{.Names}}\t{{.Status}}'
    fi
  else
    # Containers can't be removed because docker isn't up. The next install
    # MUST force-recreate them so mysql + redis re-bootstrap against the
    # current .env passwords rather than the stale ones baked into the
    # still-running containers. Without force-recreate, admin will hit
    # "Access denied" against mysql every time. (Witnessed on reinstall:
    # 2026-05-11.)
    warn "docker not reachable — containers can't be removed now"
    warn "next install will --force-recreate them so credentials don't drift"
  fi

  # 3. Bootout LaunchAgents + kill any orphan ollama
  for label in "$LA_LABEL" "$PATCHER_LABEL" "$KIWIX_SELF_HEAL_LABEL" "$BONJOUR_LABEL" "$HOST_BRIDGE_LABEL"; do
    if launchctl print "$LA_TARGET/$label" >/dev/null 2>&1; then
      launchctl bootout "$LA_TARGET/$label" 2>/dev/null || true
      sleep 1
    fi
  done
  pkill -f 'ollama serve' 2>/dev/null || true
  pkill -f 'dns-sd -R NOMAD Command Center' 2>/dev/null || true
  for plist in "$LA_PLIST" "$PATCHER_PLIST" "$KIWIX_SELF_HEAL_PLIST" "$BONJOUR_PLIST" "$HOST_BRIDGE_PLIST"; do
    [[ -f "$plist" ]] && rm -f "$plist" && ok "removed $plist"
  done
  for script in "$PATCHER_SCRIPT" "$KIWIX_SELF_HEAL_SCRIPT" "$HOST_BRIDGE_SCRIPT"; do
    [[ -f "$script" ]] && rm -f "$script"
  done

  # 4. Capture state-root path before we remove .env
  local state_root=""
  [[ -f "$ENV_FILE" ]] && state_root="$(grep '^NOMAD_STATE_ROOT=' "$ENV_FILE" 2>/dev/null | cut -d= -f2-)"
  [[ -z "$state_root" ]] && state_root="$NOMAD_STATE_ROOT_DEFAULT"

  # 5. Remove secrets + pointer
  if [[ -f "$ENV_FILE" ]]; then
    rm -f "$ENV_FILE" && ok "removed $ENV_FILE"
  fi
  rm -f "$HERE/.env-pointer"

  # 6. State root (mysql + redis) — always wipe on uninstall (it's tied to the
  # secrets we just deleted; mysql can't decrypt itself with a new password)
  if [[ -d "$state_root" ]]; then
    rm -rf "$state_root" && ok "state root cleaned: $state_root  (mysql + redis data gone)"
  fi

  # 7. Optionally remove data drive contents (content — Wikipedia, models, maps)
  if [[ -n "$data_root" && -d "$data_root" ]]; then
    echo
    echo "Content at $data_root:"
    du -sh "$data_root"/* 2>/dev/null | sed 's/^/  /'
    echo
    if confirm "Also remove all content on the data drive? (storage, ollama-models)"; then
      rm -rf "$data_root"
      ok "data drive cleaned: $data_root"
    else
      log "preserving content at $data_root — re-run 'nomad install' to reuse it"
    fi
  fi

  # 8. Manpages: remove only symlinks that point into our bundle's man/ dir.
  local manpath; manpath="$(brew --prefix 2>/dev/null)/share/man/man1"
  if [[ -d "$manpath" ]]; then
    local mp
    for mp in "$manpath"/nomad*.1; do
      [[ -L "$mp" ]] || continue
      case "$(readlink "$mp")" in
        */man/nomad*.1) rm -f "$mp" ;;
      esac
    done
  fi

  echo
  ok "Project NOMAD uninstalled"
  dim "Reinstall:                bash nomad install"
  dim "Also remove brew tools:   brew uninstall ollama jq && brew uninstall --cask orbstack"
}

# Auto-tune variant called from install — no prompt, no human in loop.
# Skips silently if 'orb' isn't on PATH or if current allocation is already
# at/above target. Logs whatever it does.
step_orbstack_tune_quiet() {
  section "OrbStack memory tune (auto)"
  if ! command -v orb >/dev/null 2>&1; then
    for o in /Applications/OrbStack.app/Contents/MacOS/xbin/orb \
             /Applications/OrbStack.app/Contents/MacOS/bin/orb; do
      [[ -x "$o" ]] && { export PATH="$(dirname "$o"):$PATH"; break; }
    done
  fi
  if ! command -v orb >/dev/null 2>&1; then
    warn "'orb' CLI not found — skipping memory tune. Run 'nomad orbstack-tune' later if needed"
    return 0
  fi

  local host_gb target_gb current_mib current_gb
  host_gb=$(( $(sysctl -n hw.memsize) / 1024 / 1024 / 1024 ))
  target_gb=$(( host_gb * 8 / 10 ))
  [[ $(( host_gb - target_gb )) -lt 4 ]] && target_gb=$(( host_gb - 4 ))
  [[ $target_gb -lt 4 ]] && target_gb=4

  # `orb config show` outputs `memory_mib: <int>` — parse MiB explicitly,
  # convert to GiB for comparison. Earlier version compared MiB to GB which
  # was always-true (16384 >= 25), making this step a silent no-op.
  current_mib="$(orb config show 2>/dev/null | awk -F'[: ]+' '/^memory_mib/{print $2}' | head -1)"
  current_gb=0
  [[ "$current_mib" =~ ^[0-9]+$ ]] && current_gb=$(( current_mib / 1024 ))

  if [[ "$current_gb" -ge "$target_gb" ]]; then
    ok "OrbStack already at ${current_gb} GB (target was ${target_gb}) — skipping"
    return 0
  fi

  log "tuning OrbStack: ${current_gb} GB → ${target_gb} GB (80% of ${host_gb} GB host)"
  # OrbStack 1.x → 2.x renamed the setter from memory_gib to memory_mib.
  # Try memory_mib first (current API), fall back to memory_gib (old API).
  local target_mib=$(( target_gb * 1024 ))
  local set_ok=0
  if orb config set memory_mib "$target_mib" 2>/dev/null; then
    set_ok=1
  elif orb config set memory_gib "$target_gb" 2>/dev/null; then
    set_ok=1
  fi
  if [[ $set_ok -eq 1 ]]; then
    log "restarting OrbStack VM (~10s)..."
    orb stop  >/dev/null 2>&1 || true
    sleep 2
    orb start >/dev/null 2>&1 || true
    sleep 6
    # Re-wait for daemon since we just restarted it
    local d=$(( $(date +%s) + 60 ))
    while [[ $(date +%s) -lt $d ]]; do
      docker version >/dev/null 2>&1 && break
      sleep 2
    done
    ok "OrbStack tuned to ${target_gb} GB and restarted"
  else
    warn "'orb config set' failed for both memory_mib and memory_gib — your OrbStack version may not expose either."
    warn "Manual: OrbStack.app → Settings → Resources → Memory → ${target_gb} GB"
  fi
}

# OrbStack memory tuner — by default OrbStack allocates roughly half the host
# RAM to its Linux VM. On a 32 GB Mac that means admin's "System Information"
# panel reports ~15 GB, even though the host has 32. This bumps OrbStack to
# host_ram - 8 GB (capped at 96 GB) — leaves macOS enough headroom while
# giving the VM most of the unified memory pool.
#
# Note: this does NOT change inference speed. Native Ollama already uses the
# full 32 GB via Metal. The tune just makes admin's system stats honest.
cmd_orbstack_tune() {
  section "OrbStack memory tune"

  if ! command -v orb >/dev/null 2>&1; then
    for o in /Applications/OrbStack.app/Contents/MacOS/xbin/orb \
             /Applications/OrbStack.app/Contents/MacOS/bin/orb; do
      [[ -x "$o" ]] && { export PATH="$(dirname "$o"):$PATH"; break; }
    done
  fi
  command -v orb >/dev/null 2>&1 \
    || die "'orb' CLI not found. Install OrbStack first, or bump memory manually in OrbStack → Settings → Resources"

  # Optional explicit override: nomad orbstack-tune <gb>
  local explicit_target="${1:-}"
  local host_gb target_gb current_gb
  host_gb=$(( $(sysctl -n hw.memsize) / 1024 / 1024 / 1024 ))

  if [[ -n "$explicit_target" && "$explicit_target" =~ ^[0-9]+$ ]]; then
    target_gb="$explicit_target"
  else
    # 80% of host RAM (proportional, scales from 8 GB Air to 512 GB Studio).
    # Floor: 4 GB for the VM. Always reserve at least 4 GB for macOS.
    target_gb=$(( host_gb * 8 / 10 ))
    [[ $(( host_gb - target_gb )) -lt 4 ]] && target_gb=$(( host_gb - 4 ))
    [[ $target_gb -lt 4 ]] && target_gb=4
  fi

  # See note in step_orbstack_tune_quiet: orb reports memory_mib, not GB.
  local current_mib
  current_mib="$(orb config show 2>/dev/null | awk -F'[: ]+' '/^memory_mib/{print $2}' | head -1)"
  current_gb=0
  [[ "$current_mib" =~ ^[0-9]+$ ]] && current_gb=$(( current_mib / 1024 ))

  log "host RAM:         ${host_gb} GB"
  log "current OrbStack: ${current_gb} GB ($current_mib MiB)"
  log "target:           ${target_gb} GB ($([[ -n "$explicit_target" ]] && echo "explicit" || echo "80% of host, min 4 GB host reserve"))"

  if [[ "$current_gb" -ge "$target_gb" ]]; then
    ok "OrbStack already allocates ${current_gb} GB — no change needed"
    return 0
  fi

  confirm "Bump OrbStack memory limit to ${target_gb} GB and restart? (interrupts running containers briefly)" \
    || die "aborted"

  # OrbStack 1.x → 2.x renamed the setter from memory_gib to memory_mib.
  # Try the current API first, fall back to the older one.
  local target_mib=$(( target_gb * 1024 ))
  log "setting orb config memory_mib=${target_mib}  (= ${target_gb} GB)"
  if ! orb config set memory_mib "$target_mib" 2>&1; then
    log "memory_mib not accepted — falling back to memory_gib (older OrbStack)"
    if ! orb config set memory_gib "$target_gb" 2>&1; then
      warn "'orb config set' failed for both memory_mib and memory_gib"
      warn "Bump manually: OrbStack app → Settings → Resources → Memory → ${target_gb} GB"
      return 1
    fi
  fi

  log "restarting OrbStack to apply (~10–15s)..."
  orb stop  >/dev/null 2>&1 || true
  sleep 2
  orb start >/dev/null 2>&1 || true
  sleep 6

  ok "OrbStack memory limit now ${target_gb} GB"
  log "the NOMAD stack should auto-restart. If admin's System Information still shows the old number, run: nomad up"
}

# ─── wedged-drive recovery helpers ────────────────────────────────────────────
# Forced-internal marker (see MARKER_FILE global). Presence ⇒ use internal models.
_marker_present() { [[ -f "$MARKER_FILE" ]]; }
_marker_set()     { mkdir -p "$SECRETS_DIR" && : > "$MARKER_FILE"; }
_marker_clear()   { rm -f "$MARKER_FILE"; }

# Run a command, killing it if it exceeds $1 seconds. No coreutils `timeout`
# dependency (can't assume gtimeout on a fresh Mac). Returns 0 if the command
# returned within the window (ANY exit code), 1 if it had to be killed.
_run_timeboxed() {
  local t="$1"; shift
  local done_flag; done_flag="$(mktemp)"
  ( "$@" >/dev/null 2>&1; touch "$done_flag.ok" ) &
  local pid=$!
  ( sleep "$t"; kill -9 "$pid" 2>/dev/null ) &
  local watcher=$!
  wait "$pid" 2>/dev/null
  kill "$watcher" 2>/dev/null; wait "$watcher" 2>/dev/null
  if [[ -f "$done_flag.ok" ]]; then
    rm -f "$done_flag" "$done_flag.ok"
    return 0
  fi
  rm -f "$done_flag" "$done_flag.ok"
  return 1
}

# Is the drive models path WEDGED? Probes a DEEP read (the manifests dir) because
# a mounted-but-hung APFS volume passes a top-level `ls` while a deep readdir
# hangs. Returns 0 = wedged (read did not return within the timeout),
# 1 = not wedged (returned fast, whether success or ENOENT).
_probe_wedged() {
  local path="$1" t="${2:-5}"
  if _run_timeboxed "$t" ls "$path"; then return 1; else return 0; fi
}

# Pick the model tier to pull given a RAM-derived target and available GB on the
# boot volume. Walks DOWN from the target (never up — downshift is always
# RAM-safe), choosing the largest tier whose estimate + 10 GB headroom fits.
# Echoes a tier name, or "minimal" (chat+embed ~2 GB sub-floor), or "none".
_select_pull_tier() {
  local target="$1" avail="$2" headroom=10
  local ladder=(tiny small medium large xl dreamy)
  local ti=$(( ${#ladder[@]} - 1 )) k
  for k in "${!ladder[@]}"; do [[ "${ladder[$k]}" == "$target" ]] && ti=$k; done
  local i
  for (( i=ti; i>=0; i-- )); do
    local t="${ladder[$i]}" sz; sz="$(tier_size_gb "$t")"
    if (( sz + headroom <= avail )); then echo "$t"; return 0; fi
  done
  if (( 2 + headroom <= avail )); then echo "minimal"; return 0; fi
  echo "none"
}

# Auto-pull the tier-appropriate model set into the internal store when it is
# empty. IAW system performance: auto_tier() picks the tier from RAM; the pull
# is disk-gated (downshifts to fit the boot volume) and best-effort/offline-safe
# (a failed or partial pull never fails recovery — the daemon is already up).
_autopull_tier_models() {
  section "Auto-pull models (internal store is empty)"

  # Free GB on the volume holding ~/.ollama/models (nearest existing parent).
  local probe_dir="$HOME/.ollama"
  [[ -d "$probe_dir" ]] || probe_dir="$HOME"
  local avail_gb
  if avail_gb="$(df -g "$probe_dir" 2>/dev/null | awk 'NR==2 {print $4}')" && [[ -n "$avail_gb" ]]; then
    :
  else  # -g unavailable → parse 1K blocks
    local raw_k; raw_k="$(df -k "$probe_dir" 2>/dev/null | awk 'NR==2 {print $4}')"
    avail_gb=$(( ${raw_k:-0} / 1024 / 1024 ))
    if [[ $avail_gb -eq 0 ]]; then
      warn "could not determine free space on boot volume — skipping auto-pull"
      warn "when online, run:  ollama pull llama3.2:3b"
      return 0
    fi
  fi

  local target chosen models
  target="$(auto_tier)"
  chosen="$(_select_pull_tier "$target" "$avail_gb")"
  log "RAM tier '$target', ${avail_gb} GB free on boot volume → pulling '$chosen'"

  case "$chosen" in
    none)
      warn "boot drive critically low (${avail_gb} GB free) — skipping auto-pull"
      warn "free space, then:  ollama pull llama3.2:3b"
      return 0 ;;
    minimal) models="llama3.2:3b nomic-embed-text" ;;
    *)
      models="$(resolve_tier_models "$chosen")"
      [[ "$chosen" != "$target" ]] && warn "downshifted from '$target' for disk space" ;;
  esac

  local total pulled=0 failed=0 i=0 start; start="$(date +%s)"
  total="$(echo "$models" | wc -w | tr -d ' ')"
  local m
  for m in $models; do
    i=$((i+1))
    if pull_one_model "$m" "$i" "$total" "$start"; then
      pulled=$((pulled+1))
    else
      failed=$((failed+1))
      warn "pull failed for $m (network? offline?) — continuing"
    fi
  done

  if [[ $pulled -eq 0 ]]; then
    warn "no models pulled (likely offline). Daemon is up; pull when online:"
    warn "  ollama pull llama3.2:3b"
  elif [[ $failed -gt 0 ]]; then
    ok "pulled $pulled/$total models ($failed failed — retry with 'nomad upgrade-models')"
  else
    ok "pulled $pulled/$total models into internal store"
  fi
}

# Resolve the drive-backed models dir the way ollama-launcher.sh does. Echoes
# the path, or "" if no drive store is found. KEEP IN SYNC with the launcher
# heredoc in step_ollama_native (the launcher is standalone — it cannot source
# this script — so this logic is intentionally duplicated in exactly two places).
_resolve_drive_models() {
  local configured=""
  [[ -f "$ENV_FILE" ]] && configured="$(grep '^NOMAD_DATA_ROOT=' "$ENV_FILE" | cut -d= -f2-)"
  if [[ -n "$configured" && -d "$configured/ollama-models" ]]; then
    echo "$configured/ollama-models"; return 0
  fi
  local v
  for v in /Volumes/*; do
    if [[ -d "$v/project-nomad/ollama-models" ]]; then
      echo "$v/project-nomad/ollama-models"; return 0
    fi
  done
  echo ""
}

# Resolve the active install bundle dir. Precedence: NOMAD_BUNDLE_DIR in .env
# (recorded at install) > $HERE (this script's own symlink-resolved dir). $HERE
# is the right fallback because the brew symlink resolves to the real bundle.
_resolve_bundle_dir() {
  local recorded=""
  [[ -f "$ENV_FILE" ]] && recorded="$(grep '^NOMAD_BUNDLE_DIR=' "$ENV_FILE" | cut -d= -f2-)"
  if [[ -n "$recorded" ]]; then echo "$recorded"; else echo "$HERE"; fi
}

# Is $1 inside a git working tree? (bundle dir itself or its parent has .git)
_bundle_is_git() {
  local d="$1"
  [[ -d "$d/.git" || -d "$d/../.git" ]] || git -C "$d" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

# Does the git working tree at $1 have uncommitted changes?
_git_tree_dirty() {
  local d="$1"
  [[ -n "$(git -C "$d" status --porcelain 2>/dev/null)" ]]
}

# Validate a freshly-fetched install/macos subtree before swapping it in:
# must contain a bash-shebang nomad that passes syntax check + a man/nomad.1.
# Returns 0 if safe to install, 1 otherwise.
_validate_bundle_subtree() {
  local d="$1"
  [[ -f "$d/nomad" ]] || return 1
  /usr/bin/head -1 "$d/nomad" | /usr/bin/grep -q '^#!.*bash' || return 1
  /bin/bash -n "$d/nomad" 2>/dev/null || return 1
  [[ -f "$d/man/nomad.1" ]] || return 1
  return 0
}

cmd_update() {
  # Flags: --branch NAME. (Dispatcher passes EXTRA_ARGS, whose defensive
  # expansion injects one empty placeholder when no flag was given — absorb it.)
  local branch="${NOMAD_BRANCH:-main}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      "")        shift ;;
      --branch)  branch="$2"; shift 2 ;;
      *) die "usage: nomad update [--branch NAME]" ;;
    esac
  done

  section "Update NOMAD"
  local bundle; bundle="$(_resolve_bundle_dir)"
  [[ -d "$bundle" ]] || die "bundle dir not found: $bundle
Set NOMAD_BUNDLE_DIR in $ENV_FILE or reinstall."
  ok "active bundle: $bundle"

  if _bundle_is_git "$bundle"; then
    # ── git checkout: pull (unless dirty) ──
    local repo; repo="$(git -C "$bundle" rev-parse --show-toplevel 2>/dev/null || echo "$bundle")"
    if _git_tree_dirty "$repo"; then
      warn "git working tree at $repo has uncommitted changes — skipping pull"
      warn "commit/stash and re-run 'nomad update' to fetch the latest"
    else
      log "git pull origin $branch"
      git -C "$repo" fetch origin "$branch" 2>/dev/null || warn "fetch failed — using current checkout"
      git -C "$repo" checkout "$branch" >/dev/null 2>&1 || true
      if git -C "$repo" pull --ff-only origin "$branch" 2>/tmp/nomad-update-pull.log; then
        ok "pulled $branch → $(git -C "$repo" rev-parse --short HEAD)"
      else
        warn "pull not fast-forward — using current checkout ($(cat /tmp/nomad-update-pull.log | tail -1))"
      fi
    fi
  else
    # ── tarball install: fetch whole-repo tarball, extract, validate, swap ──
    if ! /usr/bin/curl -fsS --max-time 5 https://api.github.com >/dev/null 2>&1; then
      die "offline — cannot fetch update. Bundle left untouched."
    fi
    local tgz tmpd
    tgz="$(/usr/bin/mktemp)"; tmpd="$(/usr/bin/mktemp -d)"
    local url="https://codeload.github.com/caweis/project-nomad/tar.gz/refs/heads/$branch"
    log "downloading bundle tarball ($branch)"
    if ! /usr/bin/curl -fsSL --max-time 120 "$url" -o "$tgz"; then
      /bin/rm -rf "$tgz" "$tmpd"; die "download failed: $url — bundle left untouched"
    fi
    /usr/bin/tar -xzf "$tgz" -C "$tmpd" 2>/dev/null \
      || { /bin/rm -rf "$tgz" "$tmpd"; die "extract failed — bundle left untouched"; }
    # codeload extracts to a single top dir: project-nomad-<branch-with-dashes>/
    local sub; sub="$(/usr/bin/find "$tmpd" -type d -path '*/install/macos' -maxdepth 4 | head -1)"
    if [[ -z "$sub" ]] || ! _validate_bundle_subtree "$sub"; then
      /bin/rm -rf "$tgz" "$tmpd"; die "fetched bundle failed validation — current bundle left untouched"
    fi
    log "swapping in validated bundle"
    # rsync the validated subtree over the bundle (preserves the brew symlink,
    # which points at $bundle/nomad). --delete keeps the bundle in sync with the
    # release, but protect runtime drop-ins the bundle accrues.
    if command -v rsync >/dev/null 2>&1; then
      rsync -a --delete --exclude '.env-pointer' "$sub"/ "$bundle"/ \
        || { /bin/rm -rf "$tgz" "$tmpd"; die "swap failed — bundle may be partial; reinstall"; }
    else
      /bin/cp -R "$sub"/. "$bundle"/ \
        || { /bin/rm -rf "$tgz" "$tmpd"; die "swap failed — bundle may be partial; reinstall"; }
    fi
    /bin/chmod +x "$bundle/nomad"
    /bin/rm -rf "$tgz" "$tmpd"
    ok "bundle refreshed from $branch"
  fi

  # ── in-place install via the freshly-updated script (no nuke, no self-update
  #    loop — we just refreshed the bundle ourselves). ──
  log "running in-place install to relink script + man pages and refresh the stack"
  NOMAD_NO_SELF_UPDATE=1 exec /bin/bash "$bundle/nomad" install
}

# Reset the Ollama LaunchAgent — recovery for "bootstrap failed: 5: Input/output
# error" or any other stuck-launchd state. Bootout, kill orphan ollama processes,
# wait for launchd to commit, re-bootstrap, wait for API.
# Use this when 'nomad install' bombs at the LaunchAgent step on a machine that
# had an older buggy NOMAD install previously load the agent.
cmd_reset_ollama() {
  # Flags: --internal forces internal models; --drive forces restore to the
  # data drive (refused if still wedged). No flag = auto-detect. The dispatcher
  # passes EXTRA_ARGS, whose defensive expansion injects one empty placeholder
  # when no flag was given — absorb it (same pattern the old field-desk cmd used).
  local mode="auto"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      "")          shift ;;
      --internal)  mode="internal"; shift ;;
      --drive)     mode="drive";    shift ;;
      *) die "usage: nomad reset-ollama [--internal | --drive]" ;;
    esac
  done

  section "Reset Ollama LaunchAgent"

  # ── Decide the model source BEFORE touching launchd, so the launcher resolves
  #    the right store on its first spawn and the wait-for-API loop never hangs.
  local drive; drive="$(_resolve_drive_models)"
  case "$mode" in
    internal)
      _marker_set
      ok "forcing internal models (~/.ollama/models)"
      ;;
    drive)
      [[ -z "$drive" ]] && die "--drive refused: no data drive / ollama-models found to restore to.
Mount the drive (or run 'nomad install'), then retry."
      if _probe_wedged "$drive/manifests"; then
        die "--drive refused: data drive still wedged at $drive.
Physically unplug/replug the drive, then retry: nomad reset-ollama --drive"
      fi
      _marker_clear
      ok "restoring drive-backed models at $drive"
      ;;
    auto)
      if [[ -n "$drive" ]] && _probe_wedged "$drive/manifests"; then
        _marker_set
        warn "data drive WEDGED at $drive — fell back to internal models"
        warn "physical unplug/replug required; the next 'nomad reset-ollama' auto-restores once healthy"
      elif [[ -n "$drive" ]]; then
        if _marker_present; then
          _marker_clear
          ok "data drive healthy — restored to drive-backed models at $drive"
        fi
      else
        log "no data drive resolved — launcher will use its fallback chain"
      fi
      ;;
  esac

  # 1. Bootout (must happen BEFORE killing process so KeepAlive can't respawn)
  if launchctl print "$LA_TARGET/$LA_LABEL" >/dev/null 2>&1; then
    log "unloading $LA_LABEL"
    launchctl bootout "$LA_TARGET/$LA_LABEL" 2>/dev/null \
      || warn "bootout returned non-zero (continuing — likely already unloaded)"
    sleep 2
  else
    log "$LA_LABEL is not loaded — proceeding to clean up any orphan processes"
  fi

  # 2. Kill any orphan ollama serve processes (KeepAlive can't fight us now)
  if pgrep -f "ollama serve" >/dev/null 2>&1; then
    log "killing orphan 'ollama serve' processes"
    pkill -f "ollama serve" 2>/dev/null || true
    sleep 2
    if pgrep -f "ollama serve" >/dev/null 2>&1; then
      pkill -9 -f "ollama serve" 2>/dev/null || true
      sleep 1
    fi
    pgrep -f "ollama serve" >/dev/null 2>&1 \
      && die "could not kill ollama serve — manual: ps aux | grep ollama"
  fi

  # 3. Confirm :11434 is free
  if lsof -nP -iTCP:11434 -sTCP:LISTEN >/dev/null 2>&1; then
    warn ":11434 still has a listener after the kill"
    lsof -nP -iTCP:11434 -sTCP:LISTEN
    die "free it manually, then re-run: nomad reset-ollama"
  fi
  ok ":11434 free"

  # 4. Plist must exist (if not, user needs to run install which generates it)
  if [[ ! -f "$LA_PLIST" ]]; then
    die "LaunchAgent plist missing at $LA_PLIST
This means NOMAD has never been installed on this machine.
Run: bash nomad install"
  fi
  ok "plist present at $LA_PLIST"

  # 5. Re-bootstrap (with retry on residual I/O error)
  log "bootstrapping LaunchAgent"
  local attempt last_err=""
  for attempt in 1 2 3; do
    if launchctl bootstrap "$LA_TARGET" "$LA_PLIST" 2>/tmp/nomad-bootstrap.log; then
      last_err=""
      break
    fi
    last_err="$(cat /tmp/nomad-bootstrap.log)"
    warn "bootstrap attempt $attempt failed: $last_err"
    launchctl bootout "$LA_TARGET/$LA_LABEL" 2>/dev/null || true
    sleep $((attempt * 2))
  done
  [[ -n "$last_err" ]] && die "bootstrap still failing after 3 attempts: $last_err
Reboot the Mac and try again — this clears all launchd transient state."
  ok "LaunchAgent loaded"

  # 6. Wait for API to come back up
  log "waiting for Ollama API on :11434..."
  local deadline=$(( $(date +%s) + 30 ))
  local api_up=0
  while [[ $(date +%s) -lt $deadline ]]; do
    if curl -fsS http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
      ok "Ollama API responding"
      api_up=1
      break
    fi
    sleep 1
  done
  [[ $api_up -eq 1 ]] || { warn "API not yet responding — tail ~/Library/Logs/nomad-ollama.err.log for hints"; return 0; }

  # 7. If we're running internal (marker present) and the internal store is
  #    empty, auto-pull the tier-appropriate set so chat works immediately.
  if _marker_present; then
    local model_count
    model_count="$(curl -fsS http://127.0.0.1:11434/api/tags 2>/dev/null | jq -r '.models | length' 2>/dev/null || echo 0)"
    if [[ "${model_count:-0}" -eq 0 ]]; then
      _autopull_tier_models
    else
      ok "internal store already has ${model_count} model(s) — no pull needed"
    fi
  fi
  return 0
}

# Benchmark — native Metal Ollama vs container (Rosetta-emulated) Ollama on
# the same Mac, same model, same prompt. The Council's #1 publish-gate ask:
# put one reproducible benchmark number in the README before any "10× faster"
# claim ships.
# Patch admin's latest benchmark row with this Mac's actual host hardware
# (Apple chip + Metal GPU). Containers can't see Metal — admin records empty
# CPU/GPU which then submits as "-" to the upstream leaderboard. This lets
# Mac submissions show real hardware before user clicks Submit in the UI.
cmd_benchmark_patch_host() {
  ensure_docker_path
  api_check_up
  [[ -f "$ENV_FILE" ]] || die ".env missing — run 'nomad install' first"

  # Collect host hardware from macOS, not from inside the container
  local chip cores ram_gb hw_block
  hw_block="$(system_profiler SPHardwareDataType 2>/dev/null)"
  chip="$(echo "$hw_block" | awk -F': *' '/Chip|Processor Name/{print $2; exit}' | xargs)"
  [[ -z "$chip" ]] && chip="$(sysctl -n machdep.cpu.brand_string 2>/dev/null | xargs)"
  cores="$(sysctl -n hw.ncpu)"
  ram_gb=$(( $(sysctl -n hw.memsize) / 1024 / 1024 / 1024 ))

  # GPU: on Apple Silicon, the GPU is integrated into the SoC (e.g. "Apple M4 (Metal)").
  # On Intel Macs there's a discrete or integrated GPU that we'd want to detect separately.
  local gpu_model
  if [[ "$(uname -m)" == "arm64" && -n "$chip" ]]; then
    gpu_model="$chip (Metal)"
  else
    gpu_model="$(system_profiler SPDisplaysDataType 2>/dev/null | awk -F': *' '/Chipset Model/{print $2; exit}' | xargs)"
    [[ -z "$gpu_model" ]] && gpu_model="(unknown)"
  fi

  log "Host hardware (macOS, real values, not container-view):"
  log "  CPU:    $chip"
  log "  Cores:  $cores"
  log "  GPU:    $gpu_model"
  log "  RAM:    ${ram_gb} GB"
  echo

  local db_pw; db_pw="$(grep '^DB_PASSWORD=' "$ENV_FILE" | cut -d= -f2-)"

  # Verify there IS a latest benchmark row to patch
  local row_count
  row_count="$(echo 'SELECT COUNT(*) FROM benchmark_results;' \
    | dc exec -T -e MYSQL_PWD="$db_pw" mysql mysql -u nomad_user --silent --skip-column-names nomad 2>/dev/null \
    | tr -d '[:space:]')"
  if [[ -z "$row_count" || "$row_count" == "0" ]]; then
    die "no benchmark_results in admin DB — run a benchmark from admin UI first (Settings → Benchmark)"
  fi

  log "patching latest of $row_count benchmark row(s) with host hardware..."
  # Single-quote the values for SQL safety (chip names are stable strings)
  local sql
  sql="UPDATE benchmark_results
       SET cpu_model = '$chip',
           cpu_cores = $cores,
           cpu_threads = $cores,
           gpu_model = '$gpu_model'
       WHERE id = (
         SELECT id FROM (
           SELECT id FROM benchmark_results ORDER BY id DESC LIMIT 1
         ) AS latest
       );"

  if echo "$sql" | dc exec -T -e MYSQL_PWD="$db_pw" mysql mysql -u nomad_user nomad >/tmp/nomad-bench-patch.log 2>&1; then
    ok "patched"
    # Show the patched row for confirmation
    echo
    echo 'SELECT id, cpu_model, cpu_cores, gpu_model, cpu_score, submitted_to_repository FROM benchmark_results ORDER BY id DESC LIMIT 1;' \
      | dc exec -T -e MYSQL_PWD="$db_pw" mysql mysql -u nomad_user --table nomad 2>/dev/null | sed 's/^/    /'
    echo
    log "now click Submit in admin UI (Settings → Benchmark) and upstream will see the real hardware."
    log "or if you've already submitted: re-run benchmark + patch-host + submit."
  else
    cat /tmp/nomad-bench-patch.log
    die "SQL update failed — see above"
  fi
}

cmd_benchmark() {
  local sub="${1:-run}"
  case "$sub" in
    patch-host) cmd_benchmark_patch_host; return 0 ;;
    run|"")     ;;  # fall through to native-vs-container comparison
    *)          die "usage: nomad benchmark [run|patch-host] [MODEL]" ;;
  esac
  shift 2>/dev/null || true
  local model="${1:-llama3.1:8b}"
  local prompt="Write a one-paragraph plain-English explanation of how ocean tides work."
  ensure_docker_path
  ensure_ollama_path || die "ollama not found anywhere — run 'nomad install' first"

  section "Benchmark — $model — native Metal vs container Rosetta"
  log "prompt: \"$prompt\""
  echo

  # ---- NATIVE ----
  log "[1/2] native Ollama (Metal)"
  if ! ollama list 2>/dev/null | awk '{print $1}' | grep -qE "^${model}$"; then
    log "pulling $model into native Ollama (~5 GB)..."
    ollama pull "$model"
  fi
  local native_log; native_log="$(mktemp)"
  echo "$prompt" | ollama run --verbose "$model" >"$native_log" 2>&1
  local native_eval_rate native_total_dur
  native_eval_rate="$(grep -E "eval rate" "$native_log" | tail -1 | grep -oE '[0-9.]+ tokens/s' || echo "?")"
  native_total_dur="$(grep -E "total duration" "$native_log" | tail -1 | awk '{print $NF}' || echo "?")"
  ok "native: $native_eval_rate (total wall time $native_total_dur)"

  # ---- CONTAINER (Rosetta) ----
  log "[2/2] container Ollama (linux/amd64 via Rosetta)"
  local cname=nomad_bench_ollama
  docker rm -f "$cname" >/dev/null 2>&1 || true
  log "starting $cname (forced platform=linux/amd64)..."
  docker run -d --rm --name "$cname" \
    --platform linux/amd64 \
    -p 11435:11434 \
    -v "/tmp/nomad-bench-models:/root/.ollama" \
    ollama/ollama:latest >/dev/null
  # Wait for the container's Ollama API
  log "waiting for container Ollama to come up (slow under Rosetta)..."
  local d=$(( $(date +%s) + 60 ))
  while [[ $(date +%s) -lt $d ]]; do
    docker exec "$cname" curl -fsS http://127.0.0.1:11434/api/tags >/dev/null 2>&1 && break
    sleep 2
  done
  log "pulling $model into container Ollama (~5 GB, slow under Rosetta)..."
  docker exec "$cname" ollama pull "$model"
  local container_log; container_log="$(mktemp)"
  docker exec -i "$cname" sh -c "echo '$prompt' | ollama run --verbose $model" >"$container_log" 2>&1
  local cont_eval_rate cont_total_dur
  cont_eval_rate="$(grep -E "eval rate" "$container_log" | tail -1 | grep -oE '[0-9.]+ tokens/s' || echo "?")"
  cont_total_dur="$(grep -E "total duration" "$container_log" | tail -1 | awk '{print $NF}' || echo "?")"
  ok "container: $cont_eval_rate (total wall time $cont_total_dur)"
  docker stop "$cname" >/dev/null 2>&1 || true

  # ---- REPORT ----
  cat <<EOF

${C_HEAD}── Benchmark Result ($(sw_vers -productVersion) on $(uname -m)) ──${C_OFF}

  Model:           $model
  Native (Metal):     $native_eval_rate     (total ${native_total_dur})
  Container (Rosetta): $cont_eval_rate    (total ${cont_total_dur})

Markdown for the README:

| Path                 | Eval rate         | Total wall time |
|----------------------|-------------------|-----------------|
| Native Ollama (Metal) | $native_eval_rate | $native_total_dur |
| Container (Rosetta) | $cont_eval_rate | $cont_total_dur |

Hardware: $(sw_vers -productVersion), $(uname -m), $(( $(sysctl -n hw.memsize) / 1024 / 1024 / 1024 )) GB RAM.
Model: $model. Prompt: "$prompt"

EOF
  rm -f "$native_log" "$container_log"
}

# System info via API
cmd_system() {
  api_check_up
  local sub="${1:-info}"
  case "$sub" in
    info)     api_get /api/system/info | jq . ;;
    debug)    api_get /api/system/debug-info | jq . ;;
    internet) api_get /api/system/internet-status | jq . ;;
    *)        die "usage: nomad system [info|debug|internet]" ;;
  esac
}

# Manual trigger of the kiwix self-heal pass (the LaunchAgent runs this every
# 60s automatically; this command does the same work immediately + verbosely).
# Useful for: quick fix when you don't want to wait for the next 60s tick;
# diagnostic output to confirm what was quarantined and why kiwix was failing.
# Also reads the action log so you can see prior auto-runs.
cmd_fix_kiwix() {
  section "Kiwix self-heal — manual trigger"

  if [[ ! -x "$KIWIX_SELF_HEAL_SCRIPT" ]]; then
    die "self-heal script not installed: $KIWIX_SELF_HEAL_SCRIPT
Run 'nomad install' to install the LaunchAgent + script, or run the
one-shot installer at ~/Desktop/Project Nomad/install-kiwix-self-heal.command"
  fi

  ensure_docker_path
  if ! docker inspect nomad_kiwix_server >/dev/null 2>&1; then
    die "no nomad_kiwix_server container. Bring the stack up with 'nomad up' first,
or wait for admin to spawn kiwix once a ZIM finishes downloading."
  fi

  # Show current state before acting
  log "current kiwix state:"
  docker ps -a --filter name=nomad_kiwix --format '  {{.Names}}\t{{.Status}}'
  echo

  # Trigger the self-heal script. The script is silent when kiwix is healthy
  # and only acts/logs when there's a partial-ZIM problem.
  log "running self-heal pass (silent if kiwix is already healthy)..."
  "$KIWIX_SELF_HEAL_SCRIPT"
  echo

  # Show what got logged this run + last few prior runs
  local action_log="$HOME/Library/Logs/nomad-kiwix-self-heal.action.log"
  if [[ -f "$action_log" ]]; then
    log "recent action-log entries (last 30 lines):"
    tail -30 "$action_log" | sed 's/^/  /'
  else
    ok "no action log yet — kiwix has been healthy on every check"
  fi
  echo

  # Confirm final state
  log "final kiwix state:"
  docker ps -a --filter name=nomad_kiwix --format '  {{.Names}}\t{{.Status}}'
  local port
  port="$(docker port nomad_kiwix_server 8080 2>/dev/null | awk -F: '{print $2}' | head -1)"
  if [[ -n "$port" ]] && curl -fsS --max-time 4 "http://localhost:$port/" -o /dev/null 2>/dev/null; then
    ok "kiwix HTTP responding on http://localhost:$port"
  else
    warn "kiwix HTTP not responding. The 60s LaunchAgent will keep trying;"
    warn "if the issue persists, inspect: docker logs nomad_kiwix_server --tail 50"
  fi
  echo

  # Show the quarantine state so user knows what's been moved aside
  local env_file="$HOME/.config/project-nomad/.env"
  if [[ -f "$env_file" ]]; then
    local data_root
    data_root="$(grep '^NOMAD_DATA_ROOT=' "$env_file" | cut -d= -f2-)"
    local quarantine="$data_root/storage/zim-inprogress"
    if [[ -d "$quarantine" ]]; then
      local count
      count="$(ls "$quarantine"/*.zim 2>/dev/null | wc -l | tr -d ' ')"
      log "quarantine: $quarantine ($count file(s))"
      [[ "$count" -gt 0 ]] && ls -1 "$quarantine"/*.zim 2>/dev/null | xargs -n1 basename | sed 's/^/  /'
    fi
  fi
}

# SysAdminDoc/project-nomad-desktop is a separate product (NOMAD Field Desk) —
# different architecture, broader survival-domain features. Coexists cleanly:
# both apps default to :8080 but Field Desk respects NOMAD_PORT, and both want
# Ollama on :11434 (good — single Metal daemon serves both). Pattern at
# SysAdminDoc/project-nomad-desktop#3.
cmd_uninstall_field_desk() {
  section "Uninstall NOMAD Field Desk"

  local target="$HOME/Applications/NOMADFieldDesk-macOS"
  local removed_anything=0

  # 1. Stop the process if it's running
  if pgrep -f "NOMADFieldDesk-macOS" >/dev/null 2>&1; then
    log "stopping running Field Desk process"
    pkill -f "NOMADFieldDesk-macOS" 2>/dev/null || true
    sleep 1
    removed_anything=1
    ok "Field Desk process stopped"
  else
    ok "no running Field Desk process"
  fi

  # 2. Remove the binary
  if [[ -f "$target" ]]; then
    rm -f "$target" && { ok "removed binary: $target"; removed_anything=1; }
  else
    ok "no binary at $target"
  fi

  # 3. Surface (but don't auto-remove) Field Desk's own data dirs.
  # Field Desk stores its SQLite DB + caches somewhere under the user's
  # home dir. Names vary across Field Desk versions; we report what's
  # there and let the user decide. We do NOT touch ~/.config/project-nomad
  # (that's our install) or any Obsidian/Topo vault.
  local found=()
  for path in \
      "$HOME/Library/Application Support/NOMAD" \
      "$HOME/Library/Application Support/NOMAD Field Desk" \
      "$HOME/Library/Application Support/NOMADFieldDesk" \
      "$HOME/Library/Application Support/project-nomad-desktop" \
      "$HOME/Library/Caches/NOMAD" \
      "$HOME/Library/Caches/NOMADFieldDesk" \
      "$HOME/Library/Logs/NOMAD" \
      "$HOME/Library/Logs/NOMADFieldDesk" \
      "$HOME/.nomad" \
      "$HOME/.nomadfielddesk"; do
    [[ -e "$path" ]] && found+=("$path")
  done

  if [[ ${#found[@]} -gt 0 ]]; then
    echo
    warn "Found data dirs that COULD belong to Field Desk:"
    for p in "${found[@]}"; do
      local size; size="$(du -sh "$p" 2>/dev/null | awk '{print $1}')"
      echo "  $size  $p"
    done
    echo
    warn "Inspect each before removing — Field Desk's storage layout varies"
    warn "by version, and these names overlap with other potential apps."
    warn "Manual remove: rm -rf <path>"
  else
    ok "no Field Desk data dirs detected at standard paths"
  fi

  echo
  if [[ $removed_anything -eq 1 ]]; then
    ok "Field Desk uninstalled. Native Ollama on :11434 untouched (still"
    ok "serves the Crosstalk admin and any other consumer)."
  else
    ok "nothing to uninstall — Field Desk wasn't installed."
  fi
}

cmd_install_field_desk() {
  local port="${NOMAD_FIELD_DESK_PORT:-8081}"
  local target="$HOME/Applications/NOMADFieldDesk-macOS"
  local url="https://github.com/SysAdminDoc/project-nomad-desktop/releases/latest/download/NOMADFieldDesk-macOS"
  local sha_url="https://github.com/SysAdminDoc/project-nomad-desktop/releases/latest/download/SHA256SUMS.txt"
  local foreground=0 force=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      "")             shift ;;   # absorb empty placeholder from dispatcher's "${EXTRA_ARGS[@]:-}" defensive expansion
      --port)         port="$2"; shift 2 ;;
      --foreground)   foreground=1; shift ;;
      --force)        force=1; shift ;;
      *) die "usage: nomad install-field-desk [--port PORT] [--foreground] [--force]" ;;
    esac
  done

  # Refuse the port if already in use by something other than Field Desk itself
  if lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
    local owner
    owner="$(lsof -nP -iTCP:"$port" -sTCP:LISTEN | awk 'NR==2 {print $1}')"
    if [[ "$owner" != NOMADField* && "$owner" != "Python" ]]; then
      die ":$port already in use by $owner — pass --port with a free port"
    fi
    warn "Field Desk-like process already on :$port ($owner) — re-launching anyway"
  fi

  # Sanity-check the upstream Crosstalk admin (informational, not fatal)
  if curl -fsS --max-time 2 http://127.0.0.1:8080/api/health >/dev/null 2>&1; then
    ok "Crosstalk admin responding on :8080 — Ollama on :11434 will be shared"
  else
    warn "Crosstalk admin not on :8080 — Field Desk will run alone (still works)"
  fi

  # Sanity-check Ollama (Field Desk needs it for the AI Chat tab)
  if curl -fsS --max-time 2 http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
    ok "Ollama serving on :11434 — Field Desk's AI Chat will use it"
  else
    warn "Ollama not on :11434 — AI Chat won't work until 'nomad up' or 'nomad reset-ollama'"
  fi

  # Download the binary if missing or --force
  mkdir -p "$(dirname "$target")"
  if [[ ! -x "$target" || $force -eq 1 ]]; then
    log "downloading Field Desk → $target"
    curl -fL --progress-bar -o "$target.tmp" "$url" \
      || die "download failed — check network or fetch manually: $url"
    chmod +x "$target.tmp"

    # SHA256 verify against the release's SHA256SUMS.txt — defense in depth
    local sha_file expected actual
    sha_file="$(mktemp)"
    if curl -fsS -o "$sha_file" "$sha_url"; then
      expected="$(awk '/NOMADFieldDesk-macOS$/ {print $1}' "$sha_file")"
      actual="$(shasum -a 256 "$target.tmp" | awk '{print $1}')"
      if [[ -n "$expected" && "$expected" != "$actual" ]]; then
        rm -f "$target.tmp" "$sha_file"
        die "SHA256 mismatch — expected $expected, got $actual"
      fi
      ok "SHA256 verified ($actual)"
    else
      warn "couldn't fetch SHA256SUMS.txt — proceeding without verify"
    fi
    rm -f "$sha_file"
    mv "$target.tmp" "$target"
  else
    ok "Field Desk already at $target  (use --force to redownload)"
  fi

  # Launch on a non-conflicting port. NOMAD_HOST=127.0.0.1 keeps it loopback-only
  # per their security posture; user can override their .env for LAN sharing.
  log "starting Field Desk on http://127.0.0.1:$port  (Ollama shared from :11434)"
  if [[ $foreground -eq 1 ]]; then
    NOMAD_PORT="$port" NOMAD_OLLAMA_PORT=11434 NOMAD_HOST=127.0.0.1 "$target"
  else
    nohup env NOMAD_PORT="$port" NOMAD_OLLAMA_PORT=11434 NOMAD_HOST=127.0.0.1 \
      "$target" >/dev/null 2>&1 &
    local fd_pid=$!
    disown "$fd_pid" 2>/dev/null || true
    sleep 2
    if kill -0 "$fd_pid" 2>/dev/null; then
      ok "Field Desk pid $fd_pid → http://127.0.0.1:$port"
      ok "to stop later: kill $fd_pid  (or close from menu bar)"
      open "http://127.0.0.1:$port" 2>/dev/null || true
    else
      die "Field Desk exited on launch — re-run with --foreground to see stderr"
    fi
  fi
}

# Workshop / Offline STL Library — host-side CLI.
# Subcommands:
#   nomad stl scan                   Trigger an admin-side rescan of the library.
#                                    Same code path as the UI's Rescan button.
#   nomad stl import <DIR> [CAT]     Copy every .stl/.3mf from <DIR> into
#                                    ${NOMAD_DATA_ROOT}/storage/stl-library/<CAT>/
#                                    and trigger a rescan. CAT defaults to 'other'.
#   nomad stl list                   Show what's indexed (calls admin API).
#   nomad stl path                   Print the absolute library root on the host.
cmd_stl() {
  local sub="${1:-list}"
  shift || true

  # Resolve the host-side library root from .env (NOMAD_DATA_ROOT). The
  # subcommands need this for file copies + path display.
  local data_root library_root
  if [[ -f "$ENV_FILE" ]]; then
    data_root="$(grep '^NOMAD_DATA_ROOT=' "$ENV_FILE" 2>/dev/null | cut -d= -f2-)"
  fi
  if [[ -z "${data_root:-}" ]]; then
    die "NOMAD_DATA_ROOT not set in $ENV_FILE — run 'nomad install' first"
  fi
  library_root="$data_root/storage/stl-library"

  case "$sub" in
    path)
      echo "$library_root"
      ;;
    list)
      api_check_up
      api_get /api/workshop?per_page=200 | jq '.files // .' 2>/dev/null || true
      ;;
    scan)
      api_check_up
      log "triggering Workshop rescan..."
      local result
      result="$(api_post /api/workshop/scan '' 2>&1)"
      echo "$result" | jq . 2>/dev/null || echo "$result"
      ;;
    import)
      local src_dir="${1:-}"
      local category="${2:-other}"
      [[ -z "$src_dir" ]] && die "usage: nomad stl import <DIR> [CATEGORY]
Categories: medical | tools | household | replacement-parts | agriculture | firearm-accessories | other"
      [[ ! -d "$src_dir" ]] && die "not a directory: $src_dir"

      # Validate category against the seven known values. Falls back to 'other'
      # with a warning rather than aborting — the user can fix it in the UI.
      case "$category" in
        medical|tools|household|replacement-parts|agriculture|firearm-accessories|other)
          : ;;
        *)
          warn "unknown category '$category' — using 'other'. Edit in Workshop UI to recategorize."
          category="other"
          ;;
      esac

      local dest_dir="$library_root/$category"
      mkdir -p "$dest_dir" || die "couldn't create $dest_dir — is the data drive mounted?"

      # Walk src_dir for .stl/.3mf and copy into category subdir.
      # Using cp -n (no-clobber) so re-running import doesn't overwrite existing
      # files in the library — manual fix is to delete from Workshop UI first.
      local count=0 skipped=0
      while IFS= read -r src; do
        local base; base="$(basename "$src")"
        if [[ -e "$dest_dir/$base" ]]; then
          warn "skipping $base — already exists in $category/"
          skipped=$((skipped + 1))
          continue
        fi
        cp "$src" "$dest_dir/$base" && count=$((count + 1))
      done < <(find "$src_dir" -type f \( -iname '*.stl' -o -iname '*.3mf' \) 2>/dev/null)

      ok "imported $count file(s) → $dest_dir  (skipped $skipped existing)"

      # Trigger rescan if admin is up; otherwise tell the user how to run it.
      if curl -fsS --max-time 2 http://127.0.0.1:8080/api/health >/dev/null 2>&1; then
        log "triggering Workshop rescan..."
        api_post /api/workshop/scan '' | jq . 2>/dev/null || true
      else
        warn "admin not running — rescan will happen on next 'nomad up' + UI visit"
      fi
      ;;
    *)
      die "unknown subcommand: $sub
usage: nomad stl [scan|import DIR [CATEGORY]|list|path]" ;;
  esac
}

# Free disk space and clean up install-generated detritus without touching any
# of the data or state the user wants to keep. Removes:
#   • /tmp/nomad-*.log  (compose pull logs, bootstrap logs, etc.)
#   • $COMPOSE_BASE.bak (sed-injection backups from amd64 fallback path)
#   • quarantined partial ZIMs in $DATA_ROOT/storage/zim-inprogress/
#   • dangling Docker images + builder cache (only the dangling ones — never
#     a running image)
#   • stopped (non-running) admin-spawned content containers
# Does NOT touch: ollama models, downloaded ZIMs, mysql/redis data, .env,
# LaunchAgents, or any container that's currently running.
#
# Subcommands:
#   nomad clean         show what would be cleaned, no action (dry run)
#   nomad clean --apply actually clean
cmd_clean() {
  local apply=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --apply|--yes|-y) apply=1; shift ;;
      "") shift ;;  # tolerate the empty-arg shim from the dispatcher
      *) die "unknown arg: $1   (use --apply to act, otherwise it's a dry run)" ;;
    esac
  done
  section "Clean — $( ((apply)) && echo 'applying' || echo 'dry run (pass --apply to act)')"

  local total_freed=0
  local action_prefix; ((apply)) && action_prefix="removed" || action_prefix="would remove"

  # 1. /tmp logs
  local tmp_logs
  tmp_logs="$(ls /tmp/nomad-*.log 2>/dev/null || true)"
  if [[ -n "$tmp_logs" ]]; then
    local tmp_count tmp_size
    tmp_count="$(echo "$tmp_logs" | wc -l | tr -d ' ')"
    tmp_size="$(echo "$tmp_logs" | xargs -I{} du -k {} 2>/dev/null | awk '{s+=$1} END {print s}')"
    log "$action_prefix $tmp_count /tmp/nomad-*.log file(s) (~${tmp_size:-0} KB)"
    ((apply)) && rm -f /tmp/nomad-*.log
    total_freed=$(( total_freed + ${tmp_size:-0} ))
  else
    dim "  no /tmp/nomad-*.log files"
  fi

  # 2. compose.yaml.bak from sed-injection fallback
  if [[ -f "$COMPOSE_BASE.bak" ]]; then
    local bak_size
    bak_size="$(du -k "$COMPOSE_BASE.bak" 2>/dev/null | awk '{print $1}')"
    log "$action_prefix $COMPOSE_BASE.bak (~${bak_size:-0} KB)"
    ((apply)) && rm -f "$COMPOSE_BASE.bak"
    total_freed=$(( total_freed + ${bak_size:-0} ))
  else
    dim "  no $COMPOSE_BASE.bak"
  fi

  # 3. Quarantined partial ZIMs (kiwix-self-heal moves these aside; they're
  # broken downloads that the user can either redownload or delete)
  if [[ -f "$ENV_FILE" ]]; then
    local data_root quarantine
    data_root="$(grep '^NOMAD_DATA_ROOT=' "$ENV_FILE" 2>/dev/null | cut -d= -f2-)"
    quarantine="$data_root/storage/zim-inprogress"
    if [[ -d "$quarantine" ]]; then
      local q_count q_size
      q_count="$(ls "$quarantine"/*.zim 2>/dev/null | wc -l | tr -d ' ')"
      if [[ "$q_count" -gt 0 ]]; then
        q_size="$(du -sk "$quarantine" 2>/dev/null | awk '{print $1}')"
        log "$action_prefix $q_count quarantined partial ZIM(s) in $quarantine (~$((${q_size:-0} / 1024)) MB)"
        ((apply)) && rm -f "$quarantine"/*.zim
        total_freed=$(( total_freed + ${q_size:-0} ))
      else
        dim "  no quarantined ZIMs"
      fi
    fi
  fi

  # 4. Dangling Docker images + builder cache. Skip if docker isn't reachable.
  if ensure_docker_path && docker version >/dev/null 2>&1; then
    local img_count
    img_count="$(docker images --filter "dangling=true" -q 2>/dev/null | wc -l | tr -d ' ')"
    if [[ "$img_count" -gt 0 ]]; then
      log "$action_prefix $img_count dangling Docker image(s)"
      ((apply)) && docker image prune -f >/dev/null 2>&1
    else
      dim "  no dangling Docker images"
    fi
    local builder_size
    builder_size="$(docker builder du 2>/dev/null | awk 'NR==2{print $2}')"
    if [[ -n "$builder_size" && "$builder_size" != "0B" ]]; then
      log "$action_prefix Docker builder cache ($builder_size)"
      ((apply)) && docker builder prune -f >/dev/null 2>&1
    else
      dim "  no builder cache"
    fi

    # 5. Stopped admin-spawned content containers (kiwix_*, kolibri, flatnotes,
    # cyberchef — admin re-spawns these on demand, stopped ones are fossilized
    # from past sessions and just hold image refs)
    local stopped_admin_containers
    stopped_admin_containers="$(docker ps -a --format '{{.Names}}\t{{.State}}' 2>/dev/null \
      | awk -F'\t' '$2!="running" && /^(nomad_kiwix|nomad_kolibri|nomad_cyberchef|nomad_flatnotes|kiwix_server_)/ {print $1}')"
    if [[ -n "$stopped_admin_containers" ]]; then
      local sc_count
      sc_count="$(echo "$stopped_admin_containers" | wc -l | tr -d ' ')"
      log "$action_prefix $sc_count stopped admin-spawned container(s):"
      echo "$stopped_admin_containers" | sed 's/^/    /'
      ((apply)) && echo "$stopped_admin_containers" | xargs -I{} docker rm {} >/dev/null 2>&1
    else
      dim "  no stopped admin-spawned containers"
    fi
  else
    dim "  Docker not reachable — skipping image/container cleanup"
  fi

  echo
  if ((apply)); then
    ok "clean complete (~$((total_freed / 1024)) MB freed; Docker cache freed separately)"
  else
    log "dry run — pass --apply to actually clean. ~$((total_freed / 1024)) MB on disk + Docker cache."
  fi
}

# ─── arg parsing + dispatch ───────────────────────────────────────────────────
DATA_ROOT_ARG=""
BACKEND_ARG=""         # explicit --backend omlx|ollama; empty = use recommendation
TIER="auto"            # auto | tiny | small | medium | large | xl | dreamy
MODELS=""              # if non-empty, overrides tier resolution
SKIP_MODELS=0
# Track which model-related flags the user explicitly passed. Without these
# markers we can't tell "user said --tier auto" from "user didn't pass --tier"
# — both end up TIER=auto. The model-picker prompt skips when the user has
# already declared intent on the command line.
TIER_EXPLICIT=0
MODELS_EXPLICIT=0
SKIP_MODELS_EXPLICIT=0

# When sourced by the unit-test harness, stop here: callers get every function
# definition above without running arg-parsing, the self-update gate, or dispatch.
if [[ -n "${NOMAD_SOURCE_FOR_TEST:-}" ]]; then
  return 0 2>/dev/null || true
fi

ORIGINAL_ARGS=("$@")
CMD="${1:-help}"
[[ $# -gt 0 ]] && shift
while [[ $# -gt 0 ]]; do
  case "$1" in
    --backend)    [[ -n "${2:-}" ]] || die "--backend needs a value (omlx|ollama)"; BACKEND_ARG="$2"; shift 2 ;;
    --data-root)  DATA_ROOT_ARG="$2"; shift 2 ;;
    --tier)       TIER="$2"; TIER_EXPLICIT=1; shift 2 ;;
    --models)     MODELS="$2"; MODELS_EXPLICIT=1; shift 2 ;;
    --no-models)  SKIP_MODELS=1; SKIP_MODELS_EXPLICIT=1; shift ;;
    --yes|-y)     NOMAD_YES=1; shift ;;
    --help|-h)    CMD="help"; shift ;;
    *)            EXTRA_ARGS+=("$1"); shift ;;
  esac
done

# Resolve final model list: --models takes precedence; otherwise resolve tier
if [[ -z "$MODELS" ]]; then
  MODELS="$(resolve_tier_models "$TIER")"
fi
EXTRA_ARGS=("${EXTRA_ARGS[@]:-}")

# Self-update gate — runs ONLY for install/reinstall/self-update.
# For everything else (check, up, restart, upgrade, etc.), we skip the
# 30s round-trip and use the local script as-is.
case "$CMD" in
  install|reinstall|self-update) self_update_nomad; self_update_compose ;;
  refresh-compose) self_update_compose ;;
esac

case "$CMD" in
  install)         cmd_install ;;
  check)           cmd_check "${EXTRA_ARGS[0]:-all}" ;;
  up)              cmd_up ;;
  down)            cmd_down ;;
  restart)         cmd_restart "${EXTRA_ARGS[0]:-admin}" ;;
  logs)            cmd_logs    "${EXTRA_ARGS[0]:-admin}" ;;
  models)          cmd_models   "${EXTRA_ARGS[@]}" ;;
  upgrade)         cmd_upgrade "${EXTRA_ARGS[@]}" ;;
  upgrade-models)  cmd_upgrade_models ;;
  update)          cmd_update "${EXTRA_ARGS[@]}" ;;
  downloads)       cmd_downloads "${EXTRA_ARGS[@]:-list}" ;;
  zim)             cmd_zim       "${EXTRA_ARGS[@]:-list}" ;;
  stl)             cmd_stl       "${EXTRA_ARGS[@]:-list}" ;;
  services)        cmd_services  "${EXTRA_ARGS[@]:-list}" ;;
  system)          cmd_system    "${EXTRA_ARGS[@]:-info}" ;;
  api)             cmd_api       "${EXTRA_ARGS[@]}" ;;
  benchmark)       cmd_benchmark "${EXTRA_ARGS[@]}" ;;
  orbstack-tune)   cmd_orbstack_tune "${EXTRA_ARGS[@]}" ;;
  reset-ollama)    cmd_reset_ollama "${EXTRA_ARGS[@]}" ;;
  fix-kiwix)       cmd_fix_kiwix ;;
  clean)           cmd_clean "${EXTRA_ARGS[@]}" ;;
  uninstall)       cmd_uninstall ;;
  reinstall)       cmd_reinstall ;;
  self-update)     ok "nomad script is up to date" ;;
  install-bridge)
    # Targeted install of just the host-command-bridge LaunchAgent —
    # for users who don't want to do a full `nomad reinstall` just to
    # pick up a newly-added LaunchAgent. Idempotent.
    sudo_bootstrap >/dev/null 2>&1 || true
    step_install_host_command_bridge
    ;;
  refresh-compose)
    # Already handled by the self-update gate above (which dispatched
    # self_update_compose). This case is just so dispatch doesn't fall
    # through to the unknown-command die().
    ok "compose.yaml refresh complete (run 'nomad down && nomad up' to apply)"
    ;;
  install-field-desk)   cmd_install_field_desk "${EXTRA_ARGS[@]}" ;;
  uninstall-field-desk) cmd_uninstall_field_desk ;;
  help|--help|-h)
    sed -n '2,61p' "$0" | sed 's/^# //; s/^#//'
    echo
    echo "Full reference: man nomad   (per-command: man nomad-<command>, e.g. man nomad-zim)"
    ;;
  *) die "unknown command: $CMD
Run 'nomad help' for usage." ;;
esac
