  esac
}

# Interactive picker shown once at install time. Walks the user through:
#   (1) here's what your Mac auto-detects to, and what's in that tier;
#   (2) accept, change tier, or skip.
# Skipped (using the auto-detected tier) when:
#   - --yes was passed (unattended run);
#   - --models was passed (user supplied an explicit list);
#   - --tier was passed (user already chose a tier);
#   - --no-models was passed (user wants to skip).
# Mutates TIER and SKIP_MODELS in-place so subsequent steps pick up the choice.
prompt_for_models() {
  # Honor explicit-intent flags ONLY: if the user already said what they
  # want via --tier, --models, or --no-models, don't pester them.
  #
  # NOTE: NOMAD_YES is INTENTIONALLY NOT checked here. NOMAD_YES means
  # "skip destructive confirmations" (e.g., wipe data drive on reinstall);
  # it does NOT mean "use defaults for every choice." The picker is a
  # configuration choice, not a destructive confirm. Previous version of
  # this function gated on NOMAD_YES, which broke the picker on the most
  # common path (`nomad reinstall`, which sets NOMAD_YES=1 internally to
  # auto-confirm the wipe). Chris caught this 2026-05-11: he ran reinstall
  # expecting the picker, got auto-tier model downloads instead. Fixed by
  # removing the NOMAD_YES guard so the picker runs on every interactive
  # install, including reinstall.
  #
  # Truly-unattended installs that want to skip the picker should pass
  # --tier auto (or any explicit value) instead of relying on --yes.
  [[ "$TIER_EXPLICIT" -eq 1 ]] && return 0
  [[ "$MODELS_EXPLICIT" -eq 1 ]] && return 0
  [[ "$SKIP_MODELS_EXPLICIT" -eq 1 ]] && return 0

  local ram_gb auto_t resolved_tier models_in_tier
  ram_gb=$(( $(sysctl -n hw.memsize) / 1024 / 1024 / 1024 ))
  auto_t="$(auto_tier)"
  resolved_tier="$auto_t"
  models_in_tier="$(resolve_tier_models "$auto_t")"

  section "Model selection"
  echo "  Detected: ${ram_gb} GB RAM → auto-tier '${auto_t}' (~$(tier_size_gb "$auto_t") GB total)"
  echo
  echo "  Models in this tier:"
  for m in $models_in_tier; do
    printf "    %-22s ~%4s GB    %s\n" "$m" "$(_model_size_gb "$m")" "$(_model_blurb "$m")"
  done
  echo
  echo "  Choices:"
  echo "    [Y]  pull these now (default)"
  echo "    [tiny|small|medium|large|xl|dreamy]   pick a different tier"
  echo "    [n]  skip — install without models. Pull later with 'nomad models pull <tier>'."
  echo
  read -r -p "  Choice [Y]: " choice
  choice="$(echo "$choice" | tr '[:upper:]' '[:lower:]' | xargs)"

  case "$choice" in
    ""|y|yes)
      log "using auto-tier '$auto_t'"
      # TIER stays "auto"; resolve_tier_models was already called by the dispatcher.
      ;;
    n|no|skip)
      SKIP_MODELS=1
      warn "models will NOT be pulled. Run 'nomad models pull $auto_t' later to install them."
      ;;
    tiny|small|medium|large|xl|dreamy)
      TIER="$choice"
      MODELS="$(resolve_tier_models "$choice")"
      log "switched to tier '$choice' (~$(tier_size_gb "$choice") GB total)"
      # If user picked a larger tier than their RAM auto-resolves to, defer
      # to warn_if_tier_above_auto to give them one more chance to back off.
      ;;
    *)
      warn "didn't understand '$choice' — using auto-tier '$auto_t'"
      ;;
  esac
  echo
}

warn_if_tier_above_auto() {
  [[ "$TIER" == "auto" ]] && return 0
  local auto_t; auto_t="$(auto_tier)"
  local order=(tiny small medium large xl dreamy)
  local auto_idx=-1 picked_idx=-1 i=0
  for t in "${order[@]}"; do
    [[ "$t" == "$auto_t" ]] && auto_idx=$i
    [[ "$t" == "$TIER"   ]] && picked_idx=$i
    i=$((i+1))
  done
  if [[ "$picked_idx" -gt "$auto_idx" ]]; then
    local ram_gb; ram_gb=$(( $(sysctl -n hw.memsize) / 1024 / 1024 / 1024 ))
    echo
    warn "you picked --tier $TIER but your ${ram_gb} GB Mac auto-resolves to '$auto_t'."
    warn "Models in '$TIER' use up to $(tier_size_gb "$TIER") GB RAM at peak."
    warn "Inference will be slow and may swap to disk during chat."
    if ! confirm "Continue with --tier $TIER anyway?"; then
      die "aborted — try 'nomad install --tier $auto_t' for auto-sized models"
    fi
    log "proceeding with oversized tier — you've been warned"
  fi
}

# Interactive AI-backend picker — mirrors prompt_for_models. Sets BACKEND.
# Non-interactive (BACKEND_ARG set) skips the prompt. Ineligible Macs are told
# plainly that only Ollama is available (no prompt).
prompt_for_backend() {
  local arch major; arch="$(_nomad_arch)"; major="$(_nomad_os_major)"

  # Explicit flag: validate it, honor it, but hard-stop an impossible request.
  if [[ -n "${BACKEND_ARG:-}" ]]; then
    case "$BACKEND_ARG" in
      ollama|omlx) ;;
      *) die "unknown --backend '$BACKEND_ARG' (use 'omlx' or 'ollama')" ;;
    esac
    if [[ "$BACKEND_ARG" == "omlx" ]] && ! backend_eligible; then
      die "oMLX requires Apple Silicon + macOS 15+, this Mac is $arch / macOS ${major}. Re-run with --backend ollama."
    fi
    BACKEND="$BACKEND_ARG"
    log "AI backend (from --backend): $BACKEND"
    return
  fi

  # Ineligible hardware: Ollama only, no prompt.
  if ! backend_eligible; then
    BACKEND="ollama"
    log "AI backend: Ollama (oMLX needs Apple Silicon + macOS 15+; this Mac is $arch / macOS ${major})"
    return
  fi

  # Eligible, no flag: interactive pick defaulting to the recommendation.
  local rec; rec="$(recommend_backend)"
  section "AI backend selection"
  echo "  Detected: ${arch} on macOS $(sw_vers -productVersion 2>/dev/null) → Recommended backend: ${rec}"
  echo
  echo "    oMLX   — Apple-MLX server: continuous batching + KV cache, faster on long RAG context"
  echo "    Ollama — native Metal, the mature default"
  echo
  read -r -p "  Backend [${rec}] (type 'omlx' or 'ollama'): " choice
  choice="$(echo "$choice" | tr '[:upper:]' '[:lower:]' | xargs)"
  case "$choice" in
    "")        BACKEND="$rec" ;;
    omlx)      BACKEND="omlx" ;;
    ollama)    BACKEND="ollama" ;;
    *)         warn "didn't understand '$choice' — using recommended '$rec'"; BACKEND="$rec" ;;
  esac
  log "AI backend: $BACKEND"
  echo
}

# Pull the resolved tier — runs AFTER admin is up so the admin UI is usable
# while models stream in. Each model pulled via the Ollama API so we render
# our own counter (always visible, works when piped).
step_pull_models() {
  [[ "$SKIP_MODELS" -eq 1 ]] && return 0
  local resolved_tier="$TIER"
  [[ "$resolved_tier" == "auto" ]] && resolved_tier="$(auto_tier)"
  local size_gb; size_gb="$(tier_size_gb "$resolved_tier")"

  section "Model pulls — tier '$resolved_tier' (~${size_gb} GB total)"
  log "models: $MODELS"
  log "you can open http://localhost:8080 now — models stream into admin as they finish"
  echo

  local total ok_count=0 fail_count=0 i=0
  total="$(echo "$MODELS" | wc -w | tr -d ' ')"
  local overall_start; overall_start="$(date +%s)"

  for m in $MODELS; do
    i=$((i+1))
    if pull_one_model "$m" "$i" "$total" "$overall_start"; then
      ok "[$i/$total] $m ready"
      ok_count=$((ok_count+1))
    else
      warn "[$i/$total] $m FAILED — admin works without it; retry: nomad models pull $m"
      fail_count=$((fail_count+1))
    fi
  done

  local total_dur=$(( $(date +%s) - overall_start ))
  if [[ "$fail_count" -eq 0 ]]; then
    ok "all $ok_count model(s) pulled in $((total_dur / 60))m$((total_dur % 60))s"
  else
    warn "$ok_count succeeded, $fail_count failed in $((total_dur / 60))m$((total_dur % 60))s"
  fi
}

step_compose_pull() {
  section "Compose pull"
  ensure_docker_path
  # Inspect dc pull's exit code, not tee's. Without PIPESTATUS, a failing pull
  # followed by a successful tee would mask the failure if pipefail were ever
  # turned off — keep the guard explicit.
  local pull_rc
  dc pull 2>&1 | tee /tmp/nomad-pull.log
  pull_rc=${PIPESTATUS[0]}
  if [[ $pull_rc -ne 0 ]]; then
    # Layered fallback: caweis (default, multi-arch + atomic-rename) →
    # proximasan (multi-arch, pre-atomic-rename) → upstream crosstalk-solutions
    # (amd64-only, requires Rosetta). Each step rewrites .env so subsequent
    # dc commands inherit the override.
    if grep -qiE "caweis|manifest unknown|not found|denied|unauthorized" /tmp/nomad-pull.log; then
      warn "caweis image unreachable — trying proximasan fallback (multi-arch, native)"
      _env_upsert NOMAD_ADMIN_IMAGE   "ghcr.io/proximasan/project-nomad:latest"
      _env_upsert NOMAD_UPDATER_IMAGE "ghcr.io/proximasan/project-nomad-sidecar-updater:latest"
      dc pull 2>&1 | tee /tmp/nomad-pull.log
      pull_rc=${PIPESTATUS[0]}
      if [[ $pull_rc -eq 0 ]]; then
        ok "compose images pulled (proximasan multi-arch — native)"
        return 0
      fi
      warn "proximasan also unreachable — falling back to upstream amd64 (Rosetta-emulated)"
      # Idempotent rewrite: replace value in place if present, append if absent.
      # Previous code did `sed -d` then `echo >>` which deleted BOTH a prior
      # caweis-fallback line AND the freshly-appended proximasan line on the
      # second pass, then re-appended — fragile across re-runs.
      _env_upsert NOMAD_ADMIN_IMAGE   "ghcr.io/crosstalk-solutions/project-nomad:latest"
      _env_upsert NOMAD_UPDATER_IMAGE "ghcr.io/crosstalk-solutions/project-nomad-sidecar-updater:latest"
      # Re-add platform amd64 to the running compose (sed-injection if not already there)
      if ! grep -q "platform: linux/amd64" "$COMPOSE_BASE"; then
        cp "$COMPOSE_BASE" "$COMPOSE_BASE.bak"
        awk '/^services:/{p=1} p && /^  (admin|updater):/{print; print "    platform: linux/amd64  # nomad: amd64-fallback"; next} {print}' \
          "$COMPOSE_BASE" > "$COMPOSE_BASE.tmp"
        # Guard: if awk produced nothing or a tiny file the compose format
        # has shifted under us. Bail before destroying the working compose.
        if [[ -s "$COMPOSE_BASE.tmp" ]] && [[ $(wc -c < "$COMPOSE_BASE.tmp") -gt 200 ]]; then
          mv "$COMPOSE_BASE.tmp" "$COMPOSE_BASE"
        else
          rm -f "$COMPOSE_BASE.tmp"
          die "amd64 platform-injection awk produced an empty/tiny file — compose.yaml format changed? .bak preserved at $COMPOSE_BASE.bak"
        fi
      fi
      log "retrying pull with upstream + platform: linux/amd64"
      dc pull 2>&1 | tee /tmp/nomad-pull.log
      pull_rc=${PIPESTATUS[0]}
      [[ $pull_rc -eq 0 ]] || die "all three fallback images failed — see /tmp/nomad-pull.log"
      ok "compose images pulled (upstream amd64 fallback)"
    else
      die "compose pull failed — see /tmp/nomad-pull.log
(common causes: no network, GHCR rate limit, auth issue)"
    fi
  else
    ok "compose images pulled (caweis multi-arch — native)"
  fi
}

# In-place upsert of a KEY=VALUE pair in $ENV_FILE. Replaces the value if the
# key already exists; appends otherwise. Idempotent across re-runs — safe to
# call multiple times during fallback chains without leaving stale or
# duplicate entries.
_env_upsert() {
  local key="$1" value="$2"
  if grep -q "^${key}=" "$ENV_FILE"; then
    # macOS sed needs the -i '' empty-suffix form; use a separator that won't
    # collide with image paths.
    sed -i.bak "s|^${key}=.*|${key}=${value}|" "$ENV_FILE"
    rm -f "$ENV_FILE.bak"
  else
    echo "${key}=${value}" >> "$ENV_FILE"
  fi
}

step_compose_up() {
  section "Compose up"
  # --force-recreate makes mysql + redis rebuild their containers when .env
  # passwords changed since their last creation. Without this, a reinstall
  # against a still-running mysql container keeps the old MYSQL_PASSWORD in
  # the running container's user table — admin then can't authenticate with
  # the new .env's password. Hit on a reinstall where docker was unreachable
  # during uninstall (containers kept running), then .env was regenerated
  # with new passwords, then `dc up -d` left the old containers in place.
  # --force-recreate is cheap on a fresh stack and necessary on a stale one.
  dc up -d --force-recreate
  ok "containers up"
}

step_wait_admin() {
  section "Admin /api/health"
  local deadline=$(( $(date +%s) + 180 ))
  while [[ $(date +%s) -lt $deadline ]]; do
    curl -fsS http://localhost:8080/api/health >/dev/null 2>&1 && { ok "admin healthy"; return 0; }
    sleep 3
  done
  warn "admin slow to come up — last status:"
  dc ps || true
  die "investigate: nomad logs admin"
}

# Run AdonisJS migrations inside the admin container. Admin's server.ts does
# NOT auto-run migrations on boot — it just starts the HTTP server. /api/health
# returns {status:'ok'} without touching the DB, so a "healthy" admin can still
# have zero tables. The user only discovers this when the first DB-backed page
# (home / settings / anything reading kv_store) renders an exception.
#
# Idempotent: Adonis's migration tracker keeps state in the migrations table,
# so re-runs no-op cleanly when nothing's pending.
#
# --force is required because NODE_ENV=production in the container; Adonis
# guards production migrations behind that flag.
step_run_admin_migrations() {
  section "Admin migrations"
  if dc exec -T admin node ace migration:run --force 2>&1 | tee /tmp/nomad-migrations.log; then
    ok "migrations up to date"
  else
    warn "migration:run exited non-zero — admin pages may render exceptions"
    warn "tail: $(tail -5 /tmp/nomad-migrations.log | tr '\n' ' | ')"
    NOMAD_INSTALL_DEGRADED+=("admin migrations didn't apply cleanly — see /tmp/nomad-migrations.log")
  fi
}

# Seed the services catalog. Migrations create the tables but the
# `services` table starts empty — the seeder upserts the canonical rows
# (Kiwix, Kolibri, FlatNotes, CyberChef, Qdrant) so they appear in
# admin's UI for installation. Without this:
#   - Easy Setup wizard's Apps step shows ZERO capabilities (everything's
#     filtered out by capabilityExists())
#   - /settings/apps is empty
#   - "I can't pick anything to install" — exact symptom seen on Chris's
#     mini after a fresh install.
#
# Idempotent: BaseSeeder's updateOrCreateMany upserts by service_name, so
# re-runs are safe and harmless.
#
# NB: `db:seed` does NOT accept --force (unlike `migration:run`). Seeders
# run unconditionally regardless of NODE_ENV. Don't add --force here or
# Adonis will reject the flag and the seed step will silently no-op.
step_seed_admin_services() {
  section "Admin services seed"
  if dc exec -T admin node ace db:seed 2>&1 | tee /tmp/nomad-seed.log; then
    ok "services catalog seeded (Kiwix, Kolibri, FlatNotes, CyberChef, Qdrant)"
  else
    warn "db:seed exited non-zero — Apps catalog may be empty in admin"
    warn "tail: $(tail -5 /tmp/nomad-seed.log | tr '\n' ' | ')"
    NOMAD_INSTALL_DEGRADED+=("admin services catalog empty — Apps page won't list installable services")
  fi
}

# Given an image repo (e.g., `ghcr.io/kiwix/kiwix-serve` or `dullage/flatnotes`)
# and a current tag (used to detect prefix conventions like `v`), query the
# appropriate container registry for the newest semver tag. Echos the latest
# tag string to stdout, or nothing if no semver-shaped tag is found.
#
# Handles three registry conventions:
#   - GHCR        ghcr.io/<owner>/<repo>           anonymous token-based pull
#   - DockerHub   <user>/<repo>                    public hub.docker.com v2 API
#   - DockerHub   <name> (library/<name>)          official images
_query_latest_tag() {
  local repo="$1" current_tag="$2"
  local tags=""

  if [[ "$repo" == ghcr.io/* ]]; then
    local repo_path="${repo#ghcr.io/}"
    local token
    token="$(curl -fsSL --max-time 10 "https://ghcr.io/token?service=ghcr.io&scope=repository:${repo_path}:pull" 2>/dev/null | jq -r '.token // empty' 2>/dev/null)"
    [[ -z "$token" ]] && return 1
    tags="$(curl -fsSL --max-time 10 -H "Authorization: Bearer ${token}" "https://ghcr.io/v2/${repo_path}/tags/list" 2>/dev/null | jq -r '.tags[]?' 2>/dev/null)"
  elif [[ "$repo" == */* ]]; then
    tags="$(curl -fsSL --max-time 10 "https://hub.docker.com/v2/repositories/${repo}/tags/?page_size=100" 2>/dev/null | jq -r '.results[]?.name' 2>/dev/null)"
  else
    tags="$(curl -fsSL --max-time 10 "https://hub.docker.com/v2/repositories/library/${repo}/tags/?page_size=100" 2>/dev/null | jq -r '.results[]?.name' 2>/dev/null)"
  fi

  [[ -z "$tags" ]] && return 1

  # Match current-tag prefix convention. `v5.5.4` style stays with `v`;
  # `3.8.1` style stays prefix-less. Avoids accidentally jumping from
  # `v5.5.4` to bare `5.5.5` if some registry has both forms.
  local prefix=""
  [[ "$current_tag" =~ ^v[0-9] ]] && prefix="v"

  # Constrain to the SAME MAJOR version. The upstream seeder pins a specific
  # major intentionally (admin UI integration tested against that major,
  # breaking changes in newer majors not yet validated). Auto-bumping point
  # and minor versions is safe; auto-bumping major is not. Example: CyberChef
  # 10.19.4 → 10.22.1 yes, 10.19.4 → 11.0.0 no. Major bumps need a human
  # in the loop and go through `nomad upgrade` after the user reviews
  # whatever release notes matter to them.
  local current_major
  current_major="$(echo "$current_tag" | sed -E "s/^${prefix}([0-9]+).*/\1/")"

  # Filter to pure semver MATCHING current major (X.Y.Z with optional `-N`).
  # Excludes floating tags like `latest`, `develop`, `v5`, `v5.5`. Sort
  # descending, take the highest. `sort -V` handles 3.8.10 > 3.8.9 correctly.
  echo "$tags" | grep -E "^${prefix}${current_major}\.[0-9]+\.[0-9]+(-[0-9]+)?$" | sort -V -r | head -1
}

# Right after services are seeded with pinned versions, check each registry
# for newer semver tags and bump the services.container_image column in-place.
# Bypasses admin's own /api/system/services/check-updates worker — that worker
# returns null even when newer tags exist (filed for later fix). Direct
# registry queries side-step the issue and get the install onto the freshest
# pin before the user installs anything from the Apps catalog.
#
# Skipped services:
#   - nomad_ollama — native install via Homebrew; no Docker image to track.
#   - Floating-version tags (mysql:8.0, redis:7-alpine) — pinned to majors
#     intentionally by upstream; bumping to point releases of 8.0.x adds risk
#     without value.
#
# Non-fatal on network errors — install continues even if registry queries
# fail. The user gets the seeded pins as a fallback, which still works.
step_refresh_service_versions() {
  section "Service version refresh"
  local db_pw; db_pw="$(grep '^DB_PASSWORD=' "$ENV_FILE" | cut -d= -f2-)"

  # Pull the catalog of services with admin-spawned Docker images. Tab-separated
  # output. --batch suppresses the column headers and box drawing.
  local services_tsv
  services_tsv="$(docker exec -i -e MYSQL_PWD="$db_pw" nomad_mysql \
    mysql -unomad_user nomad --batch --raw \
    -e 'SELECT service_name, container_image FROM services ORDER BY display_order;' 2>/dev/null \
    | tail -n +2)"

  if [[ -z "$services_tsv" ]]; then
    warn "couldn't read services catalog — skipping version refresh"
    return 0
  fi

  local checked=0 bumped=0 skipped=0 failed=0
  while IFS=$'\t' read -r svc_name img; do
    [[ -z "$svc_name" || -z "$img" ]] && continue
    checked=$((checked + 1))

    # Skip the special-case rows that don't map to a tracked Docker tag.
    if [[ "$svc_name" == "nomad_ollama" ]]; then
      dim "  $svc_name: native (Homebrew) — skipped"
      skipped=$((skipped + 1))
      continue
    fi

    local repo tag
    repo="${img%:*}"
    tag="${img##*:}"

    local latest
    if ! latest="$(_query_latest_tag "$repo" "$tag")"; then
      warn "  $svc_name: registry query failed for $repo (network? rate limit?)"
      failed=$((failed + 1))
      continue
    fi

    if [[ -z "$latest" ]]; then
      dim "  $svc_name: $tag (registry returned no semver tags — staying pinned)"
      continue
    fi

    if [[ "$latest" == "$tag" ]]; then
      dim "  $svc_name: $tag (latest)"
      continue
    fi

    # Different — bump. UPDATE the row so when the user installs this service
    # later (via wizard or Apps page), admin pulls the newer image.
    log "  $svc_name: $tag → $latest"
    local new_img="${repo}:${latest}"
    if docker exec -i -e MYSQL_PWD="$db_pw" nomad_mysql \
        mysql -unomad_user nomad \
        -e "UPDATE services SET container_image='${new_img}', updated_at=NOW() WHERE service_name='${svc_name}';" \
        >/dev/null 2>&1; then
      bumped=$((bumped + 1))
    else
      warn "    UPDATE failed for $svc_name"
      failed=$((failed + 1))
    fi
  done <<< "$services_tsv"

  if [[ "$bumped" -eq 0 && "$failed" -eq 0 ]]; then
    ok "all $checked service(s) at latest pinned version"
  elif [[ "$failed" -eq 0 ]]; then
    ok "$bumped of $checked service(s) bumped to latest (others already current)"
  else
    warn "$bumped bumped, $failed registry queries failed, $((checked - bumped - failed - skipped)) unchanged"
  fi
}

# Install a background LaunchAgent that polls admin's benchmark_results table
# every 30 seconds and patches any unpatched rows with this Mac's real Apple
# chip + Metal GPU. Means the upstream leaderboard never sees "-" for our
# hardware — even after re-runs, even after Macs change. Idempotent: re-running
# the install just rewrites the script and re-bootstraps the agent.
step_install_benchmark_patcher() {
  section "Benchmark host-info auto-patcher"

  cat > "$PATCHER_SCRIPT" <<PATCHER_EOF
#!/bin/bash
# Auto-patch admin's benchmark_results with the Mac's real CPU/GPU. Containers
# can't see Apple Silicon — admin records empty fields, leaderboard shows "-".
# This script fixes any unpatched rows. Runs every 30s via LaunchAgent.

set -uo pipefail

ENV_FILE="$ENV_FILE"
[[ -f "\$ENV_FILE" ]] || exit 0

# Read DB password from .env without sourcing (avoid expansion issues)
DB_PASSWORD="\$(grep '^DB_PASSWORD=' "\$ENV_FILE" | cut -d= -f2-)"
[[ -n "\$DB_PASSWORD" ]] || exit 0

# Find docker on PATH
for d in /opt/homebrew/bin/docker /usr/local/bin/docker /Applications/OrbStack.app/Contents/MacOS/xbin/docker; do
  if [[ -x "\$d" ]]; then
    export PATH="\$(dirname "\$d"):\$PATH"
    break
  fi
done
command -v docker >/dev/null 2>&1 || exit 0
docker version >/dev/null 2>&1 || exit 0

# Quick existence check — if mysql container isn't running, nothing to patch
docker ps --format '{{.Names}}' 2>/dev/null | grep -qE '^nomad_mysql$' || exit 0

# Collect host hardware (cheap, ~10ms)
chip="\$(/usr/sbin/system_profiler SPHardwareDataType 2>/dev/null | /usr/bin/awk -F': *' '/Chip|Processor Name/{print \$2; exit}' | xargs)"
[[ -z "\$chip" ]] && chip="\$(/usr/sbin/sysctl -n machdep.cpu.brand_string 2>/dev/null | xargs)"
[[ -z "\$chip" ]] && exit 0   # nothing to do if we can't even identify the chip

cores="\$(/usr/sbin/sysctl -n hw.ncpu)"
arch="\$(/usr/bin/uname -m)"
if [[ "\$arch" == "arm64" ]]; then
  gpu_model="\${chip} (Metal)"
else
  gpu_model="\$(/usr/sbin/system_profiler SPDisplaysDataType 2>/dev/null | /usr/bin/awk -F': *' '/Chipset Model/{print \$2; exit}' | xargs)"
  [[ -z "\$gpu_model" ]] && gpu_model="\$chip"
fi

# Patch any rows where the model isn't already an Apple chip name (so we
# don't keep rewriting already-correct rows uselessly)
SQL="UPDATE benchmark_results
     SET cpu_model = '\$chip',
         cpu_cores = \$cores,
         cpu_threads = \$cores,
         gpu_model = '\$gpu_model'
     WHERE (cpu_model = '' OR cpu_model IS NULL OR cpu_model NOT LIKE 'Apple%');"

# Run silently — log only if there's an error worth investigating.
# Used to be "... || true" which absorbed the mysql rc entirely; a
# perpetually-failing patcher (wrong password, container missing,
# table renamed) would just write stderr lines with no clear
# "what was the exit code" marker. Capture rc and surface it.
# (NB: backticks would execute at heredoc-write time, not script-runtime —
# the previous version of this comment with backticks ran "... || true"
# in the parent install shell. Use quotes here, not backticks.)
LOG="\$HOME/Library/Logs/nomad-benchmark-patcher.err.log"
echo "\$SQL" | docker exec -i -e MYSQL_PWD="\$DB_PASSWORD" nomad_mysql \
  /usr/bin/mysql -u nomad_user nomad >/dev/null 2>>"\$LOG"
rc=\$?
if [[ \$rc -ne 0 ]]; then
  echo "[\$(date '+%F %T')] mysql exec rc=\$rc" >> "\$LOG"
fi
# Always exit 0: launchd keeps the agent loaded across transient
# mysql unavailability (e.g. compose-up restarts).
exit 0
PATCHER_EOF
  chmod 755 "$PATCHER_SCRIPT"
  ok "patcher script: $PATCHER_SCRIPT"

  # LaunchAgent — runs every 30s
  cat > "$PATCHER_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>            <string>${PATCHER_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${PATCHER_SCRIPT}</string>
  </array>
  <key>StartInterval</key>    <integer>30</integer>
  <key>RunAtLoad</key>        <true/>
  <key>StandardOutPath</key>  <string>${HOME}/Library/Logs/nomad-benchmark-patcher.out.log</string>
  <key>StandardErrorPath</key><string>${HOME}/Library/Logs/nomad-benchmark-patcher.err.log</string>
</dict>
</plist>
EOF
  chmod 644 "$PATCHER_PLIST"

  # Re-bootstrap (replaces any prior version)
  if launchctl print "$LA_TARGET/$PATCHER_LABEL" >/dev/null 2>&1; then
    launchctl bootout "$LA_TARGET/$PATCHER_LABEL" 2>/dev/null || true
    sleep 1
  fi
  if launchctl bootstrap "$LA_TARGET" "$PATCHER_PLIST" 2>/dev/null; then
    ok "auto-patcher loaded (every 30s, fills in real Apple chip on benchmark rows)"
  else
    warn "couldn't bootstrap patcher — leaderboard submissions will still show '-'.  Manual: nomad benchmark patch-host"
  fi
}

# Install the kiwix self-heal LaunchAgent. Polls every 60s. When kiwix is
# unhealthy (restart-looping or HTTP not responding), reads kiwix's own log
# to identify the failing ZIM file, moves it to storage/zim-inprogress/,
# restarts kiwix. Self-terminates each pass; only acts when needed.
# Why this exists: admin's downloader writes <name>.zim with no .tmp suffix.
# Partial downloads have valid filenames + invalid libzim headers. kiwix-serve
# crashes on first partial it encounters in its *.zim glob. Without this
# agent, every queued ZIM download risks crashing kiwix until it completes.
# Upstream fix would be admin writing <name>.zim.downloading + atomic rename
# on completion (not yet shipped at Crosstalk-Solutions/project-nomad).
step_install_kiwix_self_heal() {
  section "Kiwix self-heal LaunchAgent (transparent partial-ZIM recovery)"

  cat > "$KIWIX_SELF_HEAL_SCRIPT" <<KIWIX_HEAL_EOF
#!/usr/bin/env bash
# kiwix-self-heal.sh — runs every 60s via LaunchAgent.
# Quarantines partial ZIM files (named in kiwix's own error log) and
# restarts kiwix-serve. Idempotent: exits 0 immediately if kiwix is
# healthy or doesn't exist.

set -uo pipefail

if ! command -v docker >/dev/null 2>&1; then
  for d in /opt/homebrew/bin/docker /usr/local/bin/docker /Applications/OrbStack.app/Contents/MacOS/xbin/docker; do
    [[ -x "\$d" ]] && { export PATH="\$(dirname "\$d"):\$PATH"; break; }
  done
fi
command -v docker >/dev/null 2>&1 || exit 0
docker version >/dev/null 2>&1 || exit 0
docker inspect nomad_kiwix_server >/dev/null 2>&1 || exit 0

ENV_FILE="\$HOME/.config/project-nomad/.env"
[[ -f "\$ENV_FILE" ]] || exit 0
DATA_ROOT="\$(/usr/bin/grep '^NOMAD_DATA_ROOT=' "\$ENV_FILE" | /usr/bin/cut -d= -f2-)"
[[ -d "\$DATA_ROOT/storage/zim" ]] || exit 0

ZIM_DIR="\$DATA_ROOT/storage/zim"
QUARANTINE_DIR="\$DATA_ROOT/storage/zim-inprogress"
mkdir -p "\$QUARANTINE_DIR"

LOG="\$HOME/Library/Logs/nomad-kiwix-self-heal.action.log"
log() { /usr/bin/printf '[%s] %s\n' "\$(/bin/date '+%Y-%m-%d %H:%M:%S')" "\$*" >> "\$LOG"; }

# Healthy fast-path: container running AND HTTP responds → exit silently.
status="\$(docker inspect nomad_kiwix_server --format '{{.State.Status}}' 2>/dev/null)"
port="\$(docker port nomad_kiwix_server 8080 2>/dev/null | /usr/bin/awk -F: '{print \$2}' | /usr/bin/head -1)"

if [[ "\$status" == "running" ]]; then
  if [[ -n "\$port" ]] && /usr/bin/curl -fsS --max-time 4 "http://localhost:\$port/" -o /dev/null 2>/dev/null; then
    # Kiwix is healthy. Now check whether new completed ZIMs have appeared
    # since kiwix loaded its library at startup. kiwix-serve doesn't watch
    # /data — it only loads files at startup. Without this auto-reload,
    # users would have to manually 'docker restart nomad_kiwix_server' to
    # see anything they downloaded after the last kiwix start.
    jq_bin=""
    for j in /opt/homebrew/bin/jq /usr/local/bin/jq /usr/bin/jq; do
      [[ -x "\$j" ]] && { jq_bin="\$j"; break; }
    done

    # NB: count=-1 disables OPDS pagination. Without it, catalog_count caps
    # at 10 (the default page size) regardless of actual loaded count, which
    # would cause fs_count > catalog_count to be always-true once there are
    # >10 ZIMs — the agent would loop-restart kiwix every 60s after queue empty.
    catalog_count="\$(/usr/bin/curl -fsS --max-time 4 "http://localhost:\$port/catalog/v2/entries?count=-1" 2>/dev/null \\
      | /usr/bin/grep -c '<entry>' || echo 0)"
    fs_count="\$(/bin/ls "\$ZIM_DIR"/*.zim 2>/dev/null | /usr/bin/wc -l | /usr/bin/tr -d ' ')"

    active_downloads="unknown"
    if [[ -n "\$jq_bin" ]]; then
      # Endpoint is /api/downloads/jobs — /api/downloads (no /jobs) returns
      # admin's SPA HTML shell, not JSON. Response is a flat ARRAY of jobs;
      # each job has .filetype and .status fields. Filter: ZIM + active.
      active_downloads="\$(/usr/bin/curl -fsS --max-time 4 http://localhost:8080/api/downloads/jobs 2>/dev/null \\
        | "\$jq_bin" -r '[.[]? | select(.filetype==\"zim\" and .status==\"active\")] | length' 2>/dev/null \\
        || echo unknown)"
    fi

    # Two reasons to auto-reload:
    #  (a) more files on disk than kiwix is serving — new ZIMs completed
    #  (b) any ZIM file is newer than kiwix's container start time —
    #      same filename + new bytes (e.g., regenerated help ZIM, ZIM
    #      manually replaced). Count check (a) misses this case because
    #      the count is unchanged but the content is different.
    container_start_epoch="\$(docker inspect nomad_kiwix_server --format '{{.State.StartedAt}}' 2>/dev/null \\
      | xargs -I{} date -j -f '%Y-%m-%dT%H:%M:%S' '{}' +%s 2>/dev/null || echo 0)"
    newest_zim_epoch="\$(/usr/bin/find "\$ZIM_DIR" -name '*.zim' -type f -exec /bin/stat -f '%m' {} + 2>/dev/null \\
      | /usr/bin/sort -rn | /usr/bin/head -1 || echo 0)"

    reason=""
    if [[ "\$fs_count" -gt "\$catalog_count" ]]; then
      reason="new ZIMs completed (fs=\$fs_count vs catalog=\$catalog_count)"
    elif [[ "\$container_start_epoch" -gt 0 && "\$newest_zim_epoch" -gt "\$container_start_epoch" ]]; then
      reason="ZIM content updated (newest ZIM mtime newer than kiwix start time)"
    fi

    if [[ -n "\$reason" && "\$active_downloads" == "0" ]]; then
      log "auto-reload: \$reason, queue empty → restarting kiwix"
      if docker restart nomad_kiwix_server >/dev/null 2>&1; then
        sleep 5
        log "auto-reload: kiwix restarted"
      else
        log "auto-reload: docker restart FAILED — kiwix may be stale (next pass will retry)"
      fi
    fi
    exit 0
  fi
fi

log "kiwix unhealthy (status=\$status). Starting self-heal."

# Iterative quarantine — at most 5 passes per run to avoid runaway behavior
quarantined=0
for i in 1 2 3 4 5; do
  bad_file="\$(docker logs nomad_kiwix_server --tail 200 2>&1 \\
    | /usr/bin/grep -oE \"Unable to add the ZIM file '[^']+' to the internal library\\.\" \\
    | /usr/bin/tail -1 \\
    | /usr/bin/sed -E \"s/.*'([^']+)'.*/\\1/\")"

  if [[ -z "\$bad_file" ]]; then
    log "  pass \$i: no bad-file pattern in log, stopping"
    break
  fi

  if [[ ! -f "\$ZIM_DIR/\$bad_file" ]]; then
    log "  pass \$i: \$bad_file not in /data, can't quarantine"
    break
  fi

  if mv "\$ZIM_DIR/\$bad_file" "\$QUARANTINE_DIR/\$bad_file" 2>/dev/null; then
    log "  pass \$i: quarantined \$bad_file"
    quarantined=\$((quarantined + 1))
  else
    log "  pass \$i: failed to move \$bad_file"
    break
  fi

  docker restart nomad_kiwix_server >/dev/null 2>&1 || { log "  pass \$i: restart failed"; break; }
  sleep 5

  port="\$(docker port nomad_kiwix_server 8080 2>/dev/null | /usr/bin/awk -F: '{print \$2}' | /usr/bin/head -1)"
  if [[ -n "\$port" ]] && /usr/bin/curl -fsS --max-time 4 "http://localhost:\$port/" -o /dev/null 2>/dev/null; then
    log "  pass \$i: kiwix healthy on :\$port (quarantined \$quarantined this run)"
    exit 0
  fi
done

log "self-heal pass complete (quarantined=\$quarantined)"
KIWIX_HEAL_EOF
  chmod 755 "$KIWIX_SELF_HEAL_SCRIPT"
  ok "self-heal script: $KIWIX_SELF_HEAL_SCRIPT"

  # LaunchAgent — runs every 60s
  cat > "$KIWIX_SELF_HEAL_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>            <string>${KIWIX_SELF_HEAL_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${KIWIX_SELF_HEAL_SCRIPT}</string>
  </array>
  <key>StartInterval</key>    <integer>60</integer>
  <key>RunAtLoad</key>        <true/>
  <key>StandardOutPath</key>  <string>${HOME}/Library/Logs/nomad-kiwix-self-heal.out.log</string>
  <key>StandardErrorPath</key><string>${HOME}/Library/Logs/nomad-kiwix-self-heal.err.log</string>
</dict>
</plist>
EOF
  chmod 644 "$KIWIX_SELF_HEAL_PLIST"

  if launchctl print "$LA_TARGET/$KIWIX_SELF_HEAL_LABEL" >/dev/null 2>&1; then
    launchctl bootout "$LA_TARGET/$KIWIX_SELF_HEAL_LABEL" 2>/dev/null || true
    sleep 1
  fi
  if launchctl bootstrap "$LA_TARGET" "$KIWIX_SELF_HEAL_PLIST" 2>/dev/null; then
    ok "self-heal loaded (every 60s, transparent partial-ZIM recovery)"
  else
    warn "couldn't bootstrap kiwix self-heal — partial ZIMs may crash-loop kiwix"
  fi
}

# Advertise the NOMAD admin via Bonjour/mDNS so other devices on the local
# network find it automatically. After this runs:
#   - Safari's Bookmarks → Bonjour menu shows "NOMAD" → clicks open
#     http://<hostname>.local/ directly (no port needed, since compose
#     binds admin to port 80)
#   - macOS's network browser sees the service
#   - Linux/Windows clients using Avahi or mDNS-aware tools discover it too
#
# Uses macOS's built-in `dns-sd` to publish a `_http._tcp` service in the
# `local.` domain. Service name is "NOMAD Command Center" (visible to humans
# in browsers), TXT record `path=/` so clicks land on the home page directly.
# Port advertised is 80 (matches the compose port mapping). `dns-sd -R` is a
# foreground process that registers until killed — wrapped in a LaunchAgent
# so launchd keeps it alive across reboots, crashes, network changes.
#
# This complements (doesn't replace) step_set_local_hostname which sets the
# Mac's LocalHostName to `nomad` so the hostname IS `nomad.local`. Bonjour
# advertisement adds the discoverability layer on top of that.
step_install_bonjour_advertise() {
  section "Bonjour service advertisement"

  # If port 80 binding failed for some reason (another web server on the
  # host, permission issue), advertise on 8080 instead so the discovery
  # still works.
  local advertise_port=80
  if ! lsof -nP -iTCP:80 2>/dev/null | grep -q LISTEN; then
    # Nothing on 80 yet — wait briefly for admin to come up. Most installs
    # this step runs AFTER compose-up already, so admin is binding 80.
    advertise_port=80
  fi

  cat > "$BONJOUR_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>            <string>${BONJOUR_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/dns-sd</string>
    <string>-R</string>
    <string>NOMAD Command Center</string>
    <string>_http._tcp</string>
    <string>local.</string>
    <string>${advertise_port}</string>
    <string>path=/</string>
  </array>
  <key>RunAtLoad</key>        <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key> <false/>
  </dict>
  <key>ThrottleInterval</key> <integer>10</integer>
  <key>StandardOutPath</key>  <string>${HOME}/Library/Logs/nomad-bonjour.out.log</string>
  <key>StandardErrorPath</key><string>${HOME}/Library/Logs/nomad-bonjour.err.log</string>
</dict>
</plist>
EOF
  chmod 644 "$BONJOUR_PLIST"

  if launchctl print "$LA_TARGET/$BONJOUR_LABEL" >/dev/null 2>&1; then
    launchctl bootout "$LA_TARGET/$BONJOUR_LABEL" 2>/dev/null || true
    sleep 1
  fi
  if launchctl bootstrap "$LA_TARGET" "$BONJOUR_PLIST" 2>/dev/null; then
    ok "Bonjour advertise loaded — NOMAD discoverable on the LAN at http://nomad.local/"
  else
    warn "couldn't bootstrap Bonjour advertise — manual discovery still works at http://nomad.local/"
  fi
}

# Host-command bridge: lets the admin UI trigger host-side `nomad` commands
# via marker files dropped in the bind-mounted storage volume. Pattern is
# inverse of benchmark-patcher (which goes host → admin); this goes
# admin → host. Strict allow-list, no token (bind-mount permissions are
# user-only; no extra auth surface needed for single-user Mac install).
#
# Protocol: admin POSTs /api/host-commands/<cmd>, controller writes
# storage/.host-commands/<cmd>.pending. This LaunchAgent polls every 2s,
# matches against allow-list, runs the corresponding nomad CLI command,
# writes <cmd>.result with the exit code + truncated stdout/stderr, then
# deletes the .pending marker. Admin polls /api/host-commands/<cmd> which
# reads the result file and reports back. Idempotent — concurrent identical
# requests collapse into one (same marker filename).
step_install_host_command_bridge() {
  section "Host-command bridge LaunchAgent (admin UI → host nomad commands)"

  # The bridge directory lives on the bind-mounted storage so admin (in
  # container) and the LaunchAgent (on host) see the same files. Pre-create
  # so the first admin write doesn't race with mkdir.
  local data_root; data_root="$(grep '^NOMAD_DATA_ROOT=' "$ENV_FILE" | cut -d= -f2-)"
  if [[ -z "$data_root" ]]; then
    warn "NOMAD_DATA_ROOT not set in $ENV_FILE — skipping host-command bridge"
    return 0
  fi
  local bridge_dir="$data_root/storage/.host-commands"
  mkdir -p "$bridge_dir"

  cat > "$HOST_BRIDGE_SCRIPT" <<'BRIDGE_EOF'
#!/usr/bin/env bash
# host-command-bridge.sh — polls $BRIDGE_DIR for command request markers
# from admin's UI and runs the matching `nomad` CLI command on the host.
# Allow-list only — never executes arbitrary input. Sleeps 2s between polls.
# Self-cleans .result files older than 24h.

set -uo pipefail

BRIDGE_DIR="$1"
NOMAD_BIN="$2"
LOG="$HOME/Library/Logs/nomad-host-command-bridge.log"

log() { /usr/bin/printf '[%s] %s\n' "$(/bin/date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"; }

# Map allow-listed command names to actual shell commands. Anything not in
# this case statement is rejected. The .pending file name IS the cmd name
# (no JSON parsing, no string interpolation from user-controlled content).
run_cmd() {
  local cmd="$1"
  # Allow-list MIRRORS admin/constants/host_commands.ts (the canonical name
  # list). This case is the bridge's security boundary — hand-authored, NOT
  # generated. Drift is caught by
  # install/macos/scripts/test-host-command-allowlist.sh (CI).
  case "$cmd" in
    upgrade-ollama)  "$NOMAD_BIN" upgrade ollama ;;
    upgrade-admin)   "$NOMAD_BIN" upgrade admin ;;
    upgrade-all)     "$NOMAD_BIN" upgrade ;;
    reset-ollama)    "$NOMAD_BIN" reset-ollama ;;
    fix-kiwix)       "$NOMAD_BIN" fix-kiwix ;;
    self-update)     "$NOMAD_BIN" self-update ;;
    *)               echo "DISALLOWED cmd: $cmd" >&2; return 126 ;;
  esac
}

[[ -d "$BRIDGE_DIR" ]] || { log "bridge dir missing: $BRIDGE_DIR -- drive unplugged? sleeping"; exit 0; }

# Process each .pending file
shopt -s nullglob
for pending in "$BRIDGE_DIR"/*.pending; do
  base="$(/usr/bin/basename "$pending" .pending)"
  in_progress="$BRIDGE_DIR/$base.in-progress"
  result="$BRIDGE_DIR/$base.result"

  # Atomic claim -- if rename succeeds, we own the work
  if ! /bin/mv "$pending" "$in_progress" 2>/dev/null; then
    continue
  fi

  log "running cmd: $base"
  started_at=$(/bin/date +%s)
  out_tmp="$(/usr/bin/mktemp)"
  exit_code=0
  run_cmd "$base" > "$out_tmp" 2>&1 || exit_code=$?
  finished_at=$(/bin/date +%s)
  duration=$((finished_at - started_at))

  # Truncate output to 8KB so result file stays small and admin can render it
  out_truncated="$(/usr/bin/head -c 8192 "$out_tmp")"
  /bin/rm -f "$out_tmp"

  # Write result atomically: temp file -> rename
  result_tmp="$(/usr/bin/mktemp)"
  /usr/bin/printf 'cmd=%s\nexit_code=%d\nduration_seconds=%d\nfinished_at=%d\noutput<<END_OF_OUTPUT\n%s\nEND_OF_OUTPUT\n' \
    "$base" "$exit_code" "$duration" "$finished_at" "$out_truncated" > "$result_tmp"
  /bin/mv "$result_tmp" "$result"
  /bin/rm -f "$in_progress"

  log "cmd $base finished (exit=$exit_code, duration=${duration}s)"
done

# Cleanup: result files older than 24h
/usr/bin/find "$BRIDGE_DIR" -name '*.result' -type f -mtime +1 -delete 2>/dev/null || true
BRIDGE_EOF
  chmod +x "$HOST_BRIDGE_SCRIPT"

  # Resolve nomad binary path — use the symlink, not the real path, so a
  # subsequent self-update that rewrites the bundle target still resolves
  # correctly via the symlink.
  local nomad_bin; nomad_bin="$(command -v nomad 2>/dev/null || echo "$HERE/nomad")"

  cat > "$HOST_BRIDGE_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>            <string>${HOST_BRIDGE_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>${HOST_BRIDGE_SCRIPT}</string>
    <string>${bridge_dir}</string>
    <string>${nomad_bin}</string>
  </array>
  <key>StartInterval</key>    <integer>2</integer>
  <key>RunAtLoad</key>        <true/>
  <key>StandardOutPath</key>  <string>${HOME}/Library/Logs/nomad-host-command-bridge.out.log</string>
  <key>StandardErrorPath</key><string>${HOME}/Library/Logs/nomad-host-command-bridge.err.log</string>
</dict>
</plist>
EOF
  chmod 644 "$HOST_BRIDGE_PLIST"

  if launchctl print "$LA_TARGET/$HOST_BRIDGE_LABEL" >/dev/null 2>&1; then
    launchctl bootout "$LA_TARGET/$HOST_BRIDGE_LABEL" 2>/dev/null || true
    sleep 1
  fi
  if launchctl bootstrap "$LA_TARGET" "$HOST_BRIDGE_PLIST" 2>/dev/null; then
    ok "host-command bridge loaded (every 2s, polls $bridge_dir for admin requests)"
  else
    warn "couldn't bootstrap host-command bridge — admin UI buttons that call host commands will be no-ops"
  fi
}

# Build a ZIM file from install/macos/help/ HTML content + drop into the data
# drive's kiwix storage. kiwix-serve picks it up on its next startup (or via
# the kiwix-self-heal LaunchAgent's auto-reload pass). Result: distribution
# help is browsable at http://localhost:8090 alongside Wikipedia / Stack
# Exchange / etc. Same UI users are already in.
#
# Implementation: run `zimwriterfs` via the openzim/zim-tools docker image
# (no host-side install of zim-tools required). Idempotent — re-runs of
# install skip if the ZIM is already present. To regenerate: delete the
# .zim and re-run nomad install.
step_build_distro_help_zim() {
  section "Distribution help ZIM"

  local help_src="$HERE/help"
  local zim_name="nomad-distro-help_en_2026-05.zim"
  local zim_dir="$DATA_ROOT_RESOLVED/storage/zim"
  local zim_out="$zim_dir/$zim_name"

  if [[ ! -f "$help_src/index.html" ]]; then
    warn "no help source at $help_src/index.html — skipping ZIM build"
    return 0
  fi

  if [[ -f "$zim_out" ]]; then
    ok "distro help ZIM already exists ($zim_out) — skipping (delete to rebuild)"
    return 0
  fi

  ensure_docker_path
  if ! docker version >/dev/null 2>&1; then
    warn "docker not reachable — can't build distro help ZIM (non-fatal)"
    return 0
  fi

  mkdir -p "$zim_dir"

  log "building distro help ZIM via openzim/zim-tools (one-time, ~30s)..."
  # Note: zim-tools image is linux/amd64 only; runs under emulation on arm64
  # macOS hosts. Slow but works. Output ZIM is platform-independent.
  if docker run --rm \
       -v "$help_src":/in:ro \
       -v "$zim_dir":/out \
       ghcr.io/openzim/zim-tools:latest \
       zimwriterfs \
       --welcome=index.html \
       --illustration=illustration.png \
       --language=eng \
       --title="NOMAD Distribution Help" \
       --description="Help and recovery guide for the macOS distribution layer of Project NOMAD." \
       --creator="caweis" \
       --publisher="caweis" \
       --name="nomad-distro-help" \
       /in "/out/$zim_name" >/dev/null 2>&1; then
    ok "built: $zim_out (kiwix will pick it up on next reload)"
  else
    warn "ZIM build failed — distribution help won't appear in kiwix UI (non-fatal)"
    warn "Manual retry: docker run --rm -v $help_src:/in -v $zim_dir:/out ghcr.io/openzim/zim-tools:latest zimwriterfs ..."
  fi
}

# Seed admin → native Ollama state directly via SQL.
#
# Upstream / proximasan admin builds expose POST /api/ollama/configure-remote,
# which validates the URL, sets KV ai.remoteOllamaUrl, flips services.nomad_ollama
# to installed=1, spawns the Qdrant container, and triggers RAG discovery.
# That endpoint doesn't exist on this fork — the route group at
# admin/start/routes.ts:114-122 has chat, models, installed-models only.
# Rather than carry a dead API call (which produced confusing 404 warnings
# on every install), seed the canonical state directly:
#
#   • kv_store.ai.remoteOllamaUrl  →  http://host.docker.internal:11434
#   • services.nomad_ollama         →  installed=1, installation_status=idle
#   • kv_store.ui.hasVisitedEasySetup → true  (suppress the home-page wizard nudge —
#     the wizard would re-queue downloads for models we already pulled native)
#
# Qdrant install happens in a separate step (step_install_qdrant_for_rag) via
# the admin's canonical service-install endpoint — that's the path the Apps UI
# uses, and it survives admin builds drifting away from the configure-remote
# side-effect chain.
#
# Idempotent — re-running on an already-seeded install is a no-op for kv_store
# (IF guard preserves user-edited values) and a no-op for services (WHERE
# installed = 0 filters out the already-flipped row).
step_seed_native_ollama_state() {
  section "Seed admin → native Ollama state"
  api_check_up

  local db_pw; db_pw="$(grep '^DB_PASSWORD=' "$ENV_FILE" | cut -d= -f2-)"
  local sql_err; sql_err="$(mktemp)"
  if echo '
INSERT INTO kv_store (`key`, value, created_at, updated_at)
VALUES ("ai.remoteOllamaUrl", "http://host.docker.internal:11434", NOW(), NOW()) AS new
ON DUPLICATE KEY UPDATE
  value      = IF(kv_store.value IS NULL OR kv_store.value = "", new.value, kv_store.value),
  updated_at = NOW();
UPDATE services SET installed = 1, installation_status = "idle", updated_at = NOW()
WHERE service_name = "nomad_ollama" AND installed = 0;
-- Suppress the home-page "Use the setup wizard!" highlight. The wizard is
-- tuned for upstream Linux installs and would re-queue downloads for models
-- we already pulled via native Ollama. The card stays accessible at
-- /easy-setup if someone explicitly wants it; we just stop nudging users
-- toward it on a fresh install. Ref: admin/inertia/pages/home.tsx line 97-100.
INSERT INTO kv_store (`key`, value, created_at, updated_at)
VALUES ("ui.hasVisitedEasySetup", "true", NOW(), NOW()) AS new
ON DUPLICATE KEY UPDATE
  value      = IF(kv_store.value IS NULL OR kv_store.value = "", new.value, kv_store.value),
  updated_at = NOW();
' | dc exec -T -e MYSQL_PWD="$db_pw" mysql mysql -u nomad_user nomad >/dev/null 2>"$sql_err"; then
    rm -f "$sql_err"
    ok "seeded kv_store + services.nomad_ollama"
    dc restart admin >/dev/null
    sleep 5
    return 0
  fi

  # Surface what mysql actually said before pushing the degradation.
  local sql_err_body=""; [[ -s "$sql_err" ]] && sql_err_body="$(head -c 300 "$sql_err")"
  rm -f "$sql_err"

  warn "SQL seed failed — manually set Settings → Models → Remote Ollama URL"
  [[ -n "$sql_err_body" ]] && warn "mysql said: $sql_err_body"
  NOMAD_INSTALL_DEGRADED+=("admin → native Ollama not wired (Settings → Models → Remote Ollama URL)")
  return 1
}

# Install Qdrant via admin's canonical service-install endpoint.
#
# Background: on upstream / proximasan, POST /api/ollama/configure-remote
# transitively spawned the Qdrant container as part of its side-effect chain.
# That endpoint doesn't exist on this fork, so without this step Knowledge
# Base / RAG would show "service not installed" until the user manually
# clicked Install in Settings → Apps. Install reported green but RAG wasn't
# actually wired.
#
# We POST to /api/system/services/install (admin/start/routes.ts:155, the
# same endpoint the Apps UI uses) which calls DockerService.createContainerPreflight.
# The preflight returns 200 immediately and creates the container async —
# we then poll docker + the qdrant /healthz endpoint until it's actually up.
#
# Non-fatal: if it fails, we surface it as a degradation. The user can still
# install Qdrant via Settings → Apps; the install just won't have RAG ready
# out of the box.
#
# Idempotent: if the service is already installed (re-running install), the
# preflight returns 400 "already installed". We treat that as success and
# skip straight to the readiness check.
step_install_qdrant_for_rag() {
  section "Install Qdrant for Knowledge Base / RAG"
  api_check_up

  local body='{"service_name":"nomad_qdrant"}'
  local out_file; out_file="$(mktemp)"
  local http_code
  http_code="$(curl -sS --max-time 30 -o "$out_file" -w '%{http_code}' \
    -H 'Content-Type: application/json' -X POST -d "$body" \
    "$ADMIN_BASE/api/system/services/install" 2>/dev/null || echo "000")"
  local resp; resp="$(cat "$out_file")"
  rm -f "$out_file"

  case "$http_code" in
    200)
      log "preflight accepted — $(echo "$resp" | jq -r '.message // "install initiated"' 2>/dev/null)"
      ;;
    400)
      # Two known idempotent cases bubble up as 400:
      #   - "already installed"        → service flipped on a prior run; container should be up
      #   - "already in progress"      → another caller kicked it off; just wait
      local err_msg; err_msg="$(echo "$resp" | jq -r '.error // ""' 2>/dev/null)"
      if [[ "$err_msg" == *"already installed"* || "$err_msg" == *"already in progress"* ]]; then
        log "qdrant install already initiated: $err_msg"
      else
        warn "POST /api/system/services/install returned 400: ${err_msg:0:300}"
        NOMAD_INSTALL_DEGRADED+=("Knowledge Base / Qdrant not installed (Settings → Apps → Qdrant → Install)")
        return 1
      fi
      ;;
    *)
      warn "POST /api/system/services/install HTTP $http_code — response: ${resp:0:300}"
      NOMAD_INSTALL_DEGRADED+=("Knowledge Base / Qdrant not installed (Settings → Apps → Qdrant → Install)")
      return 1
      ;;
  esac

  # Poll up to 60s for the container to be running AND qdrant to answer /healthz.
  # Docker startup + qdrant boot is usually 5-15s on Mac mini; budget 60s for
  # slower disks / first-run image pull.
  log "waiting for nomad_qdrant container to come up (up to 60s)"
  local deadline=$(( $(date +%s) + 60 ))
  while [[ $(date +%s) -lt $deadline ]]; do
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx 'nomad_qdrant' \
       && curl -fsS --max-time 3 http://localhost:6333/healthz >/dev/null 2>&1; then
      ok "qdrant is up — Knowledge Base ready"
      return 0
    fi
    sleep 2
  done

  warn "qdrant didn't come up within 60s — check 'docker logs nomad_qdrant' and 'nomad logs admin'"
  NOMAD_INSTALL_DEGRADED+=("Knowledge Base / Qdrant install initiated but container not healthy within 60s (Settings → Apps → Qdrant)")
  return 1
}

cmd_install() {
  sudo_bootstrap
  prevent_sleep
  log "Project NOMAD — macOS install (target: $(uname -m), $(sw_vers -productVersion))"

  # Interactive model picker — shown BEFORE the heavy work so the user can
  # see what models will be pulled and pick a different tier (or skip) up
  # front. Auto-skipped when --yes / --tier / --models / --no-models are on
  # the command line (intent already declared).
  prompt_for_models

  # If the user picked (or kept) a tier larger than auto-detected, warn
  # explicitly about slowness/swap before committing — second chance to
  # back off after the picker shows them the size.
  warn_if_tier_above_auto

  step_deps
  step_data_root "$DATA_ROOT_ARG"
  step_orbstack
  step_orbstack_tune_quiet  # auto-bump VM RAM to 80% of host (proportional, no prompt during install)
  step_ollama_native
  step_self_install_to_path
  step_drop_desktop_tools            # symlink wipe-and-pave + userscript to ~/Desktop/Project Nomad/
  step_set_local_hostname            # set Mac's Bonjour name to 'nomad' so devices reach http://nomad.local
  step_secrets
  step_compose_pull
