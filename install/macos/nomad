  step_install_qdrant_for_rag  || true   # non-fatal; RAG can be installed later via Apps UI
  step_install_benchmark_patcher   # background daemon that fixes leaderboard CPU/GPU automatically
  step_install_kiwix_self_heal     # background daemon that quarantines partial ZIMs so kiwix never crash-loops
  step_install_bonjour_advertise   # advertise admin via mDNS so other devices find it in Safari Bonjour menu
